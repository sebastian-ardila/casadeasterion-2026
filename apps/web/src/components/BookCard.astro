---
import type { Book, Author } from "~/lib/supabase";
import type { SiteConfigMap } from "~/lib/site-config";
import AddToCartButton from "~/components/AddToCartButton.astro";

interface Props {
  book: Book;
  author?: Author | null;
  config: SiteConfigMap;
}

const { book, author } = Astro.props;

const formattedPrice =
  book.price_amount != null
    ? new Intl.NumberFormat("es-CO", {
        style: "currency",
        currency: book.price_currency,
        maximumFractionDigits: 0,
      }).format(Number(book.price_amount))
    : null;

// Líneas resueltas en el frontmatter. Cuando no hay autor o precio
// inyectamos un non-breaking space literal para que el navegador
// renderice la línea con altura natural.
const NBSP = " ";
const authorLine = author?.name?.trim() || NBSP;
const priceLine = formattedPrice || NBSP;
---

{/* Arquitectura de la tarjeta — versión deterministica:
    cada subsección tiene altura FIJA (no min-h, no flex-1, no
    mt-auto). Resultado: la tarjeta entera mide exactamente lo mismo
    independientemente del contenido. Antes dependíamos del grid
    items-stretch + h-full + flex-1 + mt-auto; ese combo fallaba en
    algunos navegadores y dejaba cards con metadata vacía más
    bajitas que sus vecinas. */}
<article class="group flex flex-col">
  {
    book.cover_image_url ? (
      <a
        href={`/catalogo/${book.slug}`}
        class="block aspect-[4/5] overflow-hidden bg-[color:var(--bg-alt)] shadow-sm shadow-stone-900/10 ring-1 ring-stone-900/[0.04] transition-shadow duration-300 group-hover:shadow-md group-hover:shadow-stone-900/15"
      >
        <img
          src={book.cover_image_url}
          alt={`Portada de ${book.title}`}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
        />
      </a>
    ) : (
      <a
        href={`/catalogo/${book.slug}`}
        class="aspect-[4/5] bg-[color:var(--bg-alt)] flex items-center justify-center text-[color:var(--fg-muted)] text-xs sm:text-sm uppercase tracking-[0.16em]"
      >
        Sin portada
      </a>
    )
  }

  {/* Metadata — cada fila con altura FIJA y gaps fijos. NO flex-1,
      NO mt-auto. Total: pt + author + title + price + gaps + button
      = mismo número para todas las cards. */}
  <div class="pt-3 sm:pt-4 flex flex-col gap-y-2 sm:gap-y-3">
    {/* Autor: 1 línea con truncate (no line-clamp para evitar
        -webkit-box collapsing cuando el contenido es nbsp). h fija
        garantiza la línea aún sin texto visible. */}
    <p class="text-[10px] sm:text-[11px] uppercase tracking-[0.18em] text-[color:var(--fg-muted)] truncate h-[1.4em]">
      {authorLine}
    </p>
    {/* Título: 2 líneas exactas (h-[2.75em] = 2 × leading-snug 1.375
        × 1em). line-clamp-2 + overflow-hidden cortan títulos largos. */}
    <h3 class="font-serif text-base sm:text-lg md:text-xl leading-snug line-clamp-2 h-[2.75em] overflow-hidden">
      <a href={`/catalogo/${book.slug}`} class="hover:opacity-70 transition-opacity">{book.title}</a>
    </h3>
    {/* Precio: misma sans tipográfica que el carrito; h fija. */}
    <p class="font-sans text-xl sm:text-2xl text-stone-900 tabular-nums leading-tight tracking-tight h-[1.4em]">
      {priceLine}
    </p>
    <AddToCartButton
      slug={book.slug}
      title={book.title}
      coverImageUrl={book.cover_image_url}
      priceAmount={book.price_amount}
      priceCurrency={book.price_currency}
      variant="ghost"
    />
  </div>
</article>
