---
// OAuth-only subscription. The user clicks the Google button, gets bounced
// through Supabase Auth → Google → /suscripcion-confirmada, which is the
// page that actually upserts the subscriber row via the
// /functions/v1/subscribe-with-auth edge function.
//
// No email input, no Turnstile, no honeypot — Google's identity check
// replaces all of that.
---

<section
  id="suscribirse"
  class="bg-[color:var(--bg-alt)] border-y border-[color:var(--border)]"
>
  <div class="mx-auto max-w-2xl px-6 py-20 text-center">
    <h2 class="font-serif text-3xl md:text-4xl mb-3">Suscríbete</h2>
    <p class="text-[color:var(--fg-muted)] mb-8">
      Recibe nuevas publicaciones, ensayos y novedades editoriales en tu correo.
    </p>

    <button
      type="button"
      id="subscribe-google"
      class="inline-flex items-center justify-center gap-3 px-6 py-3 bg-[color:var(--bg)] border border-[color:var(--border)] hover:border-[color:var(--fg)] transition cursor-pointer"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4"/>
        <path d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" fill="#34A853"/>
        <path d="M3.964 10.706A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.706V4.962H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.038l3.007-2.332z" fill="#FBBC05"/>
        <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.962L3.964 7.294C4.672 5.167 6.656 3.58 9 3.58z" fill="#EA4335"/>
      </svg>
      <span class="text-sm font-medium">Suscribirme con Google</span>
    </button>

    <p class="mt-4 text-xs text-[color:var(--fg-muted)] max-w-md mx-auto">
      Usamos Google solo para verificar tu correo. No publicamos nada en tu nombre ni accedemos a tus datos.
    </p>

    <p
      id="subscribe-msg"
      class="mt-4 text-sm min-h-[1.25rem] text-[color:var(--fg-muted)]"
      role="status"
      aria-live="polite"
    ></p>
  </div>
</section>

<script>
  import { getBrowserClient } from "~/lib/supabase-browser";

  const btn = document.getElementById("subscribe-google") as HTMLButtonElement | null;
  const msg = document.getElementById("subscribe-msg");

  if (btn && msg) {
    btn.addEventListener("click", async () => {
      msg.textContent = "";
      btn.disabled = true;
      btn.style.opacity = "0.6";

      try {
        const supabase = getBrowserClient();
        const { error } = await supabase.auth.signInWithOAuth({
          provider: "google",
          options: {
            redirectTo: `${window.location.origin}/suscripcion-confirmada`,
            queryParams: { prompt: "select_account" },
          },
        });
        if (error) throw error;
        // signInWithOAuth navigates the page on success, so we don't get here.
      } catch (err) {
        msg.textContent = "No pudimos abrir Google. Intenta de nuevo.";
        msg.style.color = "#b91c1c";
        btn.disabled = false;
        btn.style.opacity = "1";
      }
    });
  }
</script>
