---
// Static hero content variant #2. Sits in the left half of the home hero
// section. Talks about the editorial mission and offers clear CTAs to
// catalog, newsletter and the three editorial pillars (Filosofía / Poesía
// / Autores). Not connected to the CMS — only the right-half image and
// the section background color still come from site_configuration.
---

<div class="relative z-10 w-full md:w-1/2 px-5 sm:px-8 md:px-12 lg:px-16 xl:px-20 py-12 md:py-0 max-w-2xl">
  <p class="uppercase text-[11px] sm:text-xs tracking-[0.28em] text-[color:var(--fg-muted)] mb-5 sm:mb-7">
    Editorial independiente · Bogotá
  </p>

  <h1 class="font-serif text-[2.25rem] sm:text-5xl md:text-[3.5rem] lg:text-6xl xl:text-7xl leading-[1.04] text-[color:var(--fg)] mb-6 sm:mb-8">
    Filosofía y poesía<br />
    <span class="italic font-normal">en libros pensados</span><br />
    para durar.
  </h1>

  <p class="text-base sm:text-lg md:text-[1.05rem] lg:text-lg leading-relaxed text-[color:var(--fg-muted)] mb-9 sm:mb-10 md:mb-12 max-w-xl">
    Publicamos voces contemporáneas que interrogan el presente: traducciones
    cuidadosas, poesía actual en español y ensayos que se hacen cargo de su
    tiempo.
  </p>

  {/* Three editorial pillars — each links to its section */}
  <ul class="border-t border-[color:var(--border)] divide-y divide-[color:var(--border)] mb-10 sm:mb-12">
    {[
      { href: "/filosofia", label: "Filosofía", desc: "Pensamiento contemporáneo" },
      { href: "/poesia", label: "Poesía", desc: "Voces actuales en español" },
      { href: "/autores", label: "Autores", desc: "Nuestro catálogo de autores" },
    ].map((p) => (
      <li>
        <a
          href={p.href}
          class="group flex items-center justify-between py-3.5 sm:py-4 hover:pl-2 transition-[padding] duration-200"
        >
          <span class="flex items-baseline gap-3 sm:gap-4">
            <span class="font-serif text-lg sm:text-xl text-[color:var(--fg)]">{p.label}</span>
            <span class="text-[12px] sm:text-sm text-[color:var(--fg-muted)] hidden sm:inline">{p.desc}</span>
          </span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-[color:var(--fg-muted)] group-hover:text-[color:var(--fg)] transition-transform duration-200 group-hover:translate-x-1"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m13 5 7 7-7 7" />
          </svg>
        </a>
      </li>
    ))}
  </ul>

  <div class="flex flex-wrap items-center gap-3 sm:gap-4">
    <a
      href="/catalogo"
      class="group inline-flex items-center gap-2.5 bg-[color:var(--fg)] text-[color:var(--bg)] px-6 py-3.5 sm:px-7 sm:py-4 text-[11px] sm:text-xs uppercase tracking-[0.22em] hover:bg-[color:var(--fg-muted)] transition-colors"
    >
      Explorar catálogo
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform group-hover:translate-x-1"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m13 5 7 7-7 7" />
      </svg>
    </a>
    <a
      href="/#suscribirse"
      class="inline-flex items-center text-[11px] sm:text-xs uppercase tracking-[0.22em] text-[color:var(--fg)] border-b border-[color:var(--fg)]/40 hover:border-[color:var(--fg)] pb-1 transition-colors"
    >
      Recibir el boletín
    </a>
  </div>
</div>
