---
// Static hero variant V2 — Editorial statement.
// Single strong CTA to the catalog. No mention of recent publications
// since the archive is still small. Speaks directly about what the
// editorial does.
---

<div class="relative z-10 w-full md:w-1/2 px-5 sm:px-8 md:px-12 lg:px-16 xl:px-20 py-12 md:py-0 max-w-2xl">
  <p class="uppercase text-[11px] sm:text-xs tracking-[0.28em] text-[color:var(--fg-muted)] mb-7 sm:mb-9">
    Editorial independiente
  </p>

  <h1 class="font-serif text-[2rem] sm:text-[2.6rem] md:text-[3.4rem] lg:text-6xl xl:text-[4.4rem] leading-[1.08] sm:leading-[1.04] text-[color:var(--fg)] mb-7 sm:mb-10">
    Filosofía y poesía contemporáneas,
    <span class="italic font-normal"> en libros pensados para durar.</span>
  </h1>

  <p class="text-[0.95rem] sm:text-lg lg:text-xl leading-relaxed text-[color:var(--fg-muted)] mb-9 sm:mb-12 max-w-xl">
    Publicamos a quienes piensan y escriben el presente: traducciones cuidadosas
    y voces vivas en español, en ediciones que se conservan.
  </p>

  {/* Paired CTAs: solid primary + ghost secondary, same height. On a
      narrow viewport the secondary wraps under the primary. */}
  <div class="flex flex-wrap items-stretch gap-3 max-w-full">
    <a
      href="/catalogo"
      class="group inline-flex items-center gap-3 bg-[color:var(--fg)] text-[color:var(--bg)] px-7 sm:px-9 h-12 sm:h-14 text-[11px] sm:text-xs uppercase tracking-[0.24em] hover:bg-[color:var(--fg-muted)] transition-colors"
    >
      Ver el catálogo
      <span class="flex items-center justify-center w-6 h-6 rounded-full bg-[color:var(--bg)]/15 group-hover:bg-[color:var(--bg)]/25 transition-colors">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 5 7 7-7 7" />
        </svg>
      </span>
    </a>
    <a
      href="/articulos"
      class="group inline-flex items-center gap-3 border border-[color:var(--fg)]/25 hover:border-[color:var(--fg)] text-[color:var(--fg)] px-6 sm:px-7 h-12 sm:h-14 text-[11px] sm:text-xs uppercase tracking-[0.24em] transition-colors"
    >
      Leer publicaciones
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-[color:var(--fg-muted)] group-hover:text-[color:var(--fg)] transition-all group-hover:translate-x-0.5"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m13 5 7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
