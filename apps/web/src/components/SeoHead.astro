---
import type { SiteConfigMap } from "~/lib/site-config";

type SeoType = "website" | "article" | "book" | "person";

interface AuthorRef {
  name: string;
  url?: string | null;
}

interface Props {
  type: SeoType;
  title: string;
  description: string;
  url: string;
  image?: string | null;
  imageAlt?: string | null;
  keywords?: string[] | null;
  canonical?: string | null;
  config: SiteConfigMap;
  // Article + Book — support either the legacy single-author props
  // (authorName/authorUrl) or the new multi-author array. The array
  // wins if provided; otherwise the legacy fields are normalized into
  // a one-element array internally.
  publishedAt?: string | null;
  updatedAt?: string | null;
  authorName?: string | null;
  authorUrl?: string | null;
  authors?: AuthorRef[] | null;
  // Article only
  section?: string | null;
  tags?: string[] | null;
  // Book only
  isbn?: string | null;
  // Person only
  sameAs?: string[] | null;
  // Breadcrumb (for any type)
  breadcrumb?: { name: string; url: string }[] | null;
}

const {
  type,
  title,
  description,
  url,
  image,
  imageAlt,
  keywords,
  canonical,
  config,
  publishedAt,
  updatedAt,
  authorName,
  authorUrl,
  authors: authorsProp,
  section,
  tags,
  isbn,
  sameAs,
  breadcrumb,
} = Astro.props as Props;

// Normalize authors into one consistent shape regardless of how the
// caller passed them in. The first entry is treated as the primary
// author for tags that only fit one name (e.g. og:book:author, meta
// name=author, twitter:creator fallback).
const authorList: AuthorRef[] = (authorsProp && authorsProp.length > 0)
  ? authorsProp.filter((a) => a && a.name)
  : authorName
    ? [{ name: authorName, url: authorUrl ?? null }]
    : [];
const primaryAuthorName = authorList[0]?.name ?? null;

// Branding strings. The full site name (with tagline) lives in the
// <title> for the home page and as the og:site_name everywhere — it's
// how the brand should appear on SERPs alongside the URL.
const siteName = "Casa de Asterión Ediciones";
const siteTagline = "Filosofía y poesía";
const siteFullName = `${siteName} — ${siteTagline}`;

// Title strategy:
//  - Home page (type=website with the bare site name) → use the full
//    branded title to lead the SERP listing.
//  - All other pages append the short site name as a suffix so users
//    still see the brand without truncating the page-specific part.
const isHomeTitle =
  type === "website" &&
  (title === siteName || title === siteFullName || title === "");
const fullTitle = isHomeTitle
  ? siteFullName
  : title.includes(siteName)
    ? title
    : `${title} · ${siteName}`;

const ogImage = image || config.og_image_default || "";
const ogImageAlt = imageAlt || title || siteFullName;
const canonicalUrl = canonical || url;

// Keywords ordering matters: page-specific terms first, then global
// defaults. Deduplicate to keep the meta tag honest.
const mergedKeywordsRaw = [
  ...(keywords ?? []),
  ...(config.default_keywords ?? []),
].filter(Boolean) as string[];
const seenKw = new Set<string>();
const mergedKeywords: string[] = [];
for (const k of mergedKeywordsRaw) {
  const norm = k.trim().toLowerCase();
  if (!norm || seenKw.has(norm)) continue;
  seenKw.add(norm);
  mergedKeywords.push(k.trim());
}

const twitterHandle = config.twitter_handle?.startsWith("@")
  ? config.twitter_handle
  : config.twitter_handle ? `@${config.twitter_handle}` : "";

const siteOrigin = new URL("/", url).href;

// Organization (sin LocalBusiness): la editorial no tiene sede física,
// opera online distribuyendo en Colombia. areaServed se limita a
// Colombia como país; sin address/geo/openingHours para no afirmar
// presencia física que no existe.
const organization: Record<string, unknown> = {
  "@type": "Organization",
  "@id": `${siteOrigin}#organization`,
  name: siteName,
  alternateName: ["Casa de Asterión", "Casa de Asterion Ediciones"],
  url: siteOrigin,
  slogan: siteTagline,
  description: config.editorial_description,
  knowsAbout: [
    "Filosofía",
    "Poesía",
    "Ensayo filosófico",
    "Filosofía contemporánea",
    "Poesía contemporánea",
    "Literatura latinoamericana",
    "Edición independiente",
    "Edición de libros",
  ],
  areaServed: [
    { "@type": "Country", name: "Colombia", "@id": "https://www.wikidata.org/wiki/Q739" },
  ],
};
if (config.organization_logo_url) {
  organization.logo = { "@type": "ImageObject", url: config.organization_logo_url };
  organization.image = config.organization_logo_url;
}
if (config.contact_email) {
  organization.email = config.contact_email;
}
if (config.whatsapp_phone) {
  organization.telephone = config.whatsapp_phone;
}
const sameAsLinks = [
  config.social_links?.facebook,
  config.social_links?.instagram,
  config.social_links?.twitter,
].filter(Boolean);
if (sameAsLinks.length) organization.sameAs = sameAsLinks;

// Primary schema (per page type).
let primary: Record<string, unknown> | null = null;

// Schema.org `author` accepts a single object or an array of them, so
// we always emit an array when there are multiple authors and a single
// object when there's exactly one (cleaner JSON for the common case).
const authorSchemaList = authorList.map((a) => ({
  "@type": "Person",
  name: a.name,
  ...(a.url ? { url: a.url } : {}),
}));
const authorSchemaValue =
  authorSchemaList.length === 0
    ? null
    : authorSchemaList.length === 1
      ? authorSchemaList[0]
      : authorSchemaList;

if (type === "article") {
  primary = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    url,
    inLanguage: "es",
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    ...(ogImage ? { image: ogImage } : {}),
    ...(publishedAt ? { datePublished: publishedAt } : {}),
    ...(updatedAt ? { dateModified: updatedAt } : {}),
    ...(authorSchemaValue ? { author: authorSchemaValue } : {}),
    publisher: organization,
    ...(section ? { articleSection: section } : {}),
    ...(mergedKeywords.length ? { keywords: mergedKeywords.join(", ") } : {}),
  };
} else if (type === "book") {
  primary = {
    "@context": "https://schema.org",
    "@type": "Book",
    name: title,
    description,
    url,
    inLanguage: "es",
    ...(ogImage ? { image: ogImage } : {}),
    ...(isbn ? { isbn } : {}),
    ...(authorSchemaValue ? { author: authorSchemaValue } : {}),
    ...(publishedAt ? { datePublished: publishedAt } : {}),
    bookFormat: "https://schema.org/Paperback",
    publisher: organization,
    ...(mergedKeywords.length ? { keywords: mergedKeywords.join(", ") } : {}),
  };
} else if (type === "person") {
  primary = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: title,
    description,
    url,
    ...(ogImage ? { image: ogImage } : {}),
    ...(sameAs?.length ? { sameAs } : {}),
    ...(mergedKeywords.length ? { knowsAbout: mergedKeywords } : {}),
    affiliation: organization,
  };
} else {
  // WebSite. The "@id" makes it referable from the Organization. The
  // SearchAction lets Google offer a sitelinks search box for the home.
  primary = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteOrigin}#website`,
    name: siteFullName,
    alternateName: siteName,
    description,
    url: siteOrigin,
    inLanguage: "es",
    publisher: { "@id": `${siteOrigin}#organization` },
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: `${siteOrigin}catalogo?categoria={search_term_string}`,
      },
      "query-input": "required name=search_term_string",
    },
  };
}

const ogType =
  type === "article" ? "article" : type === "book" ? "book" : type === "person" ? "profile" : "website";
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="es" href={canonicalUrl} />
<meta http-equiv="content-language" content="es" />
<meta name="theme-color" content="#1c1917" />
{/* index/follow plus the AI opt-out signals (noai/noimageai) some
    crawlers honor. Single canonical robots meta — avoids the
    conflicting-tag ambiguity browsers/bots have when there are two. */}
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,noai,noimageai" />
{primaryAuthorName && type !== "person" && (
  <meta name="author" content={primaryAuthorName} />
)}
{!primaryAuthorName && (
  <meta name="author" content={siteName} />
)}
{mergedKeywords.length > 0 && (
  <meta name="keywords" content={mergedKeywords.join(", ")} />
)}

<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:locale" content="es_CO" />
<meta property="og:locale:alternate" content="es_ES" />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}

{type === "article" && publishedAt && (
  <meta property="article:published_time" content={publishedAt} />
)}
{type === "article" && updatedAt && (
  <meta property="article:modified_time" content={updatedAt} />
)}
{type === "article" && authorList.map((a) => (
  <meta property="article:author" content={a.name} />
))}
{type === "article" && section && (
  <meta property="article:section" content={section} />
)}
{type === "article" && (tags ?? []).map((t) => (
  <meta property="article:tag" content={t} />
))}
{type === "book" && isbn && (
  <meta property="book:isbn" content={isbn} />
)}
{type === "book" && authorList.map((a) => (
  <meta property="book:author" content={a.name} />
))}
{type === "book" && publishedAt && (
  <meta property="book:release_date" content={publishedAt} />
)}

<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
{twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
{twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}

{primary && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(primary)}
  />
)}
<script
  type="application/ld+json"
  set:html={JSON.stringify({ "@context": "https://schema.org", ...organization })}
/>
{breadcrumb && breadcrumb.length > 0 && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumb.map((b, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: b.name,
        item: b.url,
      })),
    })}
  />
)}
