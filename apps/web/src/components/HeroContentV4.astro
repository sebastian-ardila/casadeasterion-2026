---
// Static hero variant V4 — Typographic monolith.
// A wordmark-style hero: the editorial's name acts as the headline,
// followed by a single tagline and one strong CTA. Most cinematic /
// confident of the variants — best when the right-half image is rich.
---

<div class="relative z-10 w-full md:w-1/2 px-5 sm:px-8 md:px-12 lg:px-16 xl:px-20 py-12 md:py-0 max-w-2xl">
  <h1 class="font-serif text-[2.6rem] sm:text-[3.5rem] md:text-[4.2rem] lg:text-[5.4rem] xl:text-[6.2rem] leading-[0.95] text-[color:var(--fg)] mb-8 sm:mb-10">
    Casa de<br />Asterión<br />
    <span class="italic font-normal text-[color:var(--fg-muted)]">Ediciones</span>
  </h1>

  <div class="flex items-center gap-4 mb-9 sm:mb-12">
    <span class="block w-12 h-px bg-[color:var(--fg)]"></span>
    <p class="uppercase text-[11px] sm:text-xs tracking-[0.32em] text-[color:var(--fg)]">
      Filosofía · Poesía · Pensamiento contemporáneo
    </p>
  </div>

  <p class="text-base sm:text-lg leading-relaxed text-[color:var(--fg-muted)] mb-10 sm:mb-12 max-w-lg">
    Editorial independiente. Ediciones de autor en filosofía y poesía
    actuales.
  </p>

  {/* Split button: label cell + arrow cell are clearly two halves of
      one composition. The whole thing acts like a single link. Below,
      a thin secondary text-link to publicaciones, kept very quiet so
      it doesn't compete with the monolith. */}
  <div class="space-y-5 sm:space-y-6">
    <a
      href="/catalogo"
      class="group inline-flex items-stretch border border-[color:var(--fg)] text-[color:var(--fg)] hover:bg-[color:var(--fg)] hover:text-[color:var(--bg)] transition-colors"
    >
      <span class="px-6 sm:px-8 h-12 sm:h-14 inline-flex items-center text-[11px] sm:text-xs uppercase tracking-[0.26em]">
        Entrar al catálogo
      </span>
      <span class="border-l border-current/40 group-hover:border-current/60 w-12 sm:w-14 h-12 sm:h-14 inline-flex items-center justify-center transition-colors">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform duration-300 group-hover:translate-x-1"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 5 7 7-7 7" />
        </svg>
      </span>
    </a>
    <a
      href="/articulos"
      class="group inline-flex items-center gap-2 text-[11px] sm:text-xs uppercase tracking-[0.22em] text-[color:var(--fg-muted)] hover:text-[color:var(--fg)] transition-colors"
    >
      <span class="block w-5 h-px bg-current"></span>
      Leer publicaciones
    </a>
  </div>
</div>
