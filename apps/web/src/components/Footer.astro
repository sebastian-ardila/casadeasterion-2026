---
import { Icon } from "astro-icon/components";
import { loadSiteConfig } from "~/lib/site-config";
const config = await loadSiteConfig();
---

<footer class="bg-[color:var(--card)] text-[color:var(--card-fg)] mt-16 sm:mt-20 md:mt-24">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 py-12 sm:py-16 md:py-20 grid gap-10 sm:gap-12 sm:grid-cols-2 md:grid-cols-3">
    <div class="sm:col-span-2 md:col-span-1">
      <h3 class="font-serif uppercase tracking-[0.18em] text-sm mb-5 sm:mb-6">
        Casa de Asterión
      </h3>
      <p class="text-sm leading-relaxed opacity-75">
        {config.editorial_description}
      </p>
    </div>

    <div>
      <h4 class="uppercase tracking-[0.18em] text-xs font-semibold mb-4 sm:mb-5 opacity-90">
        Editorial
      </h4>
      <ul class="space-y-3 text-sm opacity-75">
        <li>
          <a href="/autores" class="inline-flex items-center gap-2 hover:opacity-100">
            <Icon name="lucide:users" class="w-4 h-4" aria-hidden="true" />
            <span>Autores</span>
          </a>
        </li>
        <li>
          <a href="/#contacto" class="inline-flex items-center gap-2 hover:opacity-100">
            <Icon name="lucide:mail" class="w-4 h-4" aria-hidden="true" />
            <span>Contacto</span>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h4 class="uppercase tracking-[0.18em] text-xs font-semibold mb-4 sm:mb-5 opacity-90">
        Contenido
      </h4>
      <ul class="space-y-3 text-sm opacity-75">
        <li>
          <a href="/articulos" class="inline-flex items-center gap-2 hover:opacity-100">
            <Icon name="lucide:newspaper" class="w-4 h-4" aria-hidden="true" />
            <span>Publicaciones</span>
          </a>
        </li>
        <li>
          <a href="/catalogo" class="inline-flex items-center gap-2 hover:opacity-100">
            <Icon name="lucide:book-open" class="w-4 h-4" aria-hidden="true" />
            <span>Catálogo</span>
          </a>
        </li>
        <li>
          <a href="/autores" class="inline-flex items-center gap-2 hover:opacity-100">
            <Icon name="lucide:users" class="w-4 h-4" aria-hidden="true" />
            <span>Autores</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  {/* Calificación en Google — separador propio, visible tanto en
      mobile como desktop. Estrellas amber sobre el card-bg oscuro
      para que llamen sin ser estridentes. */}
  <div class="border-t border-[color:var(--card-fg)]/15">
    <a
      href="https://g.page/r/CRj_mQ274MryEAI/review"
      target="_blank"
      rel="noopener noreferrer"
      class="group mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 py-5 sm:py-6 flex flex-col sm:flex-row items-center justify-center sm:justify-between gap-3 sm:gap-5 text-sm hover:opacity-100"
    >
      <span class="flex items-center gap-3 opacity-90">
        <span class="inline-flex items-center gap-0.5 text-amber-400" aria-hidden="true">
          <Icon name="lucide:star" class="w-4 h-4 fill-current" />
          <Icon name="lucide:star" class="w-4 h-4 fill-current" />
          <Icon name="lucide:star" class="w-4 h-4 fill-current" />
          <Icon name="lucide:star" class="w-4 h-4 fill-current" />
          <Icon name="lucide:star" class="w-4 h-4 fill-current" />
        </span>
        <span class="text-center sm:text-left">¿Te gustó lo que hacemos? Califícanos en Google.</span>
      </span>
      <span class="inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.18em] opacity-90 group-hover:gap-2.5 transition-all">
        <span>Dejar reseña</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7"/>
          <path d="M7 7h10v10"/>
        </svg>
      </span>
    </a>
  </div>

  <div
    class="border-t border-[color:var(--card-fg)]/15 mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 py-5 sm:py-6 flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 text-[11px] sm:text-xs opacity-65"
  >
    <p class="text-center sm:text-left">{config.footer_legal}</p>
    <div class="flex items-center gap-4 sm:gap-6 uppercase tracking-[0.18em]">
      {config.social_links.facebook && (
        <a href={config.social_links.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="inline-flex items-center gap-1.5 hover:opacity-100">
          <Icon name="lucide:facebook" class="w-3.5 h-3.5" aria-hidden="true" />
          <span>Facebook</span>
        </a>
      )}
      {config.social_links.instagram && (
        <a href={config.social_links.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="inline-flex items-center gap-1.5 hover:opacity-100">
          <Icon name="lucide:instagram" class="w-3.5 h-3.5" aria-hidden="true" />
          <span>Instagram</span>
        </a>
      )}
      {config.social_links.twitter && (
        <a href={config.social_links.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="inline-flex items-center gap-1.5 hover:opacity-100">
          <Icon name="lucide:twitter" class="w-3.5 h-3.5" aria-hidden="true" />
          <span>Twitter</span>
        </a>
      )}
    </div>
  </div>
</footer>
