---
// Header-side button that opens the cart drawer. The count badge
// updates in real time via the cart store's subscribe() listener.
---

<button
  type="button"
  id="cda-cart-btn"
  aria-label="Abrir carrito"
  class="relative inline-flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 text-[color:var(--fg)] hover:bg-[color:var(--bg-alt,rgba(0,0,0,0.04))] transition-colors rounded-sm cursor-pointer"
>
  {/* lucide:shopping-cart — el carro con ruedas es el affordance
      universal de "área de compras". El shopping-bag de antes se
      confundía con un menú lateral o una carpeta. */}
  <svg
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="8" cy="21" r="1" />
    <circle cx="19" cy="21" r="1" />
    <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" />
  </svg>
  {/* Badge oculto por default — el JS lo muestra solo cuando hay
      items. Vaciamos el texto del SSR para que, si por algún motivo
      la clase `hidden` no aplica (race condition de hidratación),
      no se vea un "0" fantasma. */}
  <span
    id="cda-cart-badge"
    class="absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 bg-stone-900 text-white text-[10px] font-semibold rounded-full inline-flex items-center justify-center hidden ring-2 ring-[color:var(--bg)]"
  ></span>
</button>

<script>
  import { getCart, subscribe } from "~/lib/cart";

  function syncBadge() {
    const badge = document.getElementById("cda-cart-badge");
    if (!badge) return;
    const total = getCart().reduce((s, it) => s + it.quantity, 0);
    if (total > 0) {
      badge.textContent = String(total > 99 ? "99+" : total);
      badge.classList.remove("hidden");
    } else {
      badge.classList.add("hidden");
    }
  }

  function init() {
    syncBadge();
    const btn = document.getElementById("cda-cart-btn");
    if (btn && !btn.dataset.bound) {
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("cda:open-cart"));
      });
    }
  }

  subscribe(syncBadge);
  init();
  document.addEventListener("astro:page-load", init);
</script>
