---
// Static hero variant V6 — Asterisk monogram.
// Plays on the editorial's name: "Asterión" is the Minotaur but also
// echoes "asterisk" — the typographic sign. A giant asterisk acts as
// monogram, anchoring an asymmetric composition where the statement
// reads as if it were a footnote being expanded into a full thought.
// CTAs sit on a thin baseline that also serves as a return to the
// asterisk's foot — a typographic loop.
---

<div class="relative z-10 w-full md:w-1/2 px-5 sm:px-8 md:px-12 lg:px-16 xl:px-20 py-12 md:py-0 max-w-2xl">
  <div class="grid grid-cols-[auto_1fr] gap-x-5 sm:gap-x-7 lg:gap-x-9 items-start">
    {/* Giant asterisk as monogram */}
    <span
      class="font-serif text-[7rem] sm:text-[9rem] md:text-[10rem] lg:text-[13rem] xl:text-[15rem] leading-[0.7] text-[color:var(--fg)] select-none -translate-y-2 sm:-translate-y-3"
      aria-hidden="true"
    >
      ✱
    </span>

    <div class="pt-4 sm:pt-6 md:pt-8 min-w-0">
      <p class="uppercase text-[10px] sm:text-[11px] tracking-[0.32em] text-[color:var(--fg-muted)] mb-4 sm:mb-5">
        Casa de Asterión
      </p>
      <h1 class="font-serif text-[1.6rem] sm:text-[2rem] md:text-[2.4rem] lg:text-[2.8rem] xl:text-[3.2rem] leading-[1.12] text-[color:var(--fg)] mb-5 sm:mb-7">
        Algunas
        <span class="italic">notas al margen</span>
        merecen volverse libros.
      </h1>
      <p class="font-serif italic text-base sm:text-lg lg:text-xl text-[color:var(--fg-muted)] leading-relaxed">
        Filosofía y poesía contemporáneas, editadas con cuidado de
        manuscrito.
      </p>
    </div>
  </div>

  {/* Baseline rule + CTAs — extends the bottom of the asterisk's foot
      across the full column, then breaks for the actions. */}
  <div class="mt-10 sm:mt-12 md:mt-14 flex items-stretch gap-4 sm:gap-6">
    <a
      href="/catalogo"
      class="group inline-flex items-center gap-3 sm:gap-4 bg-[color:var(--fg)] text-[color:var(--bg)] pl-6 pr-3 sm:pl-8 sm:pr-4 h-12 sm:h-14 text-[11px] sm:text-xs uppercase tracking-[0.26em] hover:bg-[color:var(--fg-muted)] transition-colors"
    >
      Ver el catálogo
      <span class="font-serif text-xl sm:text-2xl leading-none -mt-1" aria-hidden="true">✱</span>
    </a>
    <a
      href="/articulos"
      class="group inline-flex items-center gap-2 text-[11px] sm:text-xs uppercase tracking-[0.24em] text-[color:var(--fg-muted)] hover:text-[color:var(--fg)] transition-colors"
    >
      <span class="font-serif text-base leading-none" aria-hidden="true">*</span>
      Leer publicaciones
    </a>
  </div>
</div>
