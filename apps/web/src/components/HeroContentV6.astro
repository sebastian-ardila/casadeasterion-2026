---
// Static hero variant V6 — Asterisk monogram.
// Plays on the editorial's name: "Asterión" is the Minotaur but also
// echoes "asterisk" — the typographic sign. A giant asterisk acts as
// monogram, anchoring an asymmetric composition where the statement
// reads as if it were a footnote being expanded into a full thought.
// CTAs sit on a thin baseline that also serves as a return to the
// asterisk's foot — a typographic loop.
---

<div class="relative z-10 w-full md:w-1/2 px-5 sm:px-8 md:px-12 lg:px-16 xl:px-20 py-12 md:py-0 max-w-2xl">
  {/* On mobile (xs–sm), the asterisk sits above the text so neither
      side gets crushed in a narrow viewport. On md+ the asymmetric
      side-by-side composition kicks in. */}
  <div class="flex flex-col sm:grid sm:grid-cols-[auto_1fr] sm:gap-x-7 lg:gap-x-9 sm:items-start">
    {/* Giant asterisk as monogram */}
    <span
      class="font-serif text-[5rem] sm:text-[8rem] md:text-[10rem] lg:text-[13rem] xl:text-[15rem] leading-[0.7] text-[color:var(--fg)] select-none mb-2 sm:mb-0 sm:-translate-y-3"
      aria-hidden="true"
    >
      ✱
    </span>

    <div class="sm:pt-6 md:pt-8 min-w-0">
      <p class="uppercase text-[10px] sm:text-[11px] tracking-[0.32em] text-[color:var(--fg-muted)] mb-3 sm:mb-5">
        Casa de Asterión
      </p>
      <h1 class="font-serif text-[1.5rem] sm:text-[1.9rem] md:text-[2.4rem] lg:text-[2.8rem] xl:text-[3.2rem] leading-[1.15] sm:leading-[1.12] text-[color:var(--fg)] mb-4 sm:mb-7">
        Algunas
        <span class="italic"> notas al margen </span>
        merecen volverse libros.
      </h1>
      <p class="font-serif italic text-[0.95rem] sm:text-lg lg:text-xl text-[color:var(--fg-muted)] leading-relaxed">
        Filosofía y poesía contemporáneas, editadas con cuidado de manuscrito.
      </p>
    </div>
  </div>

  {/* CTAs — flex-wrap so the secondary drops below on narrow screens
      instead of forcing the pill to shrink horribly. */}
  <div class="mt-9 sm:mt-12 md:mt-14 flex flex-wrap items-center gap-x-4 gap-y-4 sm:gap-x-6">
    <a
      href="/catalogo"
      class="group inline-flex items-center gap-3 sm:gap-4 bg-[color:var(--fg)] text-[color:var(--bg)] pl-5 pr-3 sm:pl-8 sm:pr-4 h-11 sm:h-14 text-[11px] sm:text-xs uppercase tracking-[0.24em] sm:tracking-[0.26em] hover:bg-[color:var(--fg-muted)] transition-colors"
    >
      Ver el catálogo
      <span class="font-serif text-lg sm:text-2xl leading-none -mt-0.5" aria-hidden="true">✱</span>
    </a>
    <a
      href="/articulos"
      class="group inline-flex items-center gap-2 text-[11px] sm:text-xs uppercase tracking-[0.22em] sm:tracking-[0.24em] text-[color:var(--fg-muted)] hover:text-[color:var(--fg)] transition-colors"
    >
      <span class="font-serif text-base leading-none" aria-hidden="true">*</span>
      Leer publicaciones
    </a>
  </div>
</div>
