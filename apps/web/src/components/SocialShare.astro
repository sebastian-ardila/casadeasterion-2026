---
import { Icon } from "astro-icon/components";

// Botones para compartir el contenido actual en redes sociales. La
// preview (imagen, título, descripción) la maneja el OG que se emite
// desde SeoHead — aquí solo construimos los share-URLs canónicos.
//
// Uso:
//   <SocialShare url={pageUrl} title={`Título (Categoría)`} />
//
// `url` se asume ya absoluta (canónica) y se URL-encodea. `title` se
// usa como texto pre-compuesto en WhatsApp/Twitter/Email; el resto de
// redes lo ignoran y leen el OG.

interface Props {
  url: string;
  title: string;
  /** Pequeño rótulo opcional encima de los íconos. */
  label?: string;
  /** Clase extra del wrapper para ajustar márgenes per-página. */
  className?: string;
}

const { url, title, label = "Compartir", className = "" } = Astro.props;

const encUrl = encodeURIComponent(url);
const encText = encodeURIComponent(title);
const encTitlePlusUrl = encodeURIComponent(`${title}\n${url}`);

// WhatsApp: api.whatsapp.com/send funciona tanto en desktop (lleva a
// WhatsApp Web) como en mobile (al app si está instalado). Mejor que
// wa.me porque no requiere número.
const whatsappHref = `https://api.whatsapp.com/send?text=${encTitlePlusUrl}`;
// Twitter/X: el dominio nuevo (x.com/intent/tweet) funciona; el viejo
// twitter.com/intent también — uso x.com porque el rebrand ya cuajó.
const twitterHref = `https://x.com/intent/tweet?text=${encText}&url=${encUrl}`;
const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${encUrl}`;
const linkedinHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encUrl}`;
// mailto: subject + body. El navegador abre el cliente de correo.
const mailHref = `mailto:?subject=${encText}&body=${encTitlePlusUrl}`;

// WhatsApp no tiene un equivalente exacto en lucide-icons (su
// "message-circle" se confunde con un bocadillo genérico). Usamos el
// glifo oficial inline para que el botón sea identificable a primera
// vista. Los demás iconos sí vienen de Lucide.
const buttons: { kind: string; href: string; icon: string | null; label: string }[] = [
  { kind: "whatsapp", href: whatsappHref, icon: null,                     label: "WhatsApp" },
  { kind: "twitter",  href: twitterHref,  icon: "lucide:twitter",         label: "X (Twitter)" },
  { kind: "facebook", href: facebookHref, icon: "lucide:facebook",        label: "Facebook" },
  { kind: "linkedin", href: linkedinHref, icon: "lucide:linkedin",        label: "LinkedIn" },
  { kind: "email",    href: mailHref,     icon: "lucide:mail",            label: "Email" },
];
---

<div class={`cas-social-share ${className}`} data-cas-share-url={url}>
  <p class="cas-social-label">{label}</p>
  <div class="cas-social-row">
    {buttons.map((b) => (
      <a
        href={b.href}
        target={b.kind === "email" ? undefined : "_blank"}
        rel={b.kind === "email" ? undefined : "noopener noreferrer"}
        class={`cas-social-btn cas-social-btn-${b.kind}`}
        aria-label={`Compartir en ${b.label}`}
        title={`Compartir en ${b.label}`}
      >
        {b.kind === "whatsapp" ? (
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.464 3.488"/>
          </svg>
        ) : (
          <Icon name={b.icon!} class="w-4 h-4" aria-hidden="true" />
        )}
      </a>
    ))}
    <button
      type="button"
      class="cas-social-btn cas-social-btn-copy"
      data-cas-copy-link
      aria-label="Copiar enlace"
      title="Copiar enlace"
    >
      <Icon name="lucide:link" class="w-4 h-4 cas-social-icon-link" aria-hidden="true" />
      <Icon name="lucide:check" class="w-4 h-4 cas-social-icon-check" aria-hidden="true" />
    </button>
  </div>
</div>

<style is:global>
  .cas-social-share {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .cas-social-label {
    margin: 0;
    text-transform: uppercase;
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    color: var(--fg-muted);
  }
  .cas-social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cas-social-btn {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    background: var(--bg-alt);
    color: var(--fg);
    transition: background-color 0.15s, border-color 0.15s, color 0.15s, transform 0.15s;
  }
  .cas-social-btn:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
    transform: translateY(-1px);
  }
  /* Copy-link toggles which icon is visible. Default: link icon; tras
     el click pasa a check con un fade. Vuelve a link después de 1.5s. */
  .cas-social-btn-copy .cas-social-icon-check { display: none; }
  .cas-social-btn-copy.is-copied .cas-social-icon-link { display: none; }
  .cas-social-btn-copy.is-copied .cas-social-icon-check { display: inline-block; }
  .cas-social-btn-copy.is-copied {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
</style>

<script is:inline>
  (() => {
    if (window.__casShareInit) return;
    window.__casShareInit = true;

    async function copyToClipboard(text) {
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch {}
      // Fallback para contextos sin clipboard API (iOS WebView, http).
      try {
        const ta = document.createElement("textarea");
        ta.value = text;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand("copy");
        document.body.removeChild(ta);
        return ok;
      } catch {
        return false;
      }
    }

    document.addEventListener("click", async (e) => {
      const btn = e.target instanceof Element ? e.target.closest("[data-cas-copy-link]") : null;
      if (!btn) return;
      e.preventDefault();
      const container = btn.closest(".cas-social-share");
      const url = (container && container.getAttribute("data-cas-share-url")) || window.location.href;
      const ok = await copyToClipboard(url);
      if (ok) {
        btn.classList.add("is-copied");
        setTimeout(() => btn.classList.remove("is-copied"), 1500);
      }
    });
  })();
</script>
