---
import type { Post, Author, Category } from "~/lib/supabase";

interface Props {
  post: Post;
  author?: Author | null;
  category?: Category | null;
  href?: string;
}

const { post, author, category, href } = Astro.props;
const link = href ?? `/articulos/${post.slug}`;

const formatted = post.published_at
  ? new Intl.DateTimeFormat("es-CO", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(new Date(post.published_at))
  : "";
---

<article class="border-b border-[color:var(--border)] pb-10">
  {category && (
    <p class="uppercase text-xs tracking-[0.18em] text-[color:var(--fg-muted)] mb-3">
      {category.name}
    </p>
  )}
  <h3 class="font-serif text-2xl md:text-3xl mb-3">
    <a href={link} class="hover:opacity-70">{post.title}</a>
  </h3>
  {post.excerpt && (
    <p class="text-[color:var(--fg-muted)] leading-relaxed max-w-prose mb-4">
      {post.excerpt}
    </p>
  )}
  <div class="flex items-center gap-4 text-xs uppercase tracking-[0.12em] text-[color:var(--fg-muted)]">
    {author && <span>{author.name}</span>}
    {formatted && <span>{formatted}</span>}
    {post.reading_time_minutes && (
      <span>{post.reading_time_minutes} min</span>
    )}
  </div>
  <a
    href={link}
    class="inline-block mt-5 uppercase text-xs tracking-[0.18em] border-b border-[color:var(--fg)] pb-1 hover:opacity-70"
  >
    Leer publicación
  </a>
</article>
