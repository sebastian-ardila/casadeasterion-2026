---
import type { Post, Author, Category } from "~/lib/supabase";

interface Props {
  post: Post;
  author?: Author | null;
  category?: Category | null;
  href?: string;
}

const { post, author, category, href } = Astro.props;
const link = href ?? `/articulos/${post.slug}`;

const formatted = post.published_at
  ? new Intl.DateTimeFormat("es-CO", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(new Date(post.published_at))
  : "";
---

<article class="group flex flex-col h-full">
  {/* Cover area — full-width image or editorial-mark placeholder.
      The whole image is a link to the publication so the user can
      tap the card itself; the title below is also a link for
      keyboard / accessibility access. */}
  <a
    href={link}
    class="block aspect-[16/10] overflow-hidden bg-[color:var(--bg-alt)] ring-1 ring-stone-900/[0.04] mb-4 sm:mb-5"
    aria-label={post.title}
  >
    {post.cover_image_url ? (
      <img
        src={post.cover_image_url}
        alt={post.cover_image_alt ?? post.title}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-[color:var(--bg-alt)] to-stone-100">
        {/* Placeholder: silueta del laberinto/quill como marca de
            la editorial. Bajo contraste para no competir con tarjetas
            que sí tienen portada. */}
        <svg
          class="w-16 h-16 sm:w-20 sm:h-20 text-stone-300 group-hover:text-stone-400 transition-colors"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
          <path d="M8 7h8M8 11h6M8 15h4"/>
        </svg>
      </div>
    )}
  </a>

  <div class="flex flex-col flex-1 min-w-0">
    {category && (
      <p class="uppercase text-[10px] sm:text-[11px] tracking-[0.18em] text-[color:var(--fg-muted)] mb-2">
        {category.name}
      </p>
    )}
    <h3 class="font-serif text-lg sm:text-xl md:text-2xl leading-snug mb-2 sm:mb-3 line-clamp-3">
      <a href={link} class="hover:opacity-70 transition-opacity">{post.title}</a>
    </h3>
    {post.excerpt && (
      <p class="text-sm text-[color:var(--fg-muted)] leading-relaxed line-clamp-3 mb-4">
        {post.excerpt}
      </p>
    )}
    {/* Meta row pinned to the bottom of the card so cards line up
        evenly even when titles / excerpts have different lengths. */}
    <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 text-[10px] sm:text-[11px] uppercase tracking-[0.12em] text-[color:var(--fg-muted)]">
      {author && <span class="truncate max-w-[160px]">{author.name}</span>}
      {formatted && <span>{formatted}</span>}
      {post.reading_time_minutes && (
        <span>{post.reading_time_minutes} min</span>
      )}
    </div>
  </div>
</article>
