---
import type { Post, Author, Category } from "~/lib/supabase";
import { mdToPlainText, clampText } from "~/lib/markdown";

interface Props {
  post: Post;
  author?: Author | null;
  category?: Category | null;
  href?: string;
}

const { post, author, category, href } = Astro.props;
const link = href ?? `/articulos/${post.slug}`;

const formatted = post.published_at
  ? new Intl.DateTimeFormat("es-CO", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(new Date(post.published_at))
  : "";

// Vistazo al cuerpo de la publicación: primeras líneas del contenido
// con markdown stripped y clampeo en frontera de palabra. Se renderiza
// debajo del excerpt como un "fragmento" en cursiva. Cuando no hay
// excerpt, el teaser ocupa el rol principal de descripción.
const contentTeaser = clampText(mdToPlainText(post.content_md), 180);
const hasExcerpt = Boolean(post.excerpt?.trim());
---

<article class="group flex flex-col h-full">
  {/* Cover area — full-width image or editorial-mark placeholder.
      The whole image is a link to the publication so the user can
      tap the card itself; the title below is also a link for
      keyboard / accessibility access. Subtle shadow lifts on hover
      to give the card a sense of depth. */}
  <a
    href={link}
    class="block aspect-[16/10] overflow-hidden bg-[color:var(--bg-alt)] ring-1 ring-stone-900/[0.04] mb-5 sm:mb-6 shadow-sm shadow-stone-900/5 transition-shadow duration-300 group-hover:shadow-md group-hover:shadow-stone-900/15"
    aria-label={post.title}
  >
    {post.cover_image_url ? (
      <img
        src={post.cover_image_url}
        alt={post.cover_image_alt ?? post.title}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-[color:var(--bg-alt)] to-stone-100">
        {/* Placeholder: silueta de hoja de notas / libro como marca de
            la editorial. Bajo contraste para no competir con tarjetas
            que sí tienen portada. */}
        <svg
          class="w-20 h-20 sm:w-24 sm:h-24 text-stone-300 group-hover:text-stone-400 transition-colors"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
          <path d="M8 7h8M8 11h6M8 15h4"/>
        </svg>
      </div>
    )}
  </a>

  <div class="flex flex-col flex-1 min-w-0">
    {category && (
      <p class="uppercase text-[11px] sm:text-xs tracking-[0.2em] text-[color:var(--fg-muted)] mb-3">
        {category.name}
      </p>
    )}
    <h3 class="font-serif text-xl sm:text-2xl md:text-[1.75rem] leading-[1.15] mb-3 sm:mb-4 line-clamp-3">
      <a href={link} class="hover:opacity-70 transition-opacity">{post.title}</a>
    </h3>
    {hasExcerpt && (
      <p class="text-[15px] sm:text-base text-[color:var(--fg-muted)] leading-relaxed line-clamp-2 mb-4">
        {post.excerpt}
      </p>
    )}
    {contentTeaser && (
      <p
        class:list={[
          "font-serif italic text-[color:var(--fg)] opacity-75 leading-[1.55] mb-5 sm:mb-6",
          // Más grande cuando es la única descripción (sin excerpt arriba)
          hasExcerpt
            ? "text-[15px] sm:text-base line-clamp-3"
            : "text-base sm:text-lg line-clamp-4",
        ]}
      >
        {contentTeaser}
      </p>
    )}
    {/* Meta row pinned to the bottom of the card so cards line up
        evenly even when titles / excerpts have different lengths.
        Bumped from text-[10px] to text-xs for readability, with the
        "Leer →" affordance on the right to invite a click. */}
    <div class="mt-auto pt-4 border-t border-[color:var(--border)] flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-xs sm:text-[13px] tracking-[0.06em] text-[color:var(--fg-muted)]">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 min-w-0">
        {author && (
          <span class="truncate max-w-[180px] text-[color:var(--fg)] opacity-80">{author.name}</span>
        )}
        {formatted && (
          <>
            {author && <span aria-hidden="true" class="opacity-40">·</span>}
            <span>{formatted}</span>
          </>
        )}
        {post.reading_time_minutes && (
          <>
            <span aria-hidden="true" class="opacity-40">·</span>
            <span>{post.reading_time_minutes} min</span>
          </>
        )}
      </div>
      <a
        href={link}
        class="inline-flex items-center gap-1.5 uppercase text-[11px] sm:text-xs tracking-[0.18em] text-[color:var(--fg)] hover:opacity-70 transition-opacity shrink-0"
        aria-label={`Leer ${post.title}`}
      >
        Leer
        <svg
          class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>
