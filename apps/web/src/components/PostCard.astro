---
import type { Post, Author, Category } from "~/lib/supabase";
import { mdToPlainText, clampText } from "~/lib/markdown";

interface Props {
  post: Post;
  author?: Author | null;
  category?: Category | null;
  href?: string;
}

const { post, author, category, href } = Astro.props;
const link = href ?? `/articulos/${post.slug}`;

const formatted = post.published_at
  ? new Intl.DateTimeFormat("es-CO", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(new Date(post.published_at))
  : "";

// Vistazo al cuerpo de la publicación: primeras líneas del contenido
// con markdown stripped y clampeo en frontera de palabra. Es el
// "fragmento" en cursiva del cuerpo. Cuando no hay excerpt, este
// teaser hace de descripción principal.
const contentTeaser = clampText(mdToPlainText(post.content_md), 180);
const hasExcerpt = Boolean(post.excerpt?.trim());
---

{/* La tarjeta entera es un solo enlace via overlay absoluto. Todo lo
    visible (imagen, título, meta) está envuelto en un <article
    class="relative">; un <a class="absolute inset-0"> queda detrás
    del contenido haciendo que cualquier click — fuera de selección de
    texto — navegue a la publicación. El título también tiene su <a>
    propio para que sea el enlace "real" que ven lectores de pantalla
    y herramientas de SEO. */}
<article class="group relative flex flex-col h-full">
  <a
    href={link}
    class="absolute inset-0 z-0 rounded-sm"
    aria-label={post.title}
    tabindex="-1"
  ></a>

  {/* Cover area — imagen ocupa el ancho completo o placeholder
      editorial. La categoría se rinderiza como chip sobre la imagen
      en la esquina superior izquierda para liberar espacio en el
      cuerpo y dar jerarquía visual. */}
  <div class="relative aspect-[16/10] overflow-hidden bg-[color:var(--bg-alt)] ring-1 ring-stone-900/[0.04] mb-5 sm:mb-6 shadow-sm shadow-stone-900/5 transition-shadow duration-300 group-hover:shadow-lg group-hover:shadow-stone-900/15">
    {post.cover_image_url ? (
      <img
        src={post.cover_image_url}
        alt={post.cover_image_alt ?? post.title}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-[color:var(--bg-alt)] to-stone-100">
        <svg
          class="w-20 h-20 sm:w-24 sm:h-24 text-stone-300 group-hover:text-stone-400 transition-colors"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
          <path d="M8 7h8M8 11h6M8 15h4"/>
        </svg>
      </div>
    )}
    {category && (
      <span class="absolute top-3 left-3 sm:top-4 sm:left-4 inline-flex items-center px-2.5 py-1 bg-white/95 backdrop-blur-sm uppercase text-[10px] sm:text-[11px] tracking-[0.18em] text-[color:var(--fg)]">
        {category.name}
      </span>
    )}
  </div>

  <div class="relative z-10 flex flex-col flex-1 min-w-0 pointer-events-none [&_a]:pointer-events-auto">
    {/* Título prominente. Hover dispara una pseudo-underline que crece
        desde la izquierda — patrón editorial. */}
    <h3 class="font-serif text-2xl sm:text-[1.6rem] md:text-[1.85rem] leading-[1.15] mb-3 line-clamp-3">
      <a
        href={link}
        class="bg-[linear-gradient(currentColor,currentColor)] bg-no-repeat bg-[length:0_1px] bg-[position:0_100%] hover:bg-[length:100%_1px] transition-[background-size] duration-500"
      >
        {post.title}
      </a>
    </h3>

    {hasExcerpt && (
      <p class="text-base sm:text-lg text-[color:var(--fg)] opacity-85 leading-snug mb-3 line-clamp-2">
        {post.excerpt}
      </p>
    )}

    {contentTeaser && (
      <p
        class:list={[
          "font-serif italic text-[color:var(--fg-muted)] leading-[1.55] mb-5",
          hasExcerpt
            ? "text-base sm:text-lg line-clamp-3"
            : "text-lg sm:text-xl line-clamp-4",
        ]}
      >
        {contentTeaser}
      </p>
    )}

    {/* Pie de la tarjeta. Dos líneas estables (autor arriba, fecha ·
        minutos abajo) evitan el wrap caótico cuando el nombre del
        autor es largo. La flecha se ancla a la derecha, centrada
        verticalmente con el bloque. */}
    <div class="mt-auto pt-4 border-t border-[color:var(--border)] flex items-center justify-between gap-4">
      <div class="min-w-0 flex-1">
        {author && (
          <p class="font-medium text-[color:var(--fg)] text-sm sm:text-[15px] truncate leading-tight">
            {author.name}
          </p>
        )}
        {(formatted || post.reading_time_minutes) && (
          <p class:list={[
            "text-[color:var(--fg-muted)] text-xs sm:text-[13px] leading-tight",
            author ? "mt-1" : "",
          ]}>
            {formatted}
            {formatted && post.reading_time_minutes && (
              <span aria-hidden="true" class="mx-1.5 opacity-50">·</span>
            )}
            {post.reading_time_minutes && (
              <span>{post.reading_time_minutes} min</span>
            )}
          </p>
        )}
      </div>
      <svg
        class="w-5 h-5 text-[color:var(--fg)] shrink-0 transition-transform duration-300 group-hover:translate-x-1"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 5l7 7-7 7"/>
      </svg>
    </div>
  </div>
</article>
