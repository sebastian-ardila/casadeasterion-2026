---
// Static hero variant V3 — Editorial diptych.
// Two editorial areas (Filosofía / Poesía) presented as parallel columns
// that describe the editorial's scope across both books and writings.
// Categories are areas, not section links — they apply to the whole
// catalog. Single CTA to the catalog.
---

<div class="relative z-10 w-full md:w-1/2 px-5 sm:px-8 md:px-12 lg:px-16 xl:px-20 py-12 md:py-0 max-w-2xl">
  <div class="flex items-center gap-3 mb-7 sm:mb-9">
    <span class="block w-8 h-px bg-[color:var(--fg-muted)]"></span>
    <p class="uppercase text-[10px] sm:text-[11px] tracking-[0.32em] text-[color:var(--fg-muted)]">
      Casa de Asterión Ediciones
    </p>
  </div>

  <h1 class="font-serif text-[1.85rem] sm:text-[2.6rem] md:text-5xl lg:text-[3.4rem] xl:text-[3.8rem] leading-[1.1] sm:leading-[1.06] text-[color:var(--fg)] mb-5 sm:mb-7">
    Una editorial dedicada a las preguntas que <span class="italic">persisten</span>.
  </h1>

  <p class="font-serif text-base sm:text-xl lg:text-2xl italic text-[color:var(--fg-muted)] leading-relaxed mb-9 sm:mb-12 max-w-xl">
    Dos áreas, una misma búsqueda: libros que reabren conversaciones que
    creíamos cerradas.
  </p>

  {/* Editorial areas — presented as a diptych. These are scope
      descriptors of the whole catalog, not nav links. */}
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-6 sm:gap-x-10 border-t border-[color:var(--border)] pt-7 sm:pt-10 mb-9 sm:mb-12">
    <div>
      <p class="uppercase text-[10px] sm:text-[11px] tracking-[0.24em] text-[color:var(--fg-muted)] mb-2.5">
        Área 01
      </p>
      <h2 class="font-serif text-xl sm:text-2xl text-[color:var(--fg)] mb-2">
        Filosofía
      </h2>
      <p class="text-[13px] sm:text-sm text-[color:var(--fg-muted)] leading-relaxed">
        Pensamiento contemporáneo en traducciones cuidadosas y autoría nueva.
      </p>
    </div>
    <div>
      <p class="uppercase text-[10px] sm:text-[11px] tracking-[0.24em] text-[color:var(--fg-muted)] mb-2.5">
        Área 02
      </p>
      <h2 class="font-serif text-xl sm:text-2xl text-[color:var(--fg)] mb-2">
        Poesía
      </h2>
      <p class="text-[13px] sm:text-sm text-[color:var(--fg-muted)] leading-relaxed">
        Voces vivas en español, con énfasis en la poesía actual.
      </p>
    </div>
  </div>

  {/* Primary: large circle-arrow paired with text — classic editorial
      "next page" affordance. Secondary: a quiet inline link. */}
  <div class="flex flex-wrap items-center gap-x-8 sm:gap-x-10 gap-y-5">
    <a href="/catalogo" class="group inline-flex items-center gap-3 sm:gap-5">
      <span class="relative flex items-center justify-center w-11 h-11 sm:w-14 sm:h-14 shrink-0 rounded-full border border-[color:var(--fg)] text-[color:var(--fg)] group-hover:bg-[color:var(--fg)] group-hover:text-[color:var(--bg)] transition-colors overflow-hidden">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform duration-300 group-hover:translate-x-1.5"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 5 7 7-7 7" />
        </svg>
      </span>
      <span class="flex flex-col leading-tight">
        <span class="uppercase text-[12px] sm:text-[13px] tracking-[0.26em] text-[color:var(--fg)]">
          Ver el catálogo
        </span>
        <span class="text-[11px] sm:text-xs text-[color:var(--fg-muted)] mt-1 italic">
          Libros publicados
        </span>
      </span>
    </a>
    <a
      href="/articulos"
      class="group inline-flex items-center gap-1.5 text-[12px] sm:text-[13px] text-[color:var(--fg-muted)] hover:text-[color:var(--fg)] transition-colors"
    >
      <span class="underline underline-offset-4 decoration-[color:var(--fg-muted)]/40 group-hover:decoration-[color:var(--fg)]">
        Leer publicaciones
      </span>
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform group-hover:translate-x-0.5"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m13 5 7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
