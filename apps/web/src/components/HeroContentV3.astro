---
// Static hero variant V3 — Editorial diptych.
// Two editorial areas (Filosofía / Poesía) presented as parallel columns
// that describe the editorial's scope across both books and writings.
// Categories are areas, not section links — they apply to the whole
// catalog. Single CTA to the catalog.
---

<div class="relative z-10 w-full md:w-1/2 px-5 sm:px-8 md:px-12 lg:px-16 xl:px-20 py-12 md:py-0 max-w-2xl">
  <div class="flex items-center gap-3 mb-7 sm:mb-9">
    <span class="block w-8 h-px bg-[color:var(--fg-muted)]"></span>
    <p class="uppercase text-[10px] sm:text-[11px] tracking-[0.32em] text-[color:var(--fg-muted)]">
      Casa de Asterión Ediciones
    </p>
  </div>

  <h1 class="font-serif text-[2.1rem] sm:text-[2.7rem] md:text-5xl lg:text-[3.4rem] xl:text-[3.8rem] leading-[1.06] text-[color:var(--fg)] mb-5 sm:mb-7">
    Una editorial dedicada a las preguntas que <span class="italic">persisten</span>.
  </h1>

  <p class="font-serif text-lg sm:text-xl lg:text-2xl italic text-[color:var(--fg-muted)] leading-relaxed mb-10 sm:mb-12 max-w-xl">
    Dos áreas, una misma búsqueda: libros que reabren conversaciones que
    creíamos cerradas.
  </p>

  {/* Editorial areas — presented as a diptych. These are scope
      descriptors of the whole catalog, not nav links. */}
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-7 sm:gap-x-10 border-t border-[color:var(--border)] pt-8 sm:pt-10 mb-10 sm:mb-12">
    <div>
      <p class="uppercase text-[10px] sm:text-[11px] tracking-[0.24em] text-[color:var(--fg-muted)] mb-2.5">
        Área 01
      </p>
      <h2 class="font-serif text-xl sm:text-2xl text-[color:var(--fg)] mb-2">
        Filosofía
      </h2>
      <p class="text-[13px] sm:text-sm text-[color:var(--fg-muted)] leading-relaxed">
        Pensamiento contemporáneo en traducciones cuidadosas y autoría nueva.
      </p>
    </div>
    <div>
      <p class="uppercase text-[10px] sm:text-[11px] tracking-[0.24em] text-[color:var(--fg-muted)] mb-2.5">
        Área 02
      </p>
      <h2 class="font-serif text-xl sm:text-2xl text-[color:var(--fg)] mb-2">
        Poesía
      </h2>
      <p class="text-[13px] sm:text-sm text-[color:var(--fg-muted)] leading-relaxed">
        Voces vivas en español, con énfasis en la poesía actual.
      </p>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
    <a
      href="/catalogo"
      class="group inline-flex items-center gap-3 text-[12px] sm:text-[13px] uppercase tracking-[0.26em] text-[color:var(--fg)] border-b border-[color:var(--fg)] pb-2"
    >
      Ver el catálogo
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform group-hover:translate-x-1"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m13 5 7 7-7 7" />
      </svg>
    </a>
    <a
      href="/articulos"
      class="group inline-flex items-center gap-1.5 text-[12px] sm:text-[13px] text-[color:var(--fg-muted)] hover:text-[color:var(--fg)] transition-colors pb-2"
    >
      Leer publicaciones
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform group-hover:translate-x-0.5"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m13 5 7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
