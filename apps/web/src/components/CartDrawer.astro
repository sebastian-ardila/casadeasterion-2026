---
// Slide-in drawer with the full cart contents. Mounted once in the
// Layout so any page that fires "cda:open-cart" gets it. The CartButton
// in the header dispatches that event.
---

<aside
  id="cda-cart-drawer"
  class="fixed inset-0 z-50 hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cda-cart-title"
>
  <button
    type="button"
    id="cda-cart-backdrop"
    class="absolute inset-0 bg-stone-900/40 backdrop-blur-[1px] cursor-pointer"
    aria-label="Cerrar carrito"
  ></button>
  <div
    class="absolute right-0 top-0 h-full w-full sm:w-[400px] md:w-[440px] bg-[color:var(--bg,#fff)] shadow-2xl flex flex-col transform translate-x-full transition-transform duration-200"
    id="cda-cart-panel"
  >
    <header class="px-5 sm:px-6 py-5 border-b border-[color:var(--border,#e7e5e4)] flex items-center justify-between gap-3">
      <h2 id="cda-cart-title" class="font-serif text-xl tracking-wide">Tu carrito</h2>
      <button
        type="button"
        id="cda-cart-close"
        class="text-stone-500 hover:text-stone-900 transition-colors p-1 cursor-pointer"
        aria-label="Cerrar"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </header>

    <div class="flex-1 overflow-y-auto" id="cda-cart-body">
      {/* Empty state — claramente "puedes comprar acá". Icono grande
          de carrito, mensaje editorial corto, dos CTAs: ir al catálogo
          (acción principal, sólida) e ir a colecciones (alternativa
          outline). Antes era solo un párrafo gris con un underline,
          difícil de leer como invitación a comprar. */}
      <div id="cda-cart-empty" class="px-5 sm:px-8 py-10 sm:py-14 text-center">
        <div class="mx-auto mb-5 sm:mb-6 w-16 h-16 rounded-full bg-stone-100 flex items-center justify-center text-stone-500">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="8" cy="21" r="1" />
            <circle cx="19" cy="21" r="1" />
            <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" />
          </svg>
        </div>
        <p class="font-serif text-lg sm:text-xl text-stone-900 mb-2 leading-snug">
          Tu carrito está vacío
        </p>
        <p class="text-stone-500 text-sm leading-relaxed mb-7 max-w-[28ch] mx-auto">
          Agrega libros desde el catálogo o explora las colecciones para empezar tu pedido.
        </p>
        <div class="flex flex-col gap-2.5">
          <a
            href="/catalogo"
            class="inline-flex items-center justify-center gap-2 bg-stone-900 text-white py-3 px-5 text-xs uppercase tracking-[0.16em] hover:bg-stone-800 transition-colors"
            data-cda-close-on-click
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
            </svg>
            <span>Ver catálogo</span>
          </a>
          <a
            href="/colecciones"
            class="inline-flex items-center justify-center gap-2 border border-stone-300 text-stone-700 py-3 px-5 text-xs uppercase tracking-[0.16em] hover:border-stone-900 hover:text-stone-900 transition-colors"
            data-cda-close-on-click
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 3h18v18H3zM3 9h18M9 21V9"/>
            </svg>
            <span>Ver colecciones</span>
          </a>
        </div>
        <p class="text-[11px] text-stone-400 leading-relaxed mt-6">
          Envíos en Colombia · pago confirmado por WhatsApp
        </p>
      </div>
      <ul id="cda-cart-list" class="hidden divide-y divide-[color:var(--border,#e7e5e4)]"></ul>
    </div>

    <footer
      id="cda-cart-footer"
      class="border-t border-[color:var(--border,#e7e5e4)] px-5 sm:px-6 py-5 hidden"
    >
      <div class="flex items-baseline justify-between mb-4">
        <span class="text-xs uppercase tracking-[0.16em] text-stone-500">Total estimado</span>
        <span id="cda-cart-total" class="font-serif text-2xl">—</span>
      </div>
      <button
        type="button"
        id="cda-cart-checkout"
        class="w-full inline-flex items-center justify-center gap-2 bg-stone-900 text-white py-3 text-sm uppercase tracking-[0.16em] hover:bg-stone-800 transition-colors disabled:opacity-50 cursor-pointer disabled:cursor-not-allowed"
      >
        <span data-cda-checkout-label>Confirmar pedido</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="hidden" data-cda-checkout-spinner>
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="60 30">
            <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
          </circle>
        </svg>
      </button>
      <p id="cda-cart-checkout-hint" class="text-[11px] text-stone-500 leading-relaxed mt-3 text-center">
        Iniciamos sesión con Google para evitar bots y guardar tu pedido.
      </p>
      <button
        type="button"
        id="cda-cart-clear"
        class="block w-full text-center text-xs text-stone-500 hover:text-stone-900 mt-3 underline underline-offset-4 cursor-pointer"
      >Vaciar carrito</button>
    </footer>
  </div>
</aside>

<script>
  import { getCart, removeFromCart, setQuantity, clearCart, subscribe, formatPrice, type CartItem } from "~/lib/cart";
  import { getCustomerClient, getCustomerSession, signInWithGoogle } from "~/lib/customer-auth";

  // Catch the Google OAuth callback no matter where it lands. Some
  // Supabase projects only allow the project's Site URL (e.g.
  // https://casadeasterionediciones.com/) as a redirect target, so
  // even when we ask for `redirectTo: "/checkout"` the browser comes
  // back to "/?code=...". When the cda-customer-session client
  // exchanges that code for a session and SIGNED_IN fires, redirect
  // the user to /checkout so they can finish the order.
  function wireOAuthCatcher() {
    if ((window as any).__cdaOAuthCatcher) return;
    (window as any).__cdaOAuthCatcher = true;
    try {
      const supabase = getCustomerClient();
      supabase.auth.onAuthStateChange((event, session) => {
        if (event !== "SIGNED_IN" || !session) return;
        const url = new URL(window.location.href);
        const isCallback =
          url.searchParams.has("code") ||
          url.hash.includes("access_token=") ||
          url.hash.includes("error=");
        const onCheckout = url.pathname.replace(/\/$/, "") === "/checkout";
        if (isCallback && !onCheckout) {
          // Clean the URL so the next page load doesn't try to
          // re-exchange a one-time code.
          url.searchParams.delete("code");
          url.searchParams.delete("state");
          url.hash = "";
          window.history.replaceState({}, "", url.toString());
          window.location.href = "/checkout";
        }
      });
    } catch (err) {
      // Auth client unavailable (env not configured). Don't break
      // the rest of the cart UX.
      console.error("[cart] OAuth catcher init failed:", err);
    }
  }
  wireOAuthCatcher();

  let drawer: HTMLElement | null = null;
  let panel: HTMLElement | null = null;

  function open() {
    // Re-resolve from the DOM every time. After a page navigation the
    // module-scope variables can point to detached nodes; reading
    // them fresh keeps the drawer in sync with whatever's mounted.
    drawer = document.getElementById("cda-cart-drawer");
    panel = document.getElementById("cda-cart-panel");
    if (!drawer || !panel) return;
    drawer.classList.remove("hidden");
    drawer.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    // Force a synchronous layout pass so the browser registers the
    // panel's start position (translate-x-full) before we remove it.
    // Reading offsetWidth flushes pending style mutations; without
    // this, removing the transform in the same tick skips the
    // transition AND — when the tab loses rAF priority — leaves the
    // panel parked off-screen forever (the previous rAF-based
    // implementation hit this case in throttled tabs).
    void panel.offsetWidth;
    panel.classList.remove("translate-x-full");
  }

  function close() {
    if (!drawer || !panel) return;
    panel.classList.add("translate-x-full");
    drawer.setAttribute("aria-hidden", "true");
    setTimeout(() => {
      drawer?.classList.add("hidden");
      document.body.style.overflow = "";
      window.dispatchEvent(new CustomEvent("cda:close-cart"));
    }, 200);
  }

  function escape(s: string) {
    return s.replace(/[&<>"']/g, (c) => (
      { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string
    ));
  }

  function renderItem(item: CartItem) {
    const cover = item.cover_image_url
      ? `<img src="${escape(item.cover_image_url)}" alt="" loading="lazy" class="w-16 h-20 object-cover bg-stone-100 shrink-0" />`
      : `<div class="w-16 h-20 bg-stone-100 shrink-0 flex items-center justify-center text-stone-300">
           <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16" rx="1"/><path d="M21 16l-5-5-7 7"/></svg>
         </div>`;
    const price = formatPrice(item.price_amount, item.price_currency);
    return `
      <li class="flex gap-3 p-4 sm:p-5" data-cda-item="${escape(item.slug)}">
        ${cover}
        <div class="flex-1 min-w-0 flex flex-col">
          <a href="/catalogo/${escape(item.slug)}" data-cda-close-on-click class="font-serif text-sm leading-tight hover:underline pr-2 break-words">
            ${escape(item.title)}
          </a>
          <span class="text-xs text-stone-500 mt-0.5">${escape(price)}</span>
          <div class="mt-auto flex items-center justify-between gap-2 pt-2">
            <div class="inline-flex items-center border border-stone-300">
              <button type="button" class="w-7 h-7 flex items-center justify-center hover:bg-stone-100 disabled:opacity-30 cursor-pointer" data-cda-qty-down="${escape(item.slug)}" aria-label="Restar uno">−</button>
              <span class="w-7 h-7 flex items-center justify-center text-xs font-medium tabular-nums">${item.quantity}</span>
              <button type="button" class="w-7 h-7 flex items-center justify-center hover:bg-stone-100 cursor-pointer" data-cda-qty-up="${escape(item.slug)}" aria-label="Sumar uno">+</button>
            </div>
            <button type="button" class="text-xs text-stone-500 hover:text-red-700 underline underline-offset-2 cursor-pointer" data-cda-remove="${escape(item.slug)}">Quitar</button>
          </div>
        </div>
      </li>`;
  }

  function render() {
    const items = getCart();
    const empty = document.getElementById("cda-cart-empty");
    const list = document.getElementById("cda-cart-list");
    const footer = document.getElementById("cda-cart-footer");
    const total = document.getElementById("cda-cart-total");
    if (!list || !empty || !footer || !total) return;

    if (items.length === 0) {
      empty.classList.remove("hidden");
      list.classList.add("hidden");
      footer.classList.add("hidden");
      list.innerHTML = "";
      return;
    }
    empty.classList.add("hidden");
    list.classList.remove("hidden");
    footer.classList.remove("hidden");
    list.innerHTML = items.map(renderItem).join("");

    let amount = 0;
    let currency = "COP";
    let allPriced = true;
    for (const it of items) {
      if (it.price_amount == null) allPriced = false;
      else amount += it.price_amount * it.quantity;
      if (it.price_currency) currency = it.price_currency;
    }
    total.textContent = allPriced ? formatPrice(amount, currency) : "Consultar precio";
  }

  // Click "Confirmar pedido": if there's a session, navigate to
  // /checkout (step 2). If not, kick off Google OAuth here so the
  // customer doesn't land on /checkout without auth — Google will
  // redirect back to /checkout after sign-in. The drawer button
  // shows a spinner while we figure out which path to take.
  async function handleCheckout() {
    const btn = document.getElementById("cda-cart-checkout") as HTMLButtonElement | null;
    const label = btn?.querySelector<HTMLSpanElement>("[data-cda-checkout-label]") ?? null;
    const spinner = btn?.querySelector<SVGElement>("[data-cda-checkout-spinner]") ?? null;
    if (btn) btn.disabled = true;
    spinner?.classList.remove("hidden");
    if (label) label.textContent = "Conectando…";
    try {
      const session = await getCustomerSession();
      if (session) {
        window.location.href = "/checkout";
        return;
      }
      await signInWithGoogle(`${window.location.origin}/checkout`);
      // signInWithOAuth navigates to Google; control never returns.
    } catch (err) {
      console.error("[cart] checkout error:", err);
      if (btn) btn.disabled = false;
      spinner?.classList.add("hidden");
      if (label) label.textContent = "Confirmar pedido";
      const hint = document.getElementById("cda-cart-checkout-hint");
      if (hint) {
        hint.textContent = "No pudimos iniciar sesión. Intenta de nuevo.";
        hint.classList.add("text-red-700");
      }
    }
  }

  function init() {
    drawer = document.getElementById("cda-cart-drawer");
    panel = document.getElementById("cda-cart-panel");
    if (!drawer || drawer.dataset.bound) {
      // Always re-render on init in case items changed while away.
      render();
      return;
    }
    drawer.dataset.bound = "1";

    window.addEventListener("cda:open-cart", open);

    drawer.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (
        t.id === "cda-cart-backdrop" ||
        t.closest("#cda-cart-close") ||
        t.closest("[data-cda-close-on-click]")
      ) {
        close();
        return;
      }
      const remove = t.closest<HTMLElement>("[data-cda-remove]");
      if (remove) {
        removeFromCart(remove.dataset.cdaRemove!);
        return;
      }
      const up = t.closest<HTMLElement>("[data-cda-qty-up]");
      if (up) {
        const slug = up.dataset.cdaQtyUp!;
        const it = getCart().find((i) => i.slug === slug);
        setQuantity(slug, (it?.quantity ?? 0) + 1);
        return;
      }
      const down = t.closest<HTMLElement>("[data-cda-qty-down]");
      if (down) {
        const slug = down.dataset.cdaQtyDown!;
        const it = getCart().find((i) => i.slug === slug);
        setQuantity(slug, (it?.quantity ?? 0) - 1);
        return;
      }
      if (t.id === "cda-cart-clear") {
        if (confirm("¿Vaciar el carrito?")) clearCart();
        return;
      }
      if (t.closest("#cda-cart-checkout")) {
        e.preventDefault();
        handleCheckout();
        return;
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer && drawer.getAttribute("aria-hidden") === "false") {
        close();
      }
    });

    render();
  }

  subscribe(render);
  init();
  document.addEventListener("astro:page-load", init);
</script>
