---
import { Icon } from "astro-icon/components";
import CartButton from "~/components/CartButton.astro";
import { loadSiteConfig } from "~/lib/site-config";
const config = await loadSiteConfig();
const showSubscribe = config.subscribe_enabled !== false;
const showNosotros = config.nosotros_enabled !== false;

type NavItem = {
  href: string;
  label: string;
  icon: string;
  /** Hijos que despliegan un submenú al hacer hover (desktop) o tap
   *  (mobile). El padre sigue siendo navegable: su `href` es el
   *  destino principal cuando el usuario hace click directo. */
  children?: { href: string; label: string; icon: string }[];
};

const navItems: NavItem[] = [
  { href: "/catalogo",    label: "Catálogo",      icon: "lucide:book-open" },
  { href: "/colecciones", label: "Colecciones",   icon: "lucide:library" },
  { href: "/articulos",   label: "Publicaciones", icon: "lucide:newspaper" },
  {
    href: "/autores",
    label: "Autores",
    icon: "lucide:users",
    children: [
      { href: "/autores",       label: "Autores",       icon: "lucide:users" },
      { href: "/colaboradores", label: "Colaboradores", icon: "lucide:user-plus" },
      { href: "/traductores",   label: "Traductores",   icon: "lucide:languages" },
      { href: "/prologistas",   label: "Prologistas",   icon: "lucide:quote" },
    ],
  },
  ...(showNosotros ? [{ href: "/nosotros", label: "Nosotros", icon: "lucide:building" } as NavItem] : []),
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

// Match-active helper: el padre se marca activo si la ruta actual
// arranca con su href o con el de cualquier hijo.
function isItemActive(item: NavItem): boolean {
  if (path.startsWith(item.href)) return true;
  return (item.children ?? []).some((c) => path.startsWith(c.href));
}
---

<header
  class="sticky top-0 z-30 backdrop-blur bg-[color:var(--bg)]/90 border-b border-[color:var(--border)]"
>
  <div class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-12 h-16 sm:h-20 flex items-center justify-between gap-3 sm:gap-6">
    <a
      href="/"
      class="flex items-center gap-2 sm:gap-3 font-serif tracking-[0.18em] uppercase font-medium hover:opacity-70 transition shrink-0 min-w-0"
    >
      <span class="cas-logo-swap h-9 w-9 sm:h-10 sm:w-10 md:h-12 md:w-12 shrink-0">
        <img
          src="/casadeasterion4.webp"
          alt=""
          width="48"
          height="48"
          class="cas-logo-default h-full w-full object-contain"
        />
        <img
          src="/casadeasterion5.webp"
          alt=""
          width="48"
          height="48"
          loading="lazy"
          class="cas-logo-hover h-full w-full object-contain"
        />
      </span>
      <span class="flex flex-col leading-[1.1] tracking-[0.16em] text-[11px] sm:text-xs md:text-sm text-[color:var(--fg)] font-semibold">
        <span>Casa de</span>
        <span>Asterión</span>
        <span>Ediciones</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-6 lg:gap-8">
      {navItems.map((item) => (
        item.children ? (
          /* Wrapper de dropdown: hover sobre el wrapper abre el panel
             vía CSS (.cas-nav-dropdown:hover .cas-nav-panel). El
             trigger es navegable también (focusable, sigue al href). */
          <div class="cas-nav-dropdown relative">
            <a
              href={item.href}
              aria-haspopup="true"
              class:list={[
                "nav-link inline-flex items-center gap-1.5",
                isItemActive(item) && "text-[color:var(--fg)]",
              ]}
            >
              <Icon name={item.icon} class="w-3.5 h-3.5" aria-hidden="true" />
              <span>{item.label}</span>
              <Icon name="lucide:chevron-down" class="w-3 h-3 opacity-70" aria-hidden="true" />
            </a>
            <div class="cas-nav-panel absolute left-0 top-full pt-2 min-w-[12rem] z-40">
              <ul class="cas-nav-panel-inner bg-[color:var(--bg)] border border-[color:var(--border)] shadow-lg shadow-stone-900/5 py-2">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class:list={[
                        "flex items-center gap-2.5 px-4 py-2.5 text-[0.78rem] uppercase tracking-[0.16em] transition-colors",
                        path.startsWith(child.href)
                          ? "text-[color:var(--fg)] bg-[color:var(--bg-alt)]"
                          : "text-[color:var(--fg-muted)] hover:text-[color:var(--fg)] hover:bg-[color:var(--bg-alt)]",
                      ]}
                    >
                      <Icon name={child.icon} class="w-3.5 h-3.5 shrink-0" aria-hidden="true" />
                      <span>{child.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              "nav-link inline-flex items-center gap-1.5",
              path.startsWith(item.href) && "text-[color:var(--fg)]",
            ]}
          >
            <Icon name={item.icon} class="w-3.5 h-3.5" aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        )
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      {showSubscribe && (
        <a href="/#suscribirse" class="btn-outline hidden sm:inline-block">Suscribirse</a>
      )}
      <CartButton />

      {/* Mobile hamburger */}
      <button
        type="button"
        id="mobile-nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="md:hidden w-10 h-10 -mr-2 flex items-center justify-center text-[color:var(--fg)] hover:opacity-70 transition"
      >
        <svg id="mobile-nav-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <svg id="mobile-nav-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="hidden">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="6" y1="18" x2="18" y2="6"></line>
        </svg>
      </button>
    </div>
  </div>

</header>

{/* Mobile drawer — vive FUERA del <header> porque éste tiene
    backdrop-blur, que crea un containing block para elementos fixed
    y rompía el posicionamiento full-screen del drawer. Aquí es fixed
    relativo al viewport como esperábamos. z-20 para quedar sobre el
    contenido pero debajo del header sticky (z-30) que mantiene
    visible el botón de cerrar. */}
<nav
  id="mobile-nav"
  class="md:hidden hidden fixed inset-x-0 top-16 sm:top-20 bottom-0 z-20 border-t border-[color:var(--border)] bg-[color:var(--bg)] overflow-y-auto"
>
  <ul class="px-6 sm:px-8 py-8 flex flex-col gap-1">
    {navItems.map((item) => (
      item.children ? (
        /* Acordeón mobile: el padre es un botón que expande/colapsa
           la lista de hijos. Los hijos heredan el mismo tipo de fila
           que el resto del menu, solo que con indent visual. */
        <li class="cas-mnav-group">
          <button
            type="button"
            data-mnav-toggle
            aria-expanded="false"
            class:list={[
              "w-full flex items-center gap-4 py-4 sm:py-5 uppercase text-base sm:text-lg tracking-[0.2em] font-medium border-b border-[color:var(--border)]",
              isItemActive(item)
                ? "text-[color:var(--fg)]"
                : "text-[color:var(--fg-muted)] hover:text-[color:var(--fg)]",
            ]}
          >
            <Icon name={item.icon} class="w-5 h-5 shrink-0" aria-hidden="true" />
            <span class="flex-1 text-left">{item.label}</span>
            <Icon name="lucide:chevron-down" class="cas-mnav-chevron w-4 h-4 shrink-0 transition-transform" aria-hidden="true" />
          </button>
          <ul class="cas-mnav-children hidden bg-[color:var(--bg-alt)]">
            {item.children.map((child) => (
              <li>
                <a
                  href={child.href}
                  class:list={[
                    "flex items-center gap-4 py-3.5 pl-10 sm:pl-12 pr-6 uppercase text-sm sm:text-base tracking-[0.2em] border-b border-[color:var(--border)]",
                    path.startsWith(child.href)
                      ? "text-[color:var(--fg)]"
                      : "text-[color:var(--fg-muted)] hover:text-[color:var(--fg)]",
                  ]}
                >
                  <Icon name={child.icon} class="w-4 h-4 shrink-0" aria-hidden="true" />
                  <span>{child.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ) : (
        <li>
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-4 py-4 sm:py-5 uppercase text-base sm:text-lg tracking-[0.2em] font-medium border-b border-[color:var(--border)]",
              path.startsWith(item.href)
                ? "text-[color:var(--fg)]"
                : "text-[color:var(--fg-muted)] hover:text-[color:var(--fg)]",
            ]}
          >
            <Icon name={item.icon} class="w-5 h-5 shrink-0" aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        </li>
      )
    ))}
    {showSubscribe && (
      <li class="pt-8 mt-2">
        <a href="/#suscribirse" class="btn-outline inline-block">Suscribirse</a>
      </li>
    )}
  </ul>
</nav>

<style>
  /* Dropdown desktop — hover/focus abre el panel. Padding-top en el
     panel (.pt-2) crea un "puente" sobre el cual el mouse puede
     transitar sin perder el hover. */
  .cas-nav-panel {
    opacity: 0;
    pointer-events: none;
    transition: opacity 140ms ease, transform 140ms ease;
    transform: translateY(-4px);
  }
  .cas-nav-dropdown:hover .cas-nav-panel,
  .cas-nav-dropdown:focus-within .cas-nav-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  /* Acordeón mobile: el chevron rota 180° cuando el grupo está abierto. */
  .cas-mnav-group[data-open="true"] .cas-mnav-chevron {
    transform: rotate(180deg);
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById("mobile-nav-toggle");
    const drawer = document.getElementById("mobile-nav");
    const iconOpen = document.getElementById("mobile-nav-icon-open");
    const iconClose = document.getElementById("mobile-nav-icon-close");
    if (!btn || !drawer) return;

    const set = (open) => {
      drawer.classList.toggle("hidden", !open);
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      btn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    };

    // Acordeón: cada botón [data-mnav-toggle] expande/colapsa su lista
    // .cas-mnav-children siguiente. No es exclusivo — varios grupos
    // pueden estar abiertos a la vez. Default abierto si el padre o
    // alguno de los hijos coincide con la ruta actual.
    drawer.querySelectorAll("[data-mnav-toggle]").forEach((toggle) => {
      const group = toggle.closest(".cas-mnav-group");
      const children = group?.querySelector(".cas-mnav-children");
      if (!group || !children) return;
      // Auto-expand al cargar si algún hijo está activo (el padre
      // tendrá text-[color:var(--fg)] al estar activo).
      const hasActiveChild = !!children.querySelector(
        'a[class*="var(--fg)]"]:not([class*="muted"])',
      );
      if (hasActiveChild) {
        group.setAttribute("data-open", "true");
        children.classList.remove("hidden");
        toggle.setAttribute("aria-expanded", "true");
      }
      toggle.addEventListener("click", () => {
        const isOpen = group.getAttribute("data-open") === "true";
        const next = !isOpen;
        group.setAttribute("data-open", next ? "true" : "false");
        children.classList.toggle("hidden", !next);
        toggle.setAttribute("aria-expanded", next ? "true" : "false");
      });
    });

    btn.addEventListener("click", () => {
      set(drawer.classList.contains("hidden"));
    });

    // Close drawer when navigating (the page reloads anyway, but
    // visually snap closed first)
    drawer.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => set(false))
    );

    // Auto-close if the user resizes up to desktop
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) set(false);
    });
  })();
</script>
