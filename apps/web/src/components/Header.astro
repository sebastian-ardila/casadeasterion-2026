---
const navItems = [
  { href: "/catalogo", label: "Catálogo" },
  { href: "/articulos", label: "Artículos" },
  { href: "/filosofia", label: "Filosofía" },
  { href: "/poesia", label: "Poesía" },
  { href: "/autores", label: "Autores" },
  { href: "/contacto", label: "Contacto" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="sticky top-0 z-30 backdrop-blur bg-[color:var(--bg)]/85 border-b border-[color:var(--border)]"
>
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12 h-20 flex items-center justify-between gap-8">
    <a
      href="/"
      class="flex items-center gap-3 font-serif tracking-[0.18em] uppercase text-sm font-medium hover:opacity-70 transition"
    >
      <img
        src="/casadeasterion.webp"
        alt=""
        width="48"
        height="48"
        class="h-12 w-12 object-contain"
      />
      <span>Casa de Asterión</span>
    </a>

    <nav class="hidden md:flex items-center gap-10">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "nav-link",
              path.startsWith(item.href) && "text-[color:var(--fg)]",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      {/* Theme toggle disabled for now — keeping markup so we can re-enable later */}
      <button
        type="button"
        id="theme-toggle"
        aria-label="Cambiar tema"
        class="hidden w-12 h-6 rounded-full border border-[color:var(--border)] bg-[color:var(--bg-alt)] relative cursor-pointer hover:bg-[color:var(--border)] transition"
      >
        <span
          id="theme-toggle-dot"
          class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-[color:var(--fg)] transition-transform"
        ></span>
      </button>
      <a href="/#suscribirse" class="btn-outline hidden sm:inline-block">Suscribirse</a>
    </div>
  </div>
</header>
