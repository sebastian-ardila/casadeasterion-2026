---
import { Icon } from "astro-icon/components";
import CartButton from "~/components/CartButton.astro";
import { loadSiteConfig } from "~/lib/site-config";
const config = await loadSiteConfig();
const showSubscribe = config.subscribe_enabled !== false;

const navItems = [
  { href: "/catalogo",  label: "Catálogo",  icon: "lucide:book-open" },
  { href: "/articulos", label: "Publicaciones", icon: "lucide:newspaper" },
  { href: "/autores",   label: "Autores",   icon: "lucide:users" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="sticky top-0 z-30 backdrop-blur bg-[color:var(--bg)]/90 border-b border-[color:var(--border)]"
>
  <div class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-12 h-16 sm:h-20 flex items-center justify-between gap-3 sm:gap-6">
    <a
      href="/"
      class="flex items-center gap-2 sm:gap-3 font-serif tracking-[0.18em] uppercase font-medium hover:opacity-70 transition shrink-0 min-w-0"
    >
      <img
        src="/casadeasterion.webp"
        alt=""
        width="48"
        height="48"
        class="h-9 w-9 sm:h-10 sm:w-10 md:h-12 md:w-12 object-contain shrink-0"
      />
      <span class="flex flex-col leading-[1.1] tracking-[0.16em] text-[11px] sm:text-xs md:text-sm text-[color:var(--fg)] font-semibold">
        <span>Casa de</span>
        <span>Asterión</span>
        <span>Ediciones</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-6 lg:gap-8">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "nav-link inline-flex items-center gap-1.5",
            path.startsWith(item.href) && "text-[color:var(--fg)]",
          ]}
        >
          <Icon name={item.icon} class="w-3.5 h-3.5" aria-hidden="true" />
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      {/* TEMPORARY — Hero variant switcher. Lets the team preview the
          four hero designs in production without a rebuild. Persists the
          chosen variant in localStorage; only affects "/" (the index
          page reads this key in an inline script). REMOVE this block
          and the matching <script> below once the hero design is final. */}
      <div
        id="cas-hero-switch"
        class="hidden md:flex items-center gap-0.5 px-1 py-1 border border-[color:var(--border)] text-[10px] tracking-[0.18em] uppercase"
        aria-label="Hero variant preview (temporal)"
      >
        {(["v1", "v2", "v3", "v4"] as const).map((v) => (
          <button
            type="button"
            data-cas-hero-pick={v}
            class="px-2 py-1 leading-none hover:bg-[color:var(--fg)] hover:text-[color:var(--bg)] transition-colors"
          >
            {v}
          </button>
        ))}
      </div>
      {showSubscribe && (
        <a href="/#suscribirse" class="btn-outline hidden sm:inline-block">Suscribirse</a>
      )}
      <CartButton />

      {/* Mobile hamburger */}
      <button
        type="button"
        id="mobile-nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="md:hidden w-10 h-10 -mr-2 flex items-center justify-center text-[color:var(--fg)] hover:opacity-70 transition"
      >
        <svg id="mobile-nav-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <svg id="mobile-nav-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="hidden">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="6" y1="18" x2="18" y2="6"></line>
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile drawer */}
  <nav
    id="mobile-nav"
    class="md:hidden hidden border-t border-[color:var(--border)] bg-[color:var(--bg)]"
  >
    <ul class="px-6 py-4 flex flex-col gap-1">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-3 py-3 uppercase text-sm tracking-[0.18em] font-medium",
              path.startsWith(item.href)
                ? "text-[color:var(--fg)]"
                : "text-[color:var(--fg-muted)] hover:text-[color:var(--fg)]",
            ]}
          >
            <Icon name={item.icon} class="w-4 h-4 shrink-0" aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        </li>
      ))}
      {showSubscribe && (
        <li class="pt-3 mt-2 border-t border-[color:var(--border)]">
          <a href="/#suscribirse" class="btn-outline inline-block">Suscribirse</a>
        </li>
      )}
    </ul>
  </nav>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("mobile-nav-toggle");
    const drawer = document.getElementById("mobile-nav");
    const iconOpen = document.getElementById("mobile-nav-icon-open");
    const iconClose = document.getElementById("mobile-nav-icon-close");
    if (!btn || !drawer) return;

    const set = (open) => {
      drawer.classList.toggle("hidden", !open);
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      btn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    };

    btn.addEventListener("click", () => {
      set(drawer.classList.contains("hidden"));
    });

    // Close drawer when navigating (the page reloads anyway, but
    // visually snap closed first)
    drawer.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => set(false))
    );

    // Auto-close if the user resizes up to desktop
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) set(false);
    });
  })();
</script>

{/* TEMPORARY — Hero switcher behavior. Flips the active variant on the
    home hero section in real time and persists the choice in
    localStorage so reloads keep it. Remove together with the markup
    above when the final hero is chosen. */}
<script is:inline>
  (() => {
    const sw = document.getElementById("cas-hero-switch");
    if (!sw) return;
    const KEY = "cas:hero-variant";

    const findHero = () =>
      document.querySelector(".hero-section[data-cas-hero-active]");

    const applyHighlight = (current) => {
      sw.querySelectorAll("[data-cas-hero-pick]").forEach((b) => {
        const isActive = b.getAttribute("data-cas-hero-pick") === current;
        b.classList.toggle("bg-[color:var(--fg)]", isActive);
        b.classList.toggle("text-[color:var(--bg)]", isActive);
      });
    };

    // Sync the highlight with whatever the hero section currently shows.
    const hero = findHero();
    if (hero) applyHighlight(hero.getAttribute("data-cas-hero-active"));

    sw.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const btn = target.closest("[data-cas-hero-pick]");
      if (!btn) return;
      const variant = btn.getAttribute("data-cas-hero-pick");
      if (!variant) return;
      try { localStorage.setItem(KEY, variant); } catch {}
      const sec = findHero();
      if (sec) {
        sec.setAttribute("data-cas-hero-active", variant);
        applyHighlight(variant);
      } else {
        // Not on the index page — navigate home so the new variant shows.
        location.href = "/";
      }
    });
  })();
</script>
