---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import Breadcrumb from "~/components/Breadcrumb.astro";
import { loadSiteConfig } from "~/lib/site-config";

interface Props {
  title?: string;
  description?: string;
  // When set, overrides the last breadcrumb label (useful for slug pages).
  breadcrumbLabel?: string;
}

const { title, description, breadcrumbLabel } = Astro.props;
const config = await loadSiteConfig();
const fullTitle = title ? `${title} — Casa de Asterión` : "Casa de Asterión";
const desc = description ?? config.editorial_description;
---

<!doctype html>
<html lang="es" data-theme="light" data-theme-locked="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index,follow,noai,noimageai" />
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
      crossorigin
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap"
    />
    <title>{fullTitle}</title>
    <script is:inline>
      // Dark mode disabled for now (data-theme-locked). Force light.
      document.documentElement.dataset.theme = "light";
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <Breadcrumb currentLabel={breadcrumbLabel} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
