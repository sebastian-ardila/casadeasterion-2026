---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import ContactSection from "~/components/ContactSection.astro";
import Breadcrumb from "~/components/Breadcrumb.astro";
import SeoHead from "~/components/SeoHead.astro";
import CartDrawer from "~/components/CartDrawer.astro";
import CartFloatingBubble from "~/components/CartFloatingBubble.astro";
import { loadSiteConfig } from "~/lib/site-config";

type SeoType = "website" | "article" | "book" | "person";

interface Props {
  title?: string;
  description?: string;
  // When set, overrides the last breadcrumb label (useful for slug pages).
  breadcrumbLabel?: string;
  // SEO extensions
  seoType?: SeoType;
  image?: string | null;
  imageAlt?: string | null;
  keywords?: string[] | null;
  canonical?: string | null;
  publishedAt?: string | null;
  updatedAt?: string | null;
  authorName?: string | null;
  authorUrl?: string | null;
  authors?: { name: string; url?: string | null }[] | null;
  section?: string | null;
  tags?: string[] | null;
  isbn?: string | null;
  sameAs?: string[] | null;
  breadcrumbItems?: { name: string; url: string }[] | null;
}

const {
  title,
  description,
  breadcrumbLabel,
  seoType = "website",
  image,
  imageAlt,
  keywords,
  canonical,
  publishedAt,
  updatedAt,
  authorName,
  authorUrl,
  authors,
  section,
  tags,
  isbn,
  sameAs,
  breadcrumbItems,
} = Astro.props;
const config = await loadSiteConfig();
// Empty title → SeoHead recognizes the home page and emits the
// fully-branded "Casa de Asterión Ediciones — Filosofía y Poesía".
// Any explicit title here is used as the page-specific prefix.
const fullTitle = title ?? "";
const desc = description ?? config.editorial_description;
const url = Astro.url.href;
---

<!doctype html>
<html lang="es" data-theme="light" data-theme-locked="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SeoHead
      type={seoType}
      title={fullTitle}
      description={desc}
      url={url}
      image={image}
      imageAlt={imageAlt}
      keywords={keywords}
      canonical={canonical}
      config={config}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      authorName={authorName}
      authorUrl={authorUrl}
      authors={authors}
      section={section}
      tags={tags}
      isbn={isbn}
      sameAs={sameAs}
      breadcrumb={breadcrumbItems}
    />

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
      crossorigin
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    {/* All hero-card fonts live in this single CSS request. Keep
        in sync with HERO_CARD_FONTS in hero-card.ts and the CMS
        FONT_OPTIONS list. Adding a new font means a new family=
        param here AND a new entry in those two places. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=EB+Garamond:wght@400;500;600&family=Playfair+Display:wght@400;500;600&family=Lora:wght@400;500;600&family=Libre+Baskerville:wght@400;700&family=Crimson+Pro:wght@400;500;600&family=Fraunces:wght@400;500;600&family=Spectral:wght@400;500;600&family=Inter:wght@400;500;600&family=DM+Sans:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&family=Manrope:wght@400;500;600&family=Work+Sans:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600&family=Outfit:wght@400;500;600&family=Marcellus&display=swap"
    />
    <script is:inline>
      // Dark mode disabled for now (data-theme-locked). Force light.
      document.documentElement.dataset.theme = "light";
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <Breadcrumb currentLabel={breadcrumbLabel} />
    <main class="flex-1">
      <slot />
    </main>
    <ContactSection />
    <Footer />
    <CartDrawer />
    <CartFloatingBubble />
  </body>
</html>
