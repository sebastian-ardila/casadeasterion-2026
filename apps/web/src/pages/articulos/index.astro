---
import Layout from "~/layouts/Layout.astro";
import PostCard from "~/components/PostCard.astro";
import EmptyState from "~/components/EmptyState.astro";
import { supabase } from "~/lib/supabase";

const [{ data: posts }, { data: authors }, { data: categories }] = await Promise.all([
  supabase
    .from("posts")
    .select("*")
    .eq("status", "published")
    .order("published_at", { ascending: false }),
  supabase.from("authors").select("*"),
  supabase.from("categories").select("*"),
]);

const authorMap = new Map((authors ?? []).map((a) => [a.id, a]));
const categoryMap = new Map((categories ?? []).map((c) => [c.id, c]));
---

<Layout title="Artículos" description="Todos los artículos publicados por Casa de Asterión.">
  <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pt-12 sm:pt-16 md:pt-20 pb-10 sm:pb-12">
    <h1 class="font-serif text-3xl sm:text-4xl md:text-6xl mb-3 sm:mb-4">Artículos</h1>
    <p class="text-[color:var(--fg-muted)] max-w-prose">
      Ensayos, reflexiones y notas sobre filosofía, poesía y la palabra escrita.
    </p>
  </section>

  <section class="mx-auto max-w-[900px] px-5 sm:px-6 lg:px-12 pb-16 sm:pb-20 md:pb-24">
    {posts && posts.length > 0 ? (
      <div class="space-y-10 sm:space-y-12">
        {posts.map((post) => (
          <PostCard
            post={post}
            author={authorMap.get(post.author_id ?? "")}
            category={categoryMap.get(post.category_id ?? "")}
          />
        ))}
      </div>
    ) : (
      <EmptyState
        icon="lucide:newspaper"
        title="Aún no publicamos artículos"
        description="Estamos preparando los primeros ensayos. Vuelve pronto o suscríbete para enterarte cuando lleguen."
        ctaLabel="Volver al inicio"
      />
    )}
  </section>
</Layout>
