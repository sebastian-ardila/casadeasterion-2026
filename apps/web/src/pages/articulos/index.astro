---
import Layout from "~/layouts/Layout.astro";
import PostCard from "~/components/PostCard.astro";
import { supabase } from "~/lib/supabase";

const [{ data: posts }, { data: authors }, { data: categories }] = await Promise.all([
  supabase
    .from("posts")
    .select("*")
    .eq("status", "published")
    .order("published_at", { ascending: false }),
  supabase.from("authors").select("*"),
  supabase.from("categories").select("*"),
]);

const authorMap = new Map((authors ?? []).map((a) => [a.id, a]));
const categoryMap = new Map((categories ?? []).map((c) => [c.id, c]));
---

<Layout title="Artículos" description="Todos los artículos publicados por Casa de Asterión.">
  <section class="mx-auto max-w-[1400px] px-6 lg:px-12 pt-20 pb-12">
    <h1 class="font-serif text-4xl md:text-6xl mb-4">Artículos</h1>
    <p class="text-[color:var(--fg-muted)] max-w-prose">
      Ensayos, reflexiones y notas sobre filosofía, poesía y la palabra escrita.
    </p>
  </section>

  <section class="mx-auto max-w-[900px] px-6 lg:px-12 pb-24">
    {posts && posts.length > 0 ? (
      <div class="space-y-12">
        {posts.map((post) => (
          <PostCard
            post={post}
            author={authorMap.get(post.author_id ?? "")}
            category={categoryMap.get(post.category_id ?? "")}
          />
        ))}
      </div>
    ) : (
      <p class="text-[color:var(--fg-muted)]">Aún no hay artículos publicados.</p>
    )}
  </section>
</Layout>
