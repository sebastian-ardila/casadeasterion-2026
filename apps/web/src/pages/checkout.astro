---
// Checkout flow:
//   1. If the customer has no Supabase session, show "Iniciar sesión
//      con Google" — kicks off OAuth, redirects back here on return.
//   2. With a session: show step 2 form (full_name pre-filled,
//      email pre-filled and read-only, phone, notes), plus the cart
//      summary as a confirmation panel.
//   3. Submit → POST to /functions/v1/submit-order with the JWT.
//      The function inserts a purchase_intent and returns a wa.me
//      URL. We sign out and redirect to that URL so the customer
//      finishes the conversation in WhatsApp.

import Layout from "~/layouts/Layout.astro";
---

<Layout
  title="Confirmar pedido"
  description="Confirma tus datos para enviar tu pedido a Casa de Asterión por WhatsApp."
  canonical={null}
>
  <section class="mx-auto max-w-3xl px-5 sm:px-6 lg:px-8 py-12 sm:py-16 md:py-20">
    <header class="mb-8 sm:mb-10 border-b border-[color:var(--border)] pb-5 sm:pb-7">
      <p class="uppercase text-[10px] sm:text-xs tracking-[0.22em] text-[color:var(--fg-muted)] mb-2 sm:mb-3">
        Casa de Asterión
      </p>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl leading-[1.05]">
        Confirmar pedido
      </h1>
      <p class="text-sm sm:text-base text-[color:var(--fg-muted)] max-w-prose mt-3 sm:mt-4 leading-relaxed">
        Iniciamos sesión con Google para evitar bots y guardar tus datos
        en caso de que necesites contactarnos. Después seguimos por
        WhatsApp como siempre.
      </p>
    </header>

    {/* Empty cart fallback */}
    <div id="checkout-empty" class="hidden text-center py-16">
      <p class="text-stone-500 text-sm leading-relaxed mb-6">
        No hay nada en tu carrito todavía.
      </p>
      <a href="/catalogo" class="btn-outline inline-block">Ver catálogo</a>
    </div>

    {/* Step 1: login. Hidden once the session is detected. */}
    <div id="checkout-login" class="hidden">
      <div class="border border-[color:var(--border)] bg-[color:var(--bg-alt)]/50 p-6 sm:p-8 text-center">
        <p class="font-serif text-xl sm:text-2xl mb-3 leading-tight">
          Iniciar sesión para continuar
        </p>
        <p class="text-sm text-[color:var(--fg-muted)] mb-6 max-w-prose mx-auto leading-relaxed">
          Usamos Google únicamente para verificar que eres una persona
          real y registrar tu pedido. No publicamos nada en tu nombre.
        </p>
        <button
          id="checkout-google-btn"
          type="button"
          class="inline-flex items-center gap-3 bg-white border border-stone-300 text-stone-900 px-5 py-3 hover:bg-stone-50 transition-colors disabled:opacity-50 cursor-pointer disabled:cursor-not-allowed"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#EA4335" d="M12 5c1.6 0 3.1.6 4.2 1.6l3-3C17.5 1.7 14.9.5 12 .5 7.4.5 3.4 3.1 1.4 7l3.5 2.7C5.9 6.9 8.7 5 12 5z"/>
            <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5c-.3 1.5-1.1 2.7-2.4 3.6l3.7 2.9c2.2-2 3.7-5 3.7-8.6z"/>
            <path fill="#FBBC05" d="M4.9 13.7c-.2-.7-.4-1.4-.4-2.2 0-.8.1-1.5.4-2.2L1.4 6.6C.6 8.2.2 10 .2 12s.4 3.8 1.2 5.4l3.5-2.7z"/>
            <path fill="#34A853" d="M12 23.5c3 0 5.5-1 7.4-2.7l-3.7-2.9c-1 .7-2.3 1.1-3.7 1.1-3.3 0-6.1-2.2-7.1-5.2L1.4 16.5C3.4 20.4 7.4 23.5 12 23.5z"/>
          </svg>
          <span>Continuar con Google</span>
        </button>
        <p id="checkout-login-error" class="mt-4 text-xs text-red-700 hidden"></p>
      </div>
    </div>

    {/* Step 2: customer data + summary + submit */}
    <form id="checkout-form" class="hidden space-y-8">
      <fieldset class="border border-[color:var(--border)] p-5 sm:p-6">
        <legend class="px-2 text-xs uppercase tracking-[0.16em] text-[color:var(--fg-muted)]">
          Tus datos
        </legend>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3">
          <label class="flex flex-col gap-1.5 sm:col-span-2">
            <span class="text-xs uppercase tracking-[0.14em] text-stone-500">
              Teléfono <span class="text-red-700" aria-hidden="true">*</span>
            </span>
            <div class="relative flex">
              <button
                type="button"
                id="checkout-country-btn"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-label="Cambiar país"
                data-iso="CO"
                data-code="+57"
                class="flex items-center gap-2 px-3 py-2 border border-stone-300 border-r-0 bg-stone-50 hover:bg-stone-100 text-sm cursor-pointer focus:outline-none focus:border-stone-900 focus:z-10 transition-colors"
              >
                <span data-country-flag class="text-base leading-none">🇨🇴</span>
                <span data-country-code class="text-stone-700 tabular-nums">+57</span>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-500 shrink-0" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              <input
                type="tel"
                id="checkout-phone"
                required
                autocomplete="tel-national"
                autofocus
                inputmode="tel"
                maxlength="50"
                placeholder="300 000 0000"
                class="flex-1 min-w-0 px-3 py-2 border border-stone-300 focus:border-stone-900 focus:outline-none bg-[color:var(--bg)]"
              />
              <div
                id="checkout-country-list"
                role="listbox"
                aria-label="Países"
                class="hidden absolute z-30 top-full left-0 mt-1 w-80 max-w-[calc(100vw-2.5rem)] max-h-72 border border-stone-300 bg-white shadow-lg overflow-hidden flex-col"
              >
                <div class="p-2 border-b border-stone-200 bg-stone-50/50">
                  <input
                    type="search"
                    id="checkout-country-search"
                    placeholder="Buscar país o código"
                    autocomplete="off"
                    class="w-full px-2.5 py-1.5 text-sm border border-stone-300 focus:border-stone-900 focus:outline-none bg-white"
                  />
                </div>
                <ul id="checkout-country-options" class="overflow-y-auto flex-1 text-sm"></ul>
              </div>
            </div>
          </label>
          <label class="flex flex-col gap-1.5 sm:col-span-2">
            <span class="text-xs uppercase tracking-[0.14em] text-stone-500">
              Nombre completo <span class="text-red-700" aria-hidden="true">*</span>
            </span>
            <input
              type="text"
              id="checkout-name"
              required
              autocomplete="name"
              maxlength="200"
              class="px-3 py-2 border border-stone-300 focus:border-stone-900 focus:outline-none bg-[color:var(--bg)]"
            />
          </label>
          <label class="flex flex-col gap-1.5 sm:col-span-2">
            <span class="text-xs uppercase tracking-[0.14em] text-stone-500">Email</span>
            <input
              type="email"
              id="checkout-email"
              readonly
              autocomplete="email"
              class="px-3 py-2 border border-stone-200 bg-stone-50 text-stone-600"
            />
          </label>
          <label class="flex flex-col gap-1.5 sm:col-span-2">
            <span class="text-xs uppercase tracking-[0.14em] text-stone-500">Notas <span class="text-stone-400 normal-case tracking-normal">(opcional)</span></span>
            <textarea
              id="checkout-notes"
              rows="3"
              maxlength="1000"
              placeholder="Dirección de envío, referencias, etc."
              class="px-3 py-2 border border-stone-300 focus:border-stone-900 focus:outline-none bg-[color:var(--bg)] resize-y"
            ></textarea>
          </label>
        </div>
      </fieldset>

      <div class="border border-[color:var(--border)] p-5 sm:p-6">
        <p class="text-xs uppercase tracking-[0.16em] text-[color:var(--fg-muted)] mb-3">
          Resumen
        </p>
        <ul id="checkout-summary" class="divide-y divide-[color:var(--border)]"></ul>
        <div class="flex items-baseline justify-between mt-4 pt-4 border-t border-[color:var(--border)]">
          <span class="text-xs uppercase tracking-[0.16em] text-stone-500">Total estimado</span>
          <span id="checkout-total" class="font-serif text-2xl">—</span>
        </div>
      </div>

      <p id="checkout-error" class="text-sm text-red-700 hidden"></p>

      <div class="flex flex-col sm:flex-row gap-3 sm:justify-between sm:items-center">
        <button
          type="button"
          id="checkout-signout-btn"
          class="text-xs text-stone-500 hover:text-stone-900 underline underline-offset-4 self-start cursor-pointer"
        >Cerrar sesión</button>
        <button
          type="submit"
          id="checkout-submit-btn"
          class="inline-flex items-center justify-center gap-2 bg-stone-900 text-white px-6 py-3 text-sm uppercase tracking-[0.16em] hover:bg-stone-800 transition-colors disabled:opacity-50 cursor-pointer disabled:cursor-not-allowed"
        >
          <span data-label>Enviar a WhatsApp</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="hidden" data-spinner>
            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="60 30">
              <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/>
            </circle>
          </svg>
        </button>
      </div>
    </form>
  </section>
</Layout>

<script>
  import {
    getCustomerClient,
    getCustomerSession,
    signInWithGoogle,
    signOutCustomer,
  } from "~/lib/customer-auth";
  import { getCart, formatPrice } from "~/lib/cart";

  const SUBMIT_URL = `${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/submit-order`;
  const ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T | null;
  const escape = (s: string) =>
    s.replace(/[&<>"']/g, (c) => (
      { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string
    ));

  // ─── Country picker (teléfono) ────────────────────────────────────────
  // Lista priorizada: Colombia primero (mercado principal), luego el
  // resto de hispanohablantes en orden alfabético, y al final algunos
  // destinos comunes para diáspora (USA, Canadá, Europa).
  type Country = { iso: string; name: string; code: string; flag: string };
  const COUNTRIES: Country[] = [
    { iso: "CO", name: "Colombia",            code: "+57",  flag: "🇨🇴" },
    { iso: "AR", name: "Argentina",           code: "+54",  flag: "🇦🇷" },
    { iso: "BO", name: "Bolivia",             code: "+591", flag: "🇧🇴" },
    { iso: "CL", name: "Chile",               code: "+56",  flag: "🇨🇱" },
    { iso: "CR", name: "Costa Rica",          code: "+506", flag: "🇨🇷" },
    { iso: "CU", name: "Cuba",                code: "+53",  flag: "🇨🇺" },
    { iso: "EC", name: "Ecuador",             code: "+593", flag: "🇪🇨" },
    { iso: "SV", name: "El Salvador",         code: "+503", flag: "🇸🇻" },
    { iso: "ES", name: "España",              code: "+34",  flag: "🇪🇸" },
    { iso: "GT", name: "Guatemala",           code: "+502", flag: "🇬🇹" },
    { iso: "HN", name: "Honduras",            code: "+504", flag: "🇭🇳" },
    { iso: "MX", name: "México",              code: "+52",  flag: "🇲🇽" },
    { iso: "NI", name: "Nicaragua",           code: "+505", flag: "🇳🇮" },
    { iso: "PA", name: "Panamá",              code: "+507", flag: "🇵🇦" },
    { iso: "PY", name: "Paraguay",            code: "+595", flag: "🇵🇾" },
    { iso: "PE", name: "Perú",                code: "+51",  flag: "🇵🇪" },
    { iso: "PR", name: "Puerto Rico",         code: "+1",   flag: "🇵🇷" },
    { iso: "DO", name: "República Dominicana",code: "+1",   flag: "🇩🇴" },
    { iso: "UY", name: "Uruguay",             code: "+598", flag: "🇺🇾" },
    { iso: "VE", name: "Venezuela",           code: "+58",  flag: "🇻🇪" },
    { iso: "US", name: "Estados Unidos",      code: "+1",   flag: "🇺🇸" },
    { iso: "CA", name: "Canadá",              code: "+1",   flag: "🇨🇦" },
    { iso: "BR", name: "Brasil",              code: "+55",  flag: "🇧🇷" },
    { iso: "FR", name: "Francia",             code: "+33",  flag: "🇫🇷" },
    { iso: "DE", name: "Alemania",            code: "+49",  flag: "🇩🇪" },
    { iso: "IT", name: "Italia",              code: "+39",  flag: "🇮🇹" },
    { iso: "PT", name: "Portugal",            code: "+351", flag: "🇵🇹" },
    { iso: "GB", name: "Reino Unido",         code: "+44",  flag: "🇬🇧" },
  ];

  // Mapeo de timezone → ISO. Cubre la mayoría de zonas hispanas y los
  // destinos de diáspora más comunes; si la zona no aparece, usamos CO
  // como default (es la editorial principal).
  const TZ_TO_ISO: Record<string, string> = {
    "America/Bogota": "CO",
    "America/Mexico_City": "MX", "America/Tijuana": "MX",
    "America/Cancun": "MX",      "America/Monterrey": "MX",
    "America/Argentina/Buenos_Aires": "AR",
    "America/Argentina/Cordoba": "AR",
    "America/Argentina/Mendoza": "AR",
    "America/Argentina/Salta": "AR",
    "America/Argentina/Ushuaia": "AR",
    "America/Santiago": "CL",
    "America/Lima": "PE",
    "America/Guayaquil": "EC",
    "America/Caracas": "VE",
    "America/La_Paz": "BO",
    "America/Asuncion": "PY",
    "America/Montevideo": "UY",
    "America/Costa_Rica": "CR",
    "America/Panama": "PA",
    "America/Guatemala": "GT",
    "America/Tegucigalpa": "HN",
    "America/El_Salvador": "SV",
    "America/Managua": "NI",
    "America/Santo_Domingo": "DO",
    "America/Puerto_Rico": "PR",
    "America/Havana": "CU",
    "Europe/Madrid": "ES",
    "America/New_York": "US", "America/Chicago": "US",
    "America/Denver": "US",   "America/Los_Angeles": "US",
    "America/Phoenix": "US",  "America/Anchorage": "US",
    "Pacific/Honolulu": "US",
    "America/Toronto": "CA",  "America/Vancouver": "CA",
    "America/Edmonton": "CA", "America/Winnipeg": "CA",
    "America/Halifax": "CA",
    "America/Sao_Paulo": "BR", "America/Manaus": "BR",
    "America/Recife": "BR",    "America/Fortaleza": "BR",
    "Europe/Paris": "FR",
    "Europe/Berlin": "DE",
    "Europe/Rome": "IT",
    "Europe/Lisbon": "PT",
    "Europe/London": "GB",
  };

  const COUNTRY_STORAGE_KEY = "cda:checkout-country";

  function detectCountryIso(): string {
    try {
      const stored = localStorage.getItem(COUNTRY_STORAGE_KEY);
      if (stored && COUNTRIES.some((c) => c.iso === stored)) return stored;
    } catch {}
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (tz && TZ_TO_ISO[tz]) return TZ_TO_ISO[tz];
    } catch {}
    return "CO";
  }

  function selectCountry(iso: string) {
    const c = COUNTRIES.find((x) => x.iso === iso) ?? COUNTRIES[0];
    const btn = $("checkout-country-btn");
    if (!btn) return;
    btn.setAttribute("data-iso", c.iso);
    btn.setAttribute("data-code", c.code);
    const flag = btn.querySelector("[data-country-flag]");
    const code = btn.querySelector("[data-country-code]");
    if (flag) flag.textContent = c.flag;
    if (code) code.textContent = c.code;
    try { localStorage.setItem(COUNTRY_STORAGE_KEY, c.iso); } catch {}
  }

  function renderCountryOptions(filter = "") {
    const ul = $("checkout-country-options");
    if (!ul) return;
    const q = filter.trim().toLowerCase();
    const items = q
      ? COUNTRIES.filter(
          (c) =>
            c.name.toLowerCase().includes(q) ||
            c.code.includes(q.replace(/^\+/, "")) ||
            c.iso.toLowerCase() === q,
        )
      : COUNTRIES;
    const selected = $("checkout-country-btn")?.getAttribute("data-iso") || "CO";
    ul.innerHTML = items
      .map(
        (c) => `
          <li>
            <button
              type="button"
              role="option"
              data-iso="${c.iso}"
              aria-selected="${c.iso === selected ? "true" : "false"}"
              class="w-full flex items-center gap-3 px-3 py-2 text-left hover:bg-stone-100 ${c.iso === selected ? "bg-stone-100" : ""}"
            >
              <span class="text-base leading-none">${c.flag}</span>
              <span class="flex-1 min-w-0 truncate text-stone-900">${escape(c.name)}</span>
              <span class="text-xs text-stone-500 tabular-nums shrink-0">${c.code}</span>
            </button>
          </li>`,
      )
      .join("") || `<li class="px-3 py-4 text-center text-stone-500 text-xs">Sin resultados</li>`;
  }

  function openCountryList(open: boolean) {
    const list = $("checkout-country-list");
    const btn = $("checkout-country-btn");
    if (!list || !btn) return;
    list.classList.toggle("hidden", !open);
    list.classList.toggle("flex", open);
    btn.setAttribute("aria-expanded", open ? "true" : "false");
    if (open) {
      renderCountryOptions("");
      const search = $<HTMLInputElement>("checkout-country-search");
      if (search) {
        search.value = "";
        requestAnimationFrame(() => search.focus());
      }
    }
  }

  function bindCountryPicker() {
    const btn = $("checkout-country-btn");
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = "1";
    selectCountry(detectCountryIso());
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const list = $("checkout-country-list");
      const open = list?.classList.contains("hidden");
      openCountryList(!!open);
    });
    const search = $<HTMLInputElement>("checkout-country-search");
    search?.addEventListener("input", (e) => {
      renderCountryOptions((e.target as HTMLInputElement).value);
    });
    const ul = $("checkout-country-options");
    ul?.addEventListener("click", (e) => {
      const opt = (e.target as Element).closest("[data-iso]");
      if (!opt) return;
      const iso = opt.getAttribute("data-iso") || "CO";
      selectCountry(iso);
      openCountryList(false);
      $<HTMLInputElement>("checkout-phone")?.focus();
    });
    // Cerrar al click fuera del picker
    document.addEventListener("click", (e) => {
      const t = e.target as Element | null;
      if (!t) return;
      if (t.closest("#checkout-country-list") || t.closest("#checkout-country-btn")) return;
      openCountryList(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") openCountryList(false);
    });
  }

  // Combina código de país + número local en un E.164 razonable.
  // - Si el usuario tipeó un "+" al inicio, respetamos su número entero
  //   (asumimos que ya viene con código internacional).
  // - Si no, prependemos el código del picker.
  function composePhone(): string | undefined {
    const raw = ($<HTMLInputElement>("checkout-phone")?.value ?? "").trim();
    if (!raw) return undefined;
    const cleaned = raw.replace(/[^\d+]/g, "");
    if (!cleaned) return undefined;
    if (cleaned.startsWith("+")) return cleaned;
    const code = $("checkout-country-btn")?.getAttribute("data-code") || "+57";
    return code + cleaned;
  }

  function showSection(name: "empty" | "login" | "form") {
    ["empty", "login", "form"].forEach((n) => {
      const el = $(`checkout-${n}`);
      if (el) el.classList.toggle("hidden", n !== name);
    });
  }

  function renderSummary() {
    const items = getCart();
    const list = $("checkout-summary");
    const total = $("checkout-total");
    if (!list || !total) return;
    if (items.length === 0) {
      showSection("empty");
      return;
    }
    list.innerHTML = items
      .map(
        (it) => `
          <li class="py-3 flex items-center gap-3">
            <span class="flex-1 min-w-0">
              <span class="font-serif text-sm leading-tight block">${escape(it.title)}</span>
              <span class="text-xs text-stone-500">Cantidad: ${it.quantity}</span>
            </span>
            <span class="text-sm tabular-nums shrink-0">${escape(formatPrice(it.price_amount, it.price_currency))}</span>
          </li>`,
      )
      .join("");
    let amount = 0;
    let currency = "COP";
    let allPriced = true;
    for (const it of items) {
      if (it.price_amount == null) allPriced = false;
      else amount += it.price_amount * it.quantity;
      if (it.price_currency) currency = it.price_currency;
    }
    total.textContent = allPriced ? formatPrice(amount, currency) : "Consultar precio";
  }

  function setSubmitBusy(busy: boolean, label?: string) {
    const btn = $("checkout-submit-btn") as HTMLButtonElement | null;
    if (!btn) return;
    btn.disabled = busy;
    const lbl = btn.querySelector<HTMLSpanElement>("[data-label]");
    const sp = btn.querySelector<SVGElement>("[data-spinner]");
    if (lbl && label) lbl.textContent = label;
    sp?.classList.toggle("hidden", !busy);
  }

  async function bootstrap() {
    if (getCart().length === 0) {
      showSection("empty");
      return;
    }
    renderSummary();

    let session = null;
    try {
      session = await getCustomerSession();
    } catch (err) {
      // If the auth client errors out (misconfigured env, network),
      // fall through to the login screen instead of leaving every
      // section hidden.
      console.error("[checkout] session error:", err);
    }
    if (!session) {
      showSection("login");
      return;
    }

    // Hydrate form fields with the Google identity.
    const user = session.user;
    const fullName = (user.user_metadata?.full_name as string | undefined) || "";
    const email = user.email || "";
    const nameInput = $<HTMLInputElement>("checkout-name");
    const emailInput = $<HTMLInputElement>("checkout-email");
    if (nameInput && !nameInput.value) nameInput.value = fullName;
    if (emailInput) emailInput.value = email;
    showSection("form");
    // Focus the phone field — it's the most important one and the
    // HTML autofocus attribute doesn't fire on a section that was
    // hidden when the page first loaded.
    requestAnimationFrame(() => {
      const phone = $<HTMLInputElement>("checkout-phone");
      if (phone && !phone.value) phone.focus();
    });
  }

  function bindLogin() {
    const btn = $<HTMLButtonElement>("checkout-google-btn");
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = "1";
    btn.addEventListener("click", async () => {
      btn.disabled = true;
      const err = $("checkout-login-error");
      if (err) err.classList.add("hidden");
      try {
        await signInWithGoogle(`${window.location.origin}/checkout`);
        // Browser navigates to Google, never reaches here.
      } catch (e) {
        btn.disabled = false;
        if (err) {
          err.textContent = "No se pudo iniciar sesión. Intenta de nuevo.";
          err.classList.remove("hidden");
        }
      }
    });
  }

  function bindForm() {
    const form = $<HTMLFormElement>("checkout-form");
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "1";
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const errEl = $("checkout-error");
      if (errEl) errEl.classList.add("hidden");
      setSubmitBusy(true, "Enviando…");

      const session = await getCustomerSession();
      if (!session) {
        setSubmitBusy(false, "Enviar a WhatsApp");
        showSection("login");
        return;
      }

      const items = getCart();
      if (items.length === 0) {
        setSubmitBusy(false);
        showSection("empty");
        return;
      }

      const body = {
        items: items.map((it) => ({ slug: it.slug, quantity: it.quantity })),
        customer: {
          full_name: ($<HTMLInputElement>("checkout-name")?.value ?? "").trim(),
          phone: composePhone(),
          notes: ($<HTMLTextAreaElement>("checkout-notes")?.value ?? "").trim() || undefined,
        },
      };

      try {
        const res = await fetch(SUBMIT_URL, {
          method: "POST",
          headers: {
            "content-type": "application/json",
            authorization: `Bearer ${session.access_token}`,
            apikey: ANON_KEY,
          },
          body: JSON.stringify(body),
        });
        const json = await res.json();
        if (!res.ok || !json?.url) {
          throw new Error(json?.error || `HTTP ${res.status}`);
        }
        // Clear cart, sign out (no need to leave a session lying
        // around on the public site), then jump to WhatsApp.
        try {
          localStorage.removeItem("cda-cart");
          window.dispatchEvent(new CustomEvent("cda:cart-change", { detail: [] }));
        } catch {}
        await signOutCustomer().catch(() => {});
        window.location.href = json.url;
      } catch (err) {
        setSubmitBusy(false, "Enviar a WhatsApp");
        if (errEl) {
          errEl.textContent = "No pudimos procesar el pedido. Intenta de nuevo.";
          errEl.classList.remove("hidden");
        }
        console.error("[checkout]", err);
      }
    });

    const signoutBtn = $<HTMLButtonElement>("checkout-signout-btn");
    if (signoutBtn && !signoutBtn.dataset.bound) {
      signoutBtn.dataset.bound = "1";
      signoutBtn.addEventListener("click", async () => {
        await signOutCustomer().catch(() => {});
        bootstrap();
      });
    }
  }

  bindLogin();
  bindForm();
  bindCountryPicker();
  bootstrap();
  document.addEventListener("astro:page-load", () => {
    bindLogin();
    bindForm();
    bindCountryPicker();
    bootstrap();
  });
</script>
