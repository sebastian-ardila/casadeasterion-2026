---
import Layout from "~/layouts/Layout.astro";
import BookCard from "~/components/BookCard.astro";
import { supabase } from "~/lib/supabase";
import { loadSiteConfig } from "~/lib/site-config";

const config = await loadSiteConfig();

const [{ data: books }, { data: authors }] = await Promise.all([
  supabase
    .from("books")
    .select("*")
    .eq("status", "published")
    .order("published_at", { ascending: false }),
  supabase.from("authors").select("*"),
]);

const authorMap = new Map((authors ?? []).map((a) => [a.id, a]));
---

<Layout title="Catálogo" description="Todos los libros publicados por Casa de Asterión.">
  <section class="mx-auto max-w-[1400px] px-6 lg:px-12 pt-20 pb-12">
    <h1 class="font-serif text-4xl md:text-6xl mb-4">Catálogo</h1>
    <p class="text-[color:var(--fg-muted)] max-w-prose">
      La biblioteca completa. Cada compra se gestiona por WhatsApp.
    </p>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 lg:px-12 pb-24">
    {books && books.length > 0 ? (
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {books.map((book) => (
          <BookCard
            book={book}
            author={authorMap.get(book.author_id ?? "")}
            config={config}
          />
        ))}
      </div>
    ) : (
      <p class="text-[color:var(--fg-muted)]">Aún no hay libros publicados.</p>
    )}
  </section>
</Layout>
