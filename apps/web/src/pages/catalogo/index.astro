---
import Layout from "~/layouts/Layout.astro";
import BookCard from "~/components/BookCard.astro";
import EmptyState from "~/components/EmptyState.astro";
import { Icon } from "astro-icon/components";
import { supabase } from "~/lib/supabase";
import { loadSiteConfig } from "~/lib/site-config";

const config = await loadSiteConfig();

const [{ data: books }, { data: authors }, { data: categories }] = await Promise.all([
  supabase
    .from("books")
    .select("*")
    .eq("status", "published")
    .order("publication_date", { ascending: false }),
  supabase.from("authors").select("*"),
  supabase.from("categories").select("*").order("sort_order").order("name"),
]);

const authorMap = new Map((authors ?? []).map((a) => [a.id, a]));
const categoryMap = new Map((categories ?? []).map((c) => [c.id, c]));
const totalBooks = books?.length ?? 0;

const usedCategoryIds = new Set(
  (books ?? []).map((b) => b.category_id).filter(Boolean) as string[],
);
const filterCategories = (categories ?? []).filter((c) => usedCategoryIds.has(c.id));

const sortOptions = [
  { value: "recent",     label: "Más recientes" },
  { value: "oldest",     label: "Más antiguos" },
  { value: "title-az",   label: "Título A–Z" },
  { value: "title-za",   label: "Título Z–A" },
  { value: "price-asc",  label: "Precio: menor a mayor" },
  { value: "price-desc", label: "Precio: mayor a menor" },
];
const defaultSort = sortOptions[0];
---

<Layout
  title="Catálogo"
  description="Catálogo completo de Casa de Asterión Ediciones — editorial independiente con sede en Pereira, Risaralda: libros de filosofía y poesía contemporáneas para todo el Eje Cafetero y Colombia. Filtra por categoría, busca por autor o título."
  keywords={[
    "catálogo Casa de Asterión",
    "libros filosofía",
    "libros poesía",
    "editorial independiente",
    "Casa de Asterión Ediciones",
    "filosofía contemporánea",
    "poesía contemporánea",
    "libros Pereira",
    "libros Risaralda",
    "libros Eje Cafetero",
    "libros de filosofía Pereira",
    "libros de poesía Pereira",
    "comprar libros Pereira",
    "editorial Pereira catálogo",
  ]}
>
  <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pt-10 sm:pt-14 md:pt-20 pb-6 sm:pb-10">
    <div class="flex items-end justify-between gap-4 border-b border-[color:var(--border)] pb-5 sm:pb-7">
      <div class="min-w-0">
        <p class="uppercase text-[10px] sm:text-xs tracking-[0.22em] text-[color:var(--fg-muted)] mb-2 sm:mb-3">
          Casa de Asterión
        </p>
        <h1 class="font-serif text-3xl sm:text-4xl md:text-6xl leading-[1.05]">
          Catálogo
        </h1>
      </div>
      {totalBooks > 0 && (
        <p
          id="catalogo-count"
          class="hidden sm:block uppercase text-xs tracking-[0.22em] text-[color:var(--fg-muted)] shrink-0 pb-1"
          data-total={totalBooks}
        >
          {totalBooks} {totalBooks === 1 ? "título" : "títulos"}
        </p>
      )}
    </div>
    <p class="text-sm sm:text-base text-[color:var(--fg-muted)] max-w-prose mt-4 sm:mt-6 leading-relaxed">
      La biblioteca completa. Cada compra se gestiona por WhatsApp.
    </p>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pb-16 sm:pb-20 md:pb-24">
    {totalBooks > 0 ? (
      <>
        <div class="mb-8 sm:mb-10 space-y-4">
          <label for="catalogo-search" class="sr-only">Buscar en el catálogo</label>
          <div class="relative">
            <svg
              class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400"
              width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <input
              id="catalogo-search"
              type="search"
              placeholder="Buscar por título, autor o categoría…"
              class="w-full pl-10 pr-3 py-3 border border-[color:var(--border)] bg-[color:var(--bg)] text-sm focus:outline-none focus:border-stone-900 transition-colors"
              autocomplete="off"
            />
          </div>

          {/* Refinement row: filter chips on the left, sort dropdown
              on the right. Chips wrap onto multiple lines if needed;
              the sort stays anchored at the end with shrink-0. */}
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
            <div class="flex flex-wrap gap-2 min-w-0" data-cda-filter-bar>
              {filterCategories.length > 0 && (
                <>
                  <button
                    type="button"
                    data-cda-filter="all"
                    class="cda-filter-chip cda-filter-active inline-flex items-center gap-1.5 text-[11px] uppercase tracking-[0.14em] px-3 py-1.5 border cursor-pointer transition-colors border-stone-900 bg-stone-900 text-white"
                  >
                    Todos
                  </button>
                  {filterCategories.map((c) => (
                    <button
                      type="button"
                      data-cda-filter={c.slug}
                      class="cda-filter-chip inline-flex items-center gap-1.5 text-[11px] uppercase tracking-[0.14em] px-3 py-1.5 border cursor-pointer transition-colors border-stone-300 text-stone-700 hover:border-stone-900 hover:text-stone-900"
                    >
                      {c.icon && (
                        <Icon name={`lucide:${c.icon}`} class="w-3.5 h-3.5" aria-hidden="true" />
                      )}
                      <span>{c.name}</span>
                    </button>
                  ))}
                </>
              )}
            </div>

            <div class="cda-sort relative shrink-0" data-cda-sort>
              <button
                type="button"
                data-cda-sort-btn
                aria-haspopup="listbox"
                aria-expanded="false"
                class="cda-sort-btn inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.14em] px-3 py-1.5 border border-stone-300 bg-white text-stone-700 hover:border-stone-900 hover:text-stone-900 cursor-pointer transition-colors"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 7h13" />
                  <path d="M3 12h9" />
                  <path d="M3 17h5" />
                  <path d="M17 4v16" />
                  <path d="m13 16 4 4 4-4" />
                </svg>
                <span class="text-stone-500 normal-case tracking-normal text-xs">Ordenar:</span>
                <span data-cda-sort-current class="normal-case tracking-normal text-xs font-medium text-stone-900">{defaultSort.label}</span>
                <svg class="cda-sort-caret transition-transform" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <ul
                role="listbox"
                aria-label="Ordenar resultados"
                data-cda-sort-menu
                hidden
                class="cda-sort-menu absolute right-0 top-full mt-1 z-20 min-w-[15rem] bg-white border border-stone-300 shadow-lg py-1"
              >
                {sortOptions.map((o) => (
                  <li>
                    <button
                      type="button"
                      role="option"
                      data-cda-sort-value={o.value}
                      data-active={o.value === defaultSort.value ? "1" : "0"}
                      aria-selected={o.value === defaultSort.value ? "true" : "false"}
                      class="cda-sort-option w-full text-left text-sm px-3 py-2 cursor-pointer flex items-center gap-2 hover:bg-stone-50 transition-colors"
                    >
                      <span class="cda-sort-check inline-flex items-center justify-center w-4 h-4 shrink-0 text-stone-900">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M5 12l5 5L20 7" />
                        </svg>
                      </span>
                      <span>{o.label}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <p
            id="catalogo-empty"
            class="hidden text-sm text-stone-500"
          >Ningún libro coincide con la búsqueda.</p>
        </div>
        <div
          id="catalogo-grid"
          class="grid gap-x-5 gap-y-10 sm:gap-x-8 sm:gap-y-14 md:gap-x-10 md:gap-y-16 grid-cols-2 lg:grid-cols-4"
        >
          {books.map((book) => {
            const author = authorMap.get(book.author_id ?? "");
            const category = categoryMap.get(book.category_id ?? "");
            const haystack = [
              book.title,
              author?.name,
              book.subtitle,
              book.isbn,
              category?.name,
              ...(book.tags ?? []),
            ]
              .filter(Boolean)
              .join(" ")
              .toLowerCase();
            const pubMs = book.publication_date
              ? new Date(book.publication_date).getTime()
              : book.published_at
                ? new Date(book.published_at).getTime()
                : 0;
            return (
              <div
                data-cda-book
                data-search={haystack}
                data-category={category?.slug ?? ""}
                data-title={(book.title ?? "").toLowerCase()}
                data-pub={Number.isFinite(pubMs) ? pubMs : 0}
                data-price={book.price_amount != null ? String(book.price_amount) : ""}
              >
                <BookCard book={book} author={author} config={config} />
              </div>
            );
          })}
        </div>
      </>
    ) : (
      <EmptyState
        icon="lucide:book-open"
        title="El catálogo se está armando"
        description="Pronto encontrarás aquí los libros que publica la editorial. Mientras tanto, puedes explorar nuestras publicaciones o conocer a los autores."
        ctaLabel="Volver al inicio"
      />
    )}
  </section>
</Layout>

<style>
  .cda-filter-chip.cda-filter-active {
    background: #1c1917;
    color: #fafaf9;
    border-color: #1c1917;
  }
  .cda-sort-btn[aria-expanded="true"] {
    border-color: #1c1917;
    color: #1c1917;
  }
  .cda-sort-btn[aria-expanded="true"] .cda-sort-caret {
    transform: rotate(180deg);
  }
  /* Check icon: visible only on the active option. */
  .cda-sort-option .cda-sort-check {
    opacity: 0;
  }
  .cda-sort-option[data-active="1"] .cda-sort-check {
    opacity: 1;
  }
  .cda-sort-option[data-active="1"] {
    background: #fafaf9;
    font-weight: 500;
    color: #1c1917;
  }
</style>

<script is:inline>
  (() => {
    const input = document.getElementById("catalogo-search");
    const grid = document.getElementById("catalogo-grid");
    const empty = document.getElementById("catalogo-empty");
    const countEl = document.getElementById("catalogo-count");
    const bar = document.querySelector("[data-cda-filter-bar]");
    const sortRoot = document.querySelector("[data-cda-sort]");
    const sortBtn = sortRoot?.querySelector("[data-cda-sort-btn]");
    const sortMenu = sortRoot?.querySelector("[data-cda-sort-menu]");
    const sortCurrent = sortRoot?.querySelector("[data-cda-sort-current]");
    if (!input || !grid) return;

    const norm = (s) =>
      String(s ?? "").toLowerCase().normalize("NFD").replace(/\p{Diacritic}/gu, "");
    const cards = Array.from(grid.querySelectorAll("[data-cda-book]"));
    const haystacks = cards.map((c) => norm(c.getAttribute("data-search") || ""));
    const categories = cards.map((c) => c.getAttribute("data-category") || "");

    let activeCategory = "all";
    let activeSort = "recent";

    const numAttr = (card, name) => {
      const v = card.getAttribute(name);
      if (v === null || v === "") return null;
      const n = Number(v);
      return Number.isFinite(n) ? n : null;
    };
    const compareNumber = (a, b, dir) => {
      const av = numAttr(a, "data-price");
      const bv = numAttr(b, "data-price");
      if (av == null && bv == null) return 0;
      if (av == null) return 1;
      if (bv == null) return -1;
      return dir === "asc" ? av - bv : bv - av;
    };
    const comparators = {
      recent: (a, b) => (Number(b.getAttribute("data-pub") || 0)) - (Number(a.getAttribute("data-pub") || 0)),
      oldest: (a, b) => (Number(a.getAttribute("data-pub") || 0)) - (Number(b.getAttribute("data-pub") || 0)),
      "title-az": (a, b) => (a.getAttribute("data-title") || "").localeCompare(b.getAttribute("data-title") || "", "es"),
      "title-za": (a, b) => (b.getAttribute("data-title") || "").localeCompare(a.getAttribute("data-title") || "", "es"),
      "price-asc": (a, b) => compareNumber(a, b, "asc"),
      "price-desc": (a, b) => compareNumber(a, b, "desc"),
    };

    const sortCards = () => {
      const cmp = comparators[activeSort] || comparators.recent;
      const sorted = cards.slice().sort(cmp);
      const frag = document.createDocumentFragment();
      sorted.forEach((c) => frag.appendChild(c));
      grid.appendChild(frag);
    };

    const filter = () => {
      const q = norm(input.value.trim());
      let visible = 0;
      cards.forEach((card, i) => {
        const matchQ = !q || haystacks[i].includes(q);
        const matchCat = activeCategory === "all" || categories[i] === activeCategory;
        const match = matchQ && matchCat;
        card.style.display = match ? "" : "none";
        if (match) visible++;
      });
      if (empty) empty.classList.toggle("hidden", visible !== 0);
      if (countEl) {
        const total = Number(countEl.getAttribute("data-total") || cards.length);
        const word = visible === 1 ? "título" : "títulos";
        if (q || activeCategory !== "all") {
          countEl.textContent = `${visible} de ${total} ${word}`;
        } else {
          countEl.textContent = `${total} ${word}`;
        }
      }
    };

    const writeUrl = () => {
      const url = new URL(window.location.href);
      if (activeCategory === "all") url.searchParams.delete("categoria");
      else url.searchParams.set("categoria", activeCategory);
      if (activeSort === "recent") url.searchParams.delete("orden");
      else url.searchParams.set("orden", activeSort);
      window.history.replaceState({}, "", url.toString());
    };

    const setCategory = (slug, pushUrl) => {
      activeCategory = slug || "all";
      if (bar) {
        bar.querySelectorAll("[data-cda-filter]").forEach((b) => {
          const on = b.getAttribute("data-cda-filter") === activeCategory;
          b.classList.toggle("cda-filter-active", on);
          b.classList.toggle("border-stone-900", on);
          b.classList.toggle("bg-stone-900", on);
          b.classList.toggle("text-white", on);
          b.classList.toggle("border-stone-300", !on);
          b.classList.toggle("text-stone-700", !on);
        });
      }
      if (pushUrl) writeUrl();
      filter();
    };

    const closeSortMenu = () => {
      if (!sortBtn || !sortMenu) return;
      sortBtn.setAttribute("aria-expanded", "false");
      sortMenu.hidden = true;
    };
    const openSortMenu = () => {
      if (!sortBtn || !sortMenu) return;
      sortBtn.setAttribute("aria-expanded", "true");
      sortMenu.hidden = false;
    };

    const setSort = (value, pushUrl) => {
      if (!comparators[value]) value = "recent";
      activeSort = value;
      // Update menu state + button label.
      if (sortMenu) {
        let labelText = "";
        sortMenu.querySelectorAll("[data-cda-sort-value]").forEach((b) => {
          const on = b.getAttribute("data-cda-sort-value") === value;
          b.setAttribute("data-active", on ? "1" : "0");
          b.setAttribute("aria-selected", on ? "true" : "false");
          if (on) {
            const span = b.querySelector("span:last-child");
            labelText = span?.textContent || "";
          }
        });
        if (sortCurrent && labelText) sortCurrent.textContent = labelText;
      }
      sortCards();
      if (pushUrl) writeUrl();
      filter();
    };

    bar?.addEventListener("click", (e) => {
      const t = e.target instanceof Element ? e.target.closest("[data-cda-filter]") : null;
      if (!t) return;
      setCategory(t.getAttribute("data-cda-filter"), true);
    });

    sortBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = sortBtn.getAttribute("aria-expanded") === "true";
      if (open) closeSortMenu();
      else openSortMenu();
    });
    sortMenu?.addEventListener("click", (e) => {
      const t = e.target instanceof Element ? e.target.closest("[data-cda-sort-value]") : null;
      if (!t) return;
      setSort(t.getAttribute("data-cda-sort-value"), true);
      closeSortMenu();
    });
    document.addEventListener("click", (e) => {
      if (!sortRoot) return;
      if (e.target instanceof Node && sortRoot.contains(e.target)) return;
      closeSortMenu();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeSortMenu();
    });

    input.addEventListener("input", filter);

    // Init from URL.
    const params = new URL(window.location.href).searchParams;
    const fromCat = params.get("categoria");
    const fromSort = params.get("orden");
    if (fromCat) setCategory(fromCat, false);
    if (fromSort) setSort(fromSort, false);
    else filter();
  })();
</script>
