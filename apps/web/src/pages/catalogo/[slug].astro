---
import Layout from "~/layouts/Layout.astro";
import BookCard from "~/components/BookCard.astro";
import AddToCartButton from "~/components/AddToCartButton.astro";
import { supabase, type Author } from "~/lib/supabase";
import { loadSiteConfig } from "~/lib/site-config";
import { renderMarkdown, mdToPlainText, clampText } from "~/lib/markdown";
import { extractAuthors, joinAuthorNames } from "~/lib/multi-author";
import { resolveFont } from "~/lib/hero-card";

export async function getStaticPaths() {
  const { data } = await supabase
    .from("books")
    .select("slug")
    .eq("status", "published");
  return (data ?? []).map((b) => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const config = await loadSiteConfig();

// Fetch book + every author via the book_authors junction in a single
// round-trip. The junction guarantees order via sort_order.
const { data: bookRaw } = await supabase
  .from("books")
  .select("*, book_authors(sort_order, author:authors(*))")
  .eq("slug", slug!)
  .eq("status", "published")
  .maybeSingle();

if (!bookRaw) {
  return Astro.redirect("/catalogo");
}

const { book_authors: rawJunction, ...book } = bookRaw as typeof bookRaw & {
  book_authors: { sort_order: number; author: Author | null }[];
};
const authors = extractAuthors(rawJunction);
const primaryAuthor = authors[0] ?? null;

// "More from these authors" rail: books co-written by any of this book's
// authors, ranked by recency. Fetched via the junction so a book counts
// even if this author isn't the primary one on it.
const authorIds = authors.map((a) => a.id);
let otherBooks: Awaited<ReturnType<typeof supabase.from<"books">["select"]>>["data"] = [];
let authorBookTotal = 0;
if (authorIds.length > 0) {
  const { data: junctionRows } = await supabase
    .from("book_authors")
    .select("book_id")
    .in("author_id", authorIds);
  const otherBookIds = Array.from(
    new Set((junctionRows ?? []).map((r) => r.book_id).filter((id) => id !== book.id)),
  );
  if (otherBookIds.length > 0) {
    const { data: otherBooksRaw, count } = await supabase
      .from("books")
      .select("*", { count: "exact" })
      .eq("status", "published")
      .in("id", otherBookIds)
      .order("publication_date", { ascending: false })
      .limit(4);
    otherBooks = otherBooksRaw ?? [];
    authorBookTotal = count ?? 0;
  }
}

const description = renderMarkdown(book.description_md);
const authorListLabel = joinAuthorNames(authors.map((a) => a.name));

// Site-wide typography for the book detail page. Editors choose this
// in /site?page=catalogo in the CMS; here we just turn the saved key
// into a usable CSS font-family stack. Affects every book.
const bookTypo = config.book_detail_typography ?? { title_font: "serif", body_font: "serif" };
const bookTitleFont = resolveFont(bookTypo.title_font);
const bookBodyFont = resolveFont(bookTypo.body_font);

// Meta description: prefer subtitle, fall back to a cleaned excerpt
// of the description (markdown stripped, ~155 chars at word boundary).
const metaDescription =
  book.subtitle?.trim() ||
  clampText(mdToPlainText(book.description_md), 155) ||
  `${book.title}${authorListLabel ? " — " + authorListLabel : ""}. Casa de Asterión Ediciones — Filosofía y Poesía.`;

const formattedPrice =
  book.price_amount != null
    ? new Intl.NumberFormat("es-CO", {
        style: "currency",
        currency: book.price_currency,
        maximumFractionDigits: 0,
      }).format(Number(book.price_amount))
    : null;

const techRows: { label: string; value: string }[] = [];
if (book.isbn) techRows.push({ label: "ISBN", value: book.isbn });
if (book.pages) techRows.push({ label: "Páginas", value: String(book.pages) });
if (book.format) techRows.push({ label: "Formato", value: book.format });
if (book.publication_date)
  techRows.push({ label: "Publicación", value: String(new Date(book.publication_date).getFullYear()) });
if (formattedPrice) techRows.push({ label: "Precio", value: formattedPrice });
---

<Layout
  title={book.title}
  description={metaDescription}
  breadcrumbLabel={book.title}
  seoType="book"
  image={book.cover_image_url}
  imageAlt={book.cover_image_alt ?? `Portada de ${book.title}`}
  keywords={book.keywords}
  canonical={book.canonical_url}
  isbn={book.isbn}
  authors={authors.map((a) => ({
    name: a.name,
    url: new URL(`/autores/${a.slug}`, Astro.site).href,
  }))}
  publishedAt={book.publication_date}
  breadcrumbItems={[
    { name: "Inicio", url: new URL("/", Astro.site).href },
    { name: "Catálogo", url: new URL("/catalogo", Astro.site).href },
    { name: book.title, url: Astro.url.href },
  ]}
>
  <article class="mx-auto max-w-[1100px] px-5 sm:px-6 lg:px-12 pt-6 sm:pt-10 md:pt-16 pb-12 sm:pb-16 md:pb-20 grid grid-cols-1 lg:grid-cols-[minmax(0,320px)_1fr] gap-7 sm:gap-9 lg:gap-14">
    {/* Left rail: cover + author card + tech info. On mobile this stacks
        before the description; tech info is reordered to the bottom. */}
    <aside class="lg:sticky lg:top-24 self-start space-y-5 sm:space-y-6 lg:space-y-7">
      <div class="max-w-[220px] sm:max-w-[260px] lg:max-w-none mx-auto lg:mx-0 w-full">
        {book.cover_image_url ? (
          <img
            src={book.cover_image_url}
            alt={`Portada de ${book.title}`}
            class="w-full aspect-[3/4] object-cover bg-[color:var(--bg-alt)] shadow-md shadow-stone-900/10 ring-1 ring-stone-900/[0.04]"
          />
        ) : (
          <div class="aspect-[3/4] bg-[color:var(--bg-alt)]"></div>
        )}
      </div>

      {/* Author cards — one per author in the junction. The eyebrow
          singularizes/pluralizes; only the first card gets the eyebrow
          to keep the visual rhythm tight when there are several. */}
      {authors.length > 0 && (
        <div class="space-y-3 sm:space-y-4 max-w-[320px] mx-auto lg:mx-0 w-full">
          <p class="uppercase text-[10px] tracking-[0.18em] text-[color:var(--fg-muted)] mb-0.5">
            {authors.length > 1 ? "Autores" : "Autor"}
          </p>
          {authors.map((a) => (
            <a
              href={`/autores/${a.slug}`}
              class="group flex items-center gap-3 sm:gap-4 hover:opacity-85 transition-opacity"
            >
              <div class="w-12 h-12 sm:w-14 sm:h-14 lg:w-16 lg:h-16 shrink-0 overflow-hidden bg-[color:var(--bg-alt)] ring-1 ring-stone-900/[0.06]">
                {a.photo_url ? (
                  <img
                    src={a.photo_url}
                    alt={a.name}
                    loading="lazy"
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-[color:var(--fg-muted)] font-serif text-xl">
                    {a.name.charAt(0)}
                  </div>
                )}
              </div>
              <div class="min-w-0">
                <p class="font-serif text-base sm:text-lg leading-tight group-hover:underline underline-offset-4 decoration-[color:var(--fg-muted)] truncate">
                  {a.name}
                </p>
              </div>
            </a>
          ))}
        </div>
      )}

      {/* Technical info — single column, sits under cover on desktop. */}
      {techRows.length > 0 && (
        <dl class="hidden lg:grid border-t border-[color:var(--border)] pt-5 text-sm grid-cols-[max-content_1fr] gap-x-4 gap-y-2">
          {techRows.map(({ label, value }) => (
            <>
              <dt class="text-[color:var(--fg-muted)] uppercase tracking-[0.12em] text-[11px] self-baseline">
                {label}
              </dt>
              <dd class:list={["min-w-0 break-words", label === "Precio" && "font-medium"]}>
                {label === "Formato" ? <span class="capitalize">{value}</span> : value}
              </dd>
            </>
          ))}
        </dl>
      )}
    </aside>

    {/* Right column: title, subtitle, description, CTA. The font-family
        overrides cascade into the .cas-md children too — see the inline
        <style> block at the bottom of this page. */}
    <div class="min-w-0">
      <h1 class="cas-book-title font-serif text-2xl sm:text-3xl md:text-5xl leading-[1.1] mb-2 sm:mb-3">{book.title}</h1>
      {book.subtitle && (
        <p class="text-sm sm:text-base md:text-xl text-[color:var(--fg-muted)] italic mb-5 sm:mb-7 md:mb-8">{book.subtitle}</p>
      )}

      <div class="cas-book-description cas-md cas-md--book max-w-none mb-7 sm:mb-9 md:mb-10" set:html={description}></div>

      {/* Mobile-only tech info: appears under the description before the CTA. */}
      {techRows.length > 0 && (
        <dl class="lg:hidden border-t border-[color:var(--border)] pt-5 mb-7 sm:mb-8 text-sm grid grid-cols-[max-content_1fr] gap-x-5 sm:gap-x-7 gap-y-2.5">
          {techRows.map(({ label, value }) => (
            <>
              <dt class="text-[color:var(--fg-muted)] uppercase tracking-[0.12em] text-[11px] self-baseline">
                {label}
              </dt>
              <dd class:list={["min-w-0 break-words", label === "Precio" && "font-medium"]}>
                {label === "Formato" ? <span class="capitalize">{value}</span> : value}
              </dd>
            </>
          ))}
        </dl>
      )}

      <AddToCartButton
        slug={book.slug}
        title={book.title}
        coverImageUrl={book.cover_image_url}
        priceAmount={book.price_amount}
        priceCurrency={book.price_currency}
        variant="primary"
        className="w-full sm:w-auto justify-center"
      />
    </div>
  </article>

  {/* Otros libros: cualquier libro escrito por al menos uno de los
      autores de éste. Cuando hay un solo autor, el "Ver todos" lleva a
      su ficha; con varios omitimos el link porque no apunta a una sola
      página. */}
  {primaryAuthor && otherBooks.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pb-16 sm:pb-20 md:pb-24">
      <div class="flex items-end justify-between gap-4 mb-8 sm:mb-10 md:mb-12 border-b border-[color:var(--border)] pb-6 sm:pb-7 md:pb-8">
        <div class="min-w-0">
          <p class="uppercase text-[10px] sm:text-xs tracking-[0.2em] text-[color:var(--fg-muted)] mb-1.5 sm:mb-2">
            {authors.length > 1 ? "Más de estos autores" : "Más del autor"}
          </p>
          <h2 class="font-serif text-xl sm:text-2xl md:text-3xl leading-tight">
            {authors.length > 1
              ? `Otros libros de ${authorListLabel}`
              : `Otros libros de ${primaryAuthor.name}`}
          </h2>
        </div>
        {authors.length === 1 && authorBookTotal > otherBooks.length + 1 && (
          <a href={`/autores/${primaryAuthor.slug}`} class="nav-link shrink-0 pb-1">Ver todos</a>
        )}
      </div>
      <div class="grid gap-x-5 gap-y-10 sm:gap-x-8 sm:gap-y-14 md:gap-x-10 md:gap-y-16 grid-cols-2 lg:grid-cols-4">
        {otherBooks.map((b) => (
          <BookCard book={b} author={primaryAuthor} config={config} />
        ))}
      </div>
    </section>
  )}

  {/* Site-wide typography (read from site_configuration). The body
      font cascades into the markdown children — paragraphs, lists,
      blockquotes — overriding the .cas-md defaults. The title font is
      applied to the h1 only. */}
  <style is:inline set:html={`
    .cas-book-title { font-family: ${bookTitleFont}; }
    .cas-book-description,
    .cas-book-description p,
    .cas-book-description li,
    .cas-book-description blockquote,
    .cas-book-description h2,
    .cas-book-description h3,
    .cas-book-description h4 { font-family: ${bookBodyFont}; }
  `}></style>
</Layout>
