---
import Layout from "~/layouts/Layout.astro";
import BookCard from "~/components/BookCard.astro";
import AddToCartButton from "~/components/AddToCartButton.astro";
import { supabase, type Author } from "~/lib/supabase";
import { loadSiteConfig } from "~/lib/site-config";
import { renderMarkdown, mdToPlainText, clampText } from "~/lib/markdown";
import { extractAuthors, joinAuthorNames } from "~/lib/multi-author";
import { resolveFont } from "~/lib/hero-card";

export async function getStaticPaths() {
  const { data } = await supabase
    .from("books")
    .select("slug")
    .eq("status", "published");
  return (data ?? []).map((b) => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const config = await loadSiteConfig();

// Fetch book + every author via the book_authors junction in a single
// round-trip. The junction guarantees order via sort_order.
const { data: bookRaw } = await supabase
  .from("books")
  .select("*, book_authors(sort_order, author:authors(*))")
  .eq("slug", slug!)
  .eq("status", "published")
  .maybeSingle();

if (!bookRaw) {
  return Astro.redirect("/catalogo");
}

const { book_authors: rawJunction, ...book } = bookRaw as typeof bookRaw & {
  book_authors: { sort_order: number; author: Author | null }[];
};
const authors = extractAuthors(rawJunction);
const primaryAuthor = authors[0] ?? null;

// Personas vinculadas en otros roles. Las 3 junctions nuevas
// (translators, prologuists, collaborators) referencian `authors`
// por author_id. Cargamos en paralelo. Si no hay rows, no
// renderizamos el bloque.
type RoleLink = { sort_order: number; author: Author | null };
const [transRaw, prologRaw, collabRaw] = await Promise.all([
  supabase.from("book_translators").select("sort_order, author:authors(*)").eq("book_id", book.id).order("sort_order"),
  supabase.from("book_prologuists").select("sort_order, author:authors(*)").eq("book_id", book.id).order("sort_order"),
  supabase.from("book_collaborators").select("sort_order, author:authors(*)").eq("book_id", book.id).order("sort_order"),
]);
const pluckAuthors = (rows: { data: any[] | null }): Author[] =>
  (rows.data ?? [])
    .map((r) => r.author)
    .filter(Boolean) as Author[];
const translators  = pluckAuthors(transRaw);
const prologuists  = pluckAuthors(prologRaw);
const collaborators = pluckAuthors(collabRaw);

// Si el libro pertenece a una colección publicada, traemos su slug,
// nombre, descripción y los otros libros publicados que la integran.
// Cast porque collection_id es la columna nueva.
type ParentCollection = {
  slug: string;
  name: string;
  description_md: string | null;
  cover_image_url: string | null;
};
const collectionId = (book as any).collection_id as string | null;
let parentCollection: ParentCollection | null = null;
let collectionSiblings: any[] = [];
if (collectionId) {
  const { data } = await (supabase.from as any)("collections")
    .select("slug, name, description_md, cover_image_url")
    .eq("id", collectionId)
    .eq("status", "published")
    .maybeSingle();
  parentCollection = (data as ParentCollection | null) ?? null;

  if (parentCollection) {
    // Otros libros publicados de la misma colección (excluyendo el
    // libro actual). Traemos hasta 12 + el autor primario via junction
    // — el render es un carrusel horizontal con scroll-snap, así que
    // si la colección tiene más de los visibles, el lector navega
    // dentro de la sección antes de ir a /colecciones/[slug].
    const { data: siblingsRaw } = await (supabase.from as any)("books")
      .select("*, book_authors(sort_order, author:authors(*))")
      .eq("collection_id", collectionId)
      .eq("status", "published")
      .neq("id", book.id)
      .order("publication_date", { ascending: false })
      .limit(12);
    collectionSiblings = (siblingsRaw as any[]) ?? [];
  }
}

// "More from these authors" rail: books co-written by any of this book's
// authors, ranked by recency. Fetched via the junction so a book counts
// even if this author isn't the primary one on it.
const authorIds = authors.map((a) => a.id);
let otherBooks: Awaited<ReturnType<typeof supabase.from<"books">["select"]>>["data"] = [];
let authorBookTotal = 0;
if (authorIds.length > 0) {
  const { data: junctionRows } = await supabase
    .from("book_authors")
    .select("book_id")
    .in("author_id", authorIds);
  const otherBookIds = Array.from(
    new Set((junctionRows ?? []).map((r) => r.book_id).filter((id) => id !== book.id)),
  );
  if (otherBookIds.length > 0) {
    const { data: otherBooksRaw, count } = await supabase
      .from("books")
      .select("*", { count: "exact" })
      .eq("status", "published")
      .in("id", otherBookIds)
      .order("publication_date", { ascending: false })
      .limit(4);
    otherBooks = otherBooksRaw ?? [];
    authorBookTotal = count ?? 0;
  }
}

const description = renderMarkdown(book.description_md);
const authorListLabel = joinAuthorNames(authors.map((a) => a.name));

// Site-wide typography for the book detail page. Editors choose this
// in /site?page=catalogo in the CMS; here we just turn the saved key
// into a usable CSS font-family stack. Affects every book.
const bookTypo = config.book_detail_typography ?? { title_font: "serif", body_font: "serif" };
const bookTitleFont = resolveFont(bookTypo.title_font);
const bookBodyFont = resolveFont(bookTypo.body_font);

// Meta description: prefer subtitle, fall back to a cleaned excerpt
// of the description (markdown stripped, ~155 chars at word boundary).
const metaDescription =
  book.subtitle?.trim() ||
  clampText(mdToPlainText(book.description_md), 155) ||
  `${book.title}${authorListLabel ? " — " + authorListLabel : ""}. Casa de Asterión Ediciones — Filosofía y Poesía.`;

const formattedPrice =
  book.price_amount != null
    ? new Intl.NumberFormat("es-CO", {
        style: "currency",
        currency: book.price_currency,
        maximumFractionDigits: 0,
      }).format(Number(book.price_amount))
    : null;

const techRows: { label: string; value: string }[] = [];
if (book.isbn) techRows.push({ label: "ISBN", value: book.isbn });
if (book.pages) techRows.push({ label: "Páginas", value: String(book.pages) });
if (book.format) techRows.push({ label: "Formato", value: book.format });
if (book.publication_date)
  techRows.push({ label: "Publicación", value: String(new Date(book.publication_date).getFullYear()) });
if (formattedPrice) techRows.push({ label: "Precio", value: formattedPrice });
---

<Layout
  title={book.title}
  description={metaDescription}
  breadcrumbLabel={book.title}
  seoType="book"
  image={book.cover_image_url}
  imageAlt={book.cover_image_alt ?? `Portada de ${book.title}`}
  keywords={book.keywords}
  canonical={book.canonical_url}
  isbn={book.isbn}
  authors={authors.map((a) => ({
    name: a.name,
    url: new URL(`/autores/${a.slug}`, Astro.site).href,
  }))}
  publishedAt={book.publication_date}
  breadcrumbItems={[
    { name: "Inicio", url: new URL("/", Astro.site).href },
    { name: "Catálogo", url: new URL("/catalogo", Astro.site).href },
    { name: book.title, url: Astro.url.href },
  ]}
>
  <article class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pt-6 sm:pt-10 md:pt-16 pb-12 sm:pb-16 md:pb-20 grid grid-cols-1 lg:grid-cols-[minmax(0,360px)_1fr] gap-7 sm:gap-9 lg:gap-16">
    {/* Left rail: cover + author card + tech info. On mobile this stacks
        before the description; tech info is reordered to the bottom. */}
    <aside class="lg:sticky lg:top-24 self-start space-y-5 sm:space-y-6 lg:space-y-7">
      <div class="max-w-[220px] sm:max-w-[260px] lg:max-w-none mx-auto lg:mx-0 w-full">
        {book.cover_image_url ? (
          <img
            src={book.cover_image_url}
            alt={`Portada de ${book.title}`}
            class="w-full aspect-[3/4] object-cover bg-[color:var(--bg-alt)] shadow-md shadow-stone-900/10 ring-1 ring-stone-900/[0.04]"
          />
        ) : (
          <div class="aspect-[3/4] bg-[color:var(--bg-alt)]"></div>
        )}
      </div>

      {/* Technical info — single column, sits under cover on desktop. */}
      {techRows.length > 0 && (
        <dl class="hidden lg:grid border-t border-[color:var(--border)] pt-5 text-sm grid-cols-[max-content_1fr] gap-x-4 gap-y-2">
          {techRows.map(({ label, value }) => (
            <>
              <dt class="text-[color:var(--fg-muted)] uppercase tracking-[0.12em] text-[11px] self-baseline">
                {label}
              </dt>
              <dd class:list={["min-w-0 break-words", label === "Precio" && "font-medium"]}>
                {label === "Formato" ? <span class="capitalize">{value}</span> : value}
              </dd>
            </>
          ))}
        </dl>
      )}
    </aside>

    {/* Right column: title, subtitle, description, CTA. The font-family
        overrides cascade into the .cas-md children too — see the inline
        <style> block at the bottom of this page. */}
    <div class="min-w-0">
      {parentCollection && (
        <a
          href={`/colecciones/${parentCollection.slug}`}
          class="group flex items-center gap-3 sm:gap-4 mb-5 sm:mb-6 p-3 sm:p-4 border border-[color:var(--border)] bg-[color:var(--bg-alt)]/60 hover:border-[color:var(--fg)] hover:bg-[color:var(--bg-alt)] transition-colors"
        >
          <span class="flex w-10 h-10 sm:w-11 sm:h-11 items-center justify-center bg-[color:var(--bg)] border border-[color:var(--border)] group-hover:border-[color:var(--fg)] transition-colors shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/>
            </svg>
          </span>
          <div class="min-w-0 flex-1">
            <p class="uppercase text-[10px] sm:text-[11px] tracking-[0.22em] text-[color:var(--fg-muted)] mb-0.5">
              Parte de la colección
            </p>
            <p class="font-serif text-base sm:text-lg md:text-xl leading-tight text-[color:var(--fg)] group-hover:underline underline-offset-4 decoration-[color:var(--fg-muted)] truncate">
              {parentCollection.name}
            </p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-[color:var(--fg-muted)] group-hover:text-[color:var(--fg)] group-hover:translate-x-0.5 transition" aria-hidden="true">
            <path d="M5 12h14"/>
            <path d="m13 5 7 7-7 7"/>
          </svg>
        </a>
      )}
      <h1 class="cas-book-title font-serif text-2xl sm:text-3xl md:text-5xl leading-[1.1] mb-2 sm:mb-3">{book.title}</h1>
      {book.subtitle && (
        <p class="text-sm sm:text-base md:text-xl text-[color:var(--fg-muted)] italic mb-5 sm:mb-7 md:mb-8">{book.subtitle}</p>
      )}

      <div class="cas-book-description cas-md cas-md--book max-w-none mb-7 sm:mb-9 md:mb-10" set:html={description}></div>

      {/* Mobile-only tech info: appears under the description before the CTA. */}
      {techRows.length > 0 && (
        <dl class="lg:hidden border-t border-[color:var(--border)] pt-5 mb-7 sm:mb-8 text-sm grid grid-cols-[max-content_1fr] gap-x-5 sm:gap-x-7 gap-y-2.5">
          {techRows.map(({ label, value }) => (
            <>
              <dt class="text-[color:var(--fg-muted)] uppercase tracking-[0.12em] text-[11px] self-baseline">
                {label}
              </dt>
              <dd class:list={["min-w-0 break-words", label === "Precio" && "font-medium"]}>
                {label === "Formato" ? <span class="capitalize">{value}</span> : value}
              </dd>
            </>
          ))}
        </dl>
      )}

      <AddToCartButton
        slug={book.slug}
        title={book.title}
        coverImageUrl={book.cover_image_url}
        priceAmount={book.price_amount}
        priceCurrency={book.price_currency}
        variant="primary"
        className="w-full sm:w-auto justify-center"
      />

      {/* Cast del libro debajo del botón Comprar. Cuatro secciones
          condicionales (autores, colaboradores, traductores,
          prologistas) en el orden de aporte editorial. Los labels son
          singular/plural según cuántas personas haya en cada rol. */}
      {(authors.length + collaborators.length + translators.length + prologuists.length) > 0 && (
        <div class="mt-8 sm:mt-10 md:mt-12 space-y-7 sm:space-y-8 border-t border-[color:var(--border)] pt-7 sm:pt-9">
          {[
            { people: authors,       singular: "Autor",        plural: "Autores",        section: "autores"        as const },
            { people: collaborators, singular: "Colaborador",  plural: "Colaboradores",  section: "colaboradores"  as const },
            { people: translators,   singular: "Traductor",    plural: "Traductores",    section: "traductores"    as const },
            { people: prologuists,   singular: "Prologista",   plural: "Prologistas",    section: "prologistas"    as const },
          ].filter((g) => g.people.length > 0).map((g) => (
            <div class="space-y-3 sm:space-y-4">
              <p class="uppercase text-[10px] sm:text-[11px] tracking-[0.22em] text-[color:var(--fg-muted)]">
                {g.people.length > 1 ? g.plural : g.singular}
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
                {g.people.map((a) => (
                  <a
                    href={`/${g.section}/${a.slug}`}
                    class="group flex items-center gap-3 sm:gap-4 hover:opacity-85 transition-opacity"
                  >
                    <div class="w-12 h-12 sm:w-14 sm:h-14 shrink-0 overflow-hidden bg-[color:var(--bg-alt)] ring-1 ring-stone-900/[0.06]">
                      {a.photo_url ? (
                        <img
                          src={a.photo_url}
                          alt={a.name}
                          loading="lazy"
                          class="w-full h-full object-cover"
                        />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center text-[color:var(--fg-muted)] font-serif text-xl">
                          {a.name.charAt(0)}
                        </div>
                      )}
                    </div>
                    <div class="min-w-0">
                      <p class="font-serif text-base sm:text-lg leading-tight group-hover:underline underline-offset-4 decoration-[color:var(--fg-muted)] truncate">
                        {a.name}
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </article>

  {/* Otros libros de la misma colección. Carrusel horizontal con
      scroll-snap — 4 portadas visibles en desktop, 2 en mobile. El
      botón "Ver colección" sigue siendo prominente al final del header
      y se repite como CTA debajo del carrusel. */}
  {parentCollection && collectionSiblings.length > 0 && (
    <section class="bg-[color:var(--bg-alt)] border-y border-[color:var(--border)]">
      <div class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 py-16 sm:py-20 md:py-24">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 sm:gap-6 mb-8 sm:mb-10 md:mb-12 border-b border-[color:var(--border)] pb-6 sm:pb-7 md:pb-8">
          <div class="min-w-0">
            <p class="uppercase text-[10px] sm:text-xs tracking-[0.2em] text-[color:var(--fg-muted)] mb-1.5 sm:mb-2 inline-flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/></svg>
              <span>De la colección</span>
            </p>
            <h2 class="font-serif text-xl sm:text-2xl md:text-3xl leading-tight">
              Otros libros de <a href={`/colecciones/${parentCollection.slug}`} class="italic hover:underline underline-offset-4 decoration-[color:var(--fg-muted)]">{parentCollection.name}</a>
            </h2>
          </div>
          <a
            href={`/colecciones/${parentCollection.slug}`}
            class="group inline-flex items-center justify-center gap-2.5 self-start sm:self-auto shrink-0 border border-[color:var(--fg)] text-[color:var(--fg)] px-5 py-2.5 sm:px-6 sm:py-3 text-[11px] sm:text-xs uppercase tracking-[0.22em] hover:bg-[color:var(--fg)] hover:text-[color:var(--bg)] transition-colors"
          >
            <span>Ver colección</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
              <path d="M5 12h14"/>
              <path d="m13 5 7 7-7 7"/>
            </svg>
          </a>
        </div>

        <div class="cas-coll-sib-carousel relative">
          <ul class="cas-coll-sib-track" data-coll-sib-track>
            {collectionSiblings.map((b: any) => {
              const siblingAuthors = extractAuthors(
                (b.book_authors ?? []) as { sort_order: number; author: Author | null }[],
              );
              const siblingAuthor = siblingAuthors[0] ?? null;
              return (
                <li class="cas-coll-sib-slide">
                  <BookCard book={b} author={siblingAuthor} config={config} />
                </li>
              );
            })}
          </ul>
          {collectionSiblings.length > 4 && (
            <>
              <button
                type="button"
                class="cas-coll-sib-arrow cas-coll-sib-arrow-prev hidden md:inline-flex"
                aria-label="Anterior"
                data-coll-sib-prev
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button
                type="button"
                class="cas-coll-sib-arrow cas-coll-sib-arrow-next hidden md:inline-flex"
                aria-label="Siguiente"
                data-coll-sib-next
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </>
          )}
        </div>
      </div>
    </section>
  )}

  <style>
    .cas-coll-sib-carousel { position: relative; }
    .cas-coll-sib-track {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: calc((100% - 3 * 2.5rem) / 4);
      gap: 2.5rem;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      list-style: none;
      margin: 0;
      padding: 0 0 0.5rem;
      scrollbar-width: thin;
      scrollbar-color: color-mix(in oklch, var(--fg) 25%, transparent) transparent;
    }
    .cas-coll-sib-track::-webkit-scrollbar { height: 4px; }
    .cas-coll-sib-track::-webkit-scrollbar-thumb {
      background: color-mix(in oklch, var(--fg) 25%, transparent);
      border-radius: 2px;
    }
    .cas-coll-sib-slide {
      scroll-snap-align: start;
      min-width: 0;
    }
    @media (max-width: 640px) {
      .cas-coll-sib-track { grid-auto-columns: 60%; gap: 1.25rem; }
    }
    @media (min-width: 641px) and (max-width: 1023px) {
      .cas-coll-sib-track {
        grid-auto-columns: calc((100% - 2 * 2rem) / 3);
        gap: 2rem;
      }
    }
    .cas-coll-sib-arrow {
      position: absolute;
      top: 30%;
      transform: translateY(-50%);
      width: 40px;
      height: 40px;
      border-radius: 9999px;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--fg);
      cursor: pointer;
      align-items: center;
      justify-content: center;
      box-shadow: 0 1px 6px rgba(0,0,0,0.08);
      transition: background-color 0.15s, border-color 0.15s, opacity 0.2s;
      z-index: 2;
    }
    .cas-coll-sib-arrow:hover {
      background: var(--fg);
      color: var(--bg);
      border-color: var(--fg);
    }
    .cas-coll-sib-arrow[disabled] { opacity: 0.3; pointer-events: none; }
    .cas-coll-sib-arrow-prev { left: -18px; }
    .cas-coll-sib-arrow-next { right: -18px; }
  </style>

  <script is:inline>
    (() => {
      const init = () => {
        document.querySelectorAll("[data-coll-sib-track]").forEach((track) => {
          if (track.dataset.csibBound) return;
          track.dataset.csibBound = "1";
          const wrap = track.closest(".cas-coll-sib-carousel");
          if (!wrap) return;
          const prev = wrap.querySelector("[data-coll-sib-prev]");
          const next = wrap.querySelector("[data-coll-sib-next]");
          const updateArrows = () => {
            const max = track.scrollWidth - track.clientWidth;
            if (prev) prev.toggleAttribute("disabled", track.scrollLeft <= 1);
            if (next) next.toggleAttribute("disabled", track.scrollLeft >= max - 1);
          };
          const step = () => Math.max(track.clientWidth * 0.85, 200);
          prev?.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
          next?.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
          track.addEventListener("scroll", updateArrows, { passive: true });
          window.addEventListener("resize", updateArrows);
          updateArrows();
        });
      };
      init();
      document.addEventListener("astro:page-load", init);
    })();
  </script>

  {/* Otros libros: cualquier libro escrito por al menos uno de los
      autores de éste. Cuando hay un solo autor, el "Ver todos" lleva a
      su ficha; con varios omitimos el link porque no apunta a una sola
      página. */}
  {primaryAuthor && otherBooks.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pt-12 sm:pt-16 md:pt-20 pb-16 sm:pb-20 md:pb-24">
      <div class="flex items-end justify-between gap-4 mb-8 sm:mb-10 md:mb-12 border-b border-[color:var(--border)] pb-6 sm:pb-7 md:pb-8">
        <div class="min-w-0">
          <p class="uppercase text-[10px] sm:text-xs tracking-[0.2em] text-[color:var(--fg-muted)] mb-1.5 sm:mb-2">
            {authors.length > 1 ? "Más de estos autores" : "Más del autor"}
          </p>
          <h2 class="font-serif text-xl sm:text-2xl md:text-3xl leading-tight">
            {authors.length > 1
              ? `Otros libros de ${authorListLabel}`
              : `Otros libros de ${primaryAuthor.name}`}
          </h2>
        </div>
        {authors.length === 1 && authorBookTotal > otherBooks.length + 1 && (
          <a href={`/autores/${primaryAuthor.slug}`} class="nav-link shrink-0 pb-1">Ver todos</a>
        )}
      </div>
      <div class="grid gap-x-5 gap-y-10 sm:gap-x-8 sm:gap-y-14 md:gap-x-10 md:gap-y-16 grid-cols-2 lg:grid-cols-4">
        {otherBooks.map((b) => (
          <BookCard book={b} author={primaryAuthor} config={config} />
        ))}
      </div>
    </section>
  )}

  {/* Site-wide typography (read from site_configuration). The body
      font cascades into the markdown children — paragraphs, lists,
      blockquotes — overriding the .cas-md defaults. The title font is
      applied to the h1 only. */}
  <style is:inline set:html={`
    .cas-book-title { font-family: ${bookTitleFont}; }
    .cas-book-description,
    .cas-book-description p,
    .cas-book-description li,
    .cas-book-description blockquote,
    .cas-book-description h2,
    .cas-book-description h3,
    .cas-book-description h4 { font-family: ${bookBodyFont}; }
  `}></style>
</Layout>
