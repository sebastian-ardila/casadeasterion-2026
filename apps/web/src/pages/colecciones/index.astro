---
import Layout from "~/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { supabase } from "~/lib/supabase";
import { mdToPlainText, clampText } from "~/lib/markdown";

// "Colecciones" — agrupaciones temáticas de libros. Cada colección
// se renderiza como una fila independiente: a la izquierda los
// metadatos y la lista completa de títulos; a la derecha un
// carrusel horizontal con hasta 3 portadas visibles a la vez. Arriba
// hay badges navegables (uno por colección) que llevan al detalle.

// 1. Traer todas las colecciones publicadas + sus libros (todos, no
//    solo 3 — el carrusel scrollea, pero también necesitamos los
//    títulos para la lista lateral).
const [{ data: collectionsRaw }, { data: booksRaw }] = await Promise.all([
  (supabase.from as any)("collections")
    .select("id, slug, name, description_md, cover_image_url, sort_order, category:categories(id, name, icon, slug)")
    .eq("status", "published")
    .order("sort_order", { ascending: true })
    .order("name", { ascending: true }),
  supabase
    .from("books")
    .select("id, slug, title, cover_image_url, publication_date, collection_id, authors!books_author_id_fkey(name)" as any)
    .eq("status", "published")
    .order("publication_date", { ascending: false }),
]);

type Collection = {
  id: string;
  slug: string;
  name: string;
  description_md: string | null;
  cover_image_url: string | null;
  sort_order: number;
  category: { id: string; name: string; icon: string | null; slug: string } | null;
};

type Book = {
  id: string;
  slug: string;
  title: string;
  cover_image_url: string | null;
  publication_date: string | null;
  collection_id: string | null;
  authors: { name: string } | null;
};

// Strip diacritics & lowercase para que la búsqueda funcione sin
// importar acentos. Se aplica también a un haystack que cubre
// nombre + categoría + títulos de los libros, así "bahareque"
// encuentra la colección donde está incluido.
const stripDiacritics = (s: string) =>
  s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");

const collections = (collectionsRaw ?? []) as Collection[];
const books = (booksRaw ?? []) as Book[];

// Agrupar libros por colección — pasada única, mantiene el orden
// (desc por publication_date) que ya viene del query.
const byCollection = new Map<string, Book[]>();
for (const b of books) {
  if (!b.collection_id) continue;
  const list = byCollection.get(b.collection_id);
  if (list) list.push(b);
  else byCollection.set(b.collection_id, [b]);
}

const collectionsView = collections.map((c) => {
  const allBooks = byCollection.get(c.id) ?? [];
  const blurb = clampText(mdToPlainText(c.description_md ?? ""), 220);
  const haystack = stripDiacritics(
    [c.name, c.category?.name ?? "", blurb, ...allBooks.map((b) => b.title)].join(" "),
  );
  return {
    ...c,
    blurb,
    allBooks,
    carouselBooks: allBooks.slice(0, 6),
    bookCount: allBooks.length,
    haystack,
  };
});

---

<Layout
  title="Colecciones"
  description="Colecciones editoriales de Casa de Asterión Ediciones: agrupaciones temáticas de libros de filosofía y poesía contemporáneas."
  keywords={[
    "colecciones Casa de Asterión",
    "colecciones editoriales",
    "colecciones de libros",
    "filosofía colección",
    "poesía colección",
    "editorial independiente",
  ]}
>
  <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pt-12 sm:pt-16 md:pt-20 pb-6 sm:pb-8">
    <h1 class="font-serif text-3xl sm:text-4xl md:text-6xl mb-3 sm:mb-4">Colecciones</h1>
    <p class="text-[color:var(--fg-muted)] max-w-prose text-base sm:text-lg leading-relaxed">
      Agrupaciones temáticas de libros — invitaciones a leer un mismo gesto editorial desde distintas voces.
    </p>
  </section>

  {collectionsView.length === 0 ? (
    <section class="mx-auto max-w-[1180px] px-5 sm:px-6 lg:px-12 pb-16 sm:pb-20 md:pb-24">
      <div class="border border-dashed border-[color:var(--border)] py-16 px-8 text-center text-[color:var(--fg-muted)]">
        <p>Aún no hay colecciones publicadas.</p>
      </div>
    </section>
  ) : (
    <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pb-16 sm:pb-20 md:pb-24" data-collections-section>
      {/* Search bar — mismo patrón visual que /catalogo y /autores. */}
      <div class="mb-6 sm:mb-8">
        <label for="colecciones-search" class="sr-only">Buscar colección por nombre o descripción</label>
        <div class="relative">
          <svg
            class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400"
            width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <input
            id="colecciones-search"
            type="search"
            data-collections-search
            placeholder="Buscar colección por nombre…"
            autocomplete="off"
            spellcheck="false"
            aria-label="Buscar colección por nombre"
            class="w-full pl-10 pr-3 py-3 border border-[color:var(--border)] bg-[color:var(--bg)] text-sm focus:outline-none focus:border-stone-900 transition-colors"
          />
        </div>
      </div>

      {/* Badges navegables — una por colección publicada. Sustituyen
          al filtro por categoría: cada badge es un atajo directo al
          detalle de la colección. */}
      {collectionsView.length > 0 && (
        <nav
          aria-label="Ir a una colección"
          class="flex flex-wrap items-center gap-2 sm:gap-2.5 mb-10 sm:mb-12 md:mb-14"
        >
          {collectionsView.map((c) => (
            <a href={`/colecciones/${c.slug}`} class="cas-chip cas-chip-link">
              <span>{c.name}</span>
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="transition-transform group-hover:translate-x-0.5"
              >
                <path d="M5 12h14" />
                <path d="m13 5 7 7-7 7" />
              </svg>
            </a>
          ))}
        </nav>
      )}

      <div class="cas-coll-list" data-collections-rows>
        {collectionsView.map((c) => (
          <article
            class="cas-coll-row"
            data-collection-row
            data-search-text={c.haystack}
          >
            <header class="cas-coll-header mb-5 sm:mb-8 pb-4 sm:pb-7 border-b border-[color:var(--border)]">
              <div class="flex items-start gap-4 sm:items-end sm:justify-between sm:gap-6">
                {/* Cover thumbnail + title group. En mobile el thumb
                    arranca el row y le da identidad; en desktop el
                    thumb se oculta porque el carrusel del lado derecho
                    ya muestra portadas. */}
                <div class="flex items-start gap-3 sm:gap-0 min-w-0 flex-1">
                  {(c.cover_image_url || c.carouselBooks[0]?.cover_image_url) && (
                    <a
                      href={`/colecciones/${c.slug}`}
                      class="shrink-0 sm:hidden block w-12 h-16 overflow-hidden bg-[color:var(--bg-alt)]"
                      aria-label={`Ver la colección ${c.name}`}
                    >
                      <img
                        src={c.cover_image_url || c.carouselBooks[0]?.cover_image_url || ""}
                        alt=""
                        loading="lazy"
                        class="w-full h-full object-cover"
                      />
                    </a>
                  )}
                  <div class="min-w-0">
                    {c.category && (
                      <p class="inline-flex items-center gap-1.5 uppercase text-[9px] sm:text-[11px] tracking-[0.22em] text-[color:var(--fg-muted)] mb-1.5 sm:mb-2">
                        {c.category.icon && (
                          <Icon name={`lucide:${c.category.icon}`} class="w-3 h-3" aria-hidden="true" />
                        )}
                        <span>{c.category.name}</span>
                      </p>
                    )}
                    <h2 class="font-serif text-xl sm:text-3xl md:text-4xl leading-tight">
                      <a href={`/colecciones/${c.slug}`} class="hover:underline underline-offset-4 decoration-[color:var(--fg-muted)]">
                        {c.name}
                      </a>
                    </h2>
                    <p class="sm:hidden mt-1 text-[10px] uppercase tracking-[0.18em] text-[color:var(--fg-muted)]">
                      {c.bookCount === 1 ? "1 libro" : `${c.bookCount} libros`}
                    </p>
                  </div>
                </div>
                <a
                  href={`/colecciones/${c.slug}`}
                  class="hidden sm:inline-flex group shrink-0 items-center gap-2.5 self-end px-6 py-3 border border-[color:var(--fg)] text-[color:var(--fg)] text-xs uppercase tracking-[0.2em] hover:bg-[color:var(--fg)] hover:text-[color:var(--bg)] transition-colors"
                >
                  <span>{c.bookCount === 1 ? "Ver libro" : `Ver los ${c.bookCount} libros`}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-hover:translate-x-1">
                    <path d="M5 12h14"/>
                    <path d="m13 5 7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,320px)_1fr] gap-6 sm:gap-10 lg:gap-14">
              {/* Lado izquierdo: blurb + lista de títulos */}
              <aside class="min-w-0 order-2 lg:order-1">
                {c.blurb && (
                  <p class="font-serif text-base sm:text-lg text-[color:var(--fg-muted)] leading-relaxed mb-4 sm:mb-6">
                    {c.blurb}
                  </p>
                )}
                {c.allBooks.length > 0 ? (
                  // Lista detallada de títulos+autor solo en desktop —
                  // en mobile cargaría demasiada información para una
                  // vista resumen. El detalle vive en /colecciones/[slug].
                  <div class="hidden lg:block">
                    <p class="uppercase text-[11px] tracking-[0.22em] text-[color:var(--fg-muted)] mb-3">
                      {c.allBooks.length === 1 ? "Libro" : "Libros"}
                    </p>
                    <ul class="space-y-2">
                      {c.allBooks.map((b) => (
                        <li>
                          <a
                            href={`/catalogo/${b.slug}`}
                            class="group inline-flex items-baseline gap-2 font-serif text-base leading-snug text-[color:var(--fg)]"
                          >
                            <span class="text-[color:var(--fg-muted)] group-hover:text-[color:var(--fg)] transition">·</span>
                            <span class="min-w-0">
                              <span class="italic group-hover:underline underline-offset-4 decoration-[color:var(--fg-muted)]">
                                {b.title}
                              </span>
                              {b.authors?.name && (
                                <span class="text-[color:var(--fg-muted)]"> — {b.authors.name}</span>
                              )}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : (
                  <p class="text-sm text-[color:var(--fg-muted)] italic">
                    Aún no hay libros publicados en esta colección.
                  </p>
                )}

                {/* Mobile-only CTA al final del aside, full-width. */}
                <a
                  href={`/colecciones/${c.slug}`}
                  class="group sm:hidden mt-5 flex w-full items-center justify-center gap-2.5 px-5 py-2.5 border border-[color:var(--fg)] text-[color:var(--fg)] text-[11px] uppercase tracking-[0.2em] hover:bg-[color:var(--fg)] hover:text-[color:var(--bg)] transition-colors"
                >
                  <span>{c.bookCount === 1 ? "Ver libro" : `Ver los ${c.bookCount} libros`}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-hover:translate-x-1">
                    <path d="M5 12h14"/>
                    <path d="m13 5 7 7-7 7"/>
                  </svg>
                </a>
              </aside>

              {/* Lado derecho: carrusel de portadas, hasta 3 visibles. */}
              <div class="min-w-0 order-1 lg:order-2">
                {c.carouselBooks.length > 0 ? (
                  <div class="cas-coll-carousel" data-coll-carousel>
                    <button
                      type="button"
                      class="cas-coll-arrow cas-coll-arrow-left"
                      data-coll-prev
                      aria-label="Anterior"
                      tabindex="-1"
                    >
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m15 18-6-6 6-6"/>
                      </svg>
                    </button>
                    <ul class="cas-coll-track" data-coll-track>
                      {c.carouselBooks.map((b) => (
                        <li class="cas-coll-slide">
                          <a href={`/catalogo/${b.slug}`} class="group block">
                            {b.cover_image_url ? (
                              <img
                                src={b.cover_image_url}
                                alt={b.title}
                                loading="lazy"
                                class="w-full aspect-[3/4] object-cover bg-[color:var(--bg-alt)] shadow-md shadow-stone-900/10 ring-1 ring-stone-900/[0.04] group-hover:opacity-95 transition-opacity"
                              />
                            ) : (
                              <div class="w-full aspect-[3/4] bg-[color:var(--bg-alt)]"></div>
                            )}
                            <p class="font-serif text-xs sm:text-base mt-2 sm:mt-3 leading-tight line-clamp-2 group-hover:underline underline-offset-4 decoration-[color:var(--fg-muted)]">
                              {b.title}
                            </p>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <button
                      type="button"
                      class="cas-coll-arrow cas-coll-arrow-right"
                      data-coll-next
                      aria-label="Siguiente"
                      tabindex="-1"
                    >
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m9 18 6-6-6-6"/>
                      </svg>
                    </button>
                  </div>
                ) : c.cover_image_url ? (
                  <a href={`/colecciones/${c.slug}`} class="block max-w-[260px]">
                    <img
                      src={c.cover_image_url}
                      alt={c.name}
                      loading="lazy"
                      class="w-full aspect-[4/5] object-cover bg-[color:var(--bg-alt)]"
                    />
                  </a>
                ) : null}
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="text-[color:var(--fg-muted)] mt-12 hidden" data-collections-empty>
        No hay colecciones en esta categoría.
      </p>
    </section>
  )}
</Layout>

<style>
  .cas-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    color: var(--fg-muted);
    background: transparent;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .cas-chip:hover { color: var(--fg); border-color: var(--fg); }
  .cas-chip-active {
    color: var(--bg);
    background: var(--fg);
    border-color: var(--fg);
  }
  /* Badge navegable — un atajo directo al detalle de cada colección.
     Se diferencia visualmente del chip filtrable: hover invierte
     fondo/color para acentuar la afordancia de "voy a otra página". */
  .cas-chip-link {
    text-decoration: none;
    color: var(--fg);
    border-color: var(--border);
  }
  .cas-chip-link svg {
    transition: transform 160ms ease;
  }
  .cas-chip-link:hover {
    color: var(--bg);
    background: var(--fg);
    border-color: var(--fg);
  }
  .cas-chip-link:hover svg {
    transform: translateX(2px);
  }

  /* Lista de colecciones — divider más visible y compacto en mobile,
     spacing original en desktop. */
  .cas-coll-list {
    display: flex;
    flex-direction: column;
  }
  .cas-coll-row + .cas-coll-row {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }
  @media (min-width: 640px) {
    .cas-coll-row + .cas-coll-row {
      margin-top: 5rem;
      padding-top: 0;
      border-top: 0;
    }
  }
  @media (min-width: 768px) {
    .cas-coll-row + .cas-coll-row { margin-top: 6rem; }
  }

  /* Carrusel de portadas. Track scroll-snap horizontal con tres
     slides visibles en desktop; las flechas hacen scrollBy del ancho
     visible. En mobile mostramos ~2.3 portadas pequeñas para que se
     vea claramente que hay más libros desplazables. */
  .cas-coll-carousel {
    position: relative;
  }
  .cas-coll-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * 1.25rem) / 3);
    gap: 1.25rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    list-style: none;
    margin: 0;
    padding: 0 0 0.25rem;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--fg) 25%, transparent) transparent;
  }
  .cas-coll-track::-webkit-scrollbar { height: 4px; }
  .cas-coll-track::-webkit-scrollbar-thumb {
    background: color-mix(in oklch, var(--fg) 25%, transparent);
    border-radius: 2px;
  }
  .cas-coll-slide {
    scroll-snap-align: start;
    min-width: 0;
  }
  @media (max-width: 640px) {
    .cas-coll-track { grid-auto-columns: 42%; gap: 0.75rem; }
  }
  @media (min-width: 641px) and (max-width: 1023px) {
    .cas-coll-track { grid-auto-columns: calc((100% - 1.25rem) / 2); }
  }

  .cas-coll-arrow {
    position: absolute;
    top: 30%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--fg);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px -6px rgba(28, 25, 23, 0.18);
    transition: opacity 160ms ease, transform 160ms ease;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
  }
  .cas-coll-carousel:hover .cas-coll-arrow,
  .cas-coll-carousel:focus-within .cas-coll-arrow {
    opacity: 1;
    pointer-events: auto;
  }
  .cas-coll-arrow:hover { transform: translateY(-50%) scale(1.05); }
  .cas-coll-arrow-left { left: -14px; }
  .cas-coll-arrow-right { right: -14px; }
  /* Mobile: always-visible smaller arrows below the slides aren't
     necessary — touch-scroll is the primary affordance there. Hide
     the arrows below the tablet breakpoint to keep edges clean. */
  @media (max-width: 768px) {
    .cas-coll-arrow { display: none; }
  }
</style>

<script is:inline>
  (() => {
    const section = document.querySelector("[data-collections-section]");
    if (!section) return;

    // -- Búsqueda libre ------------------------------------------
    const rows = section.querySelectorAll("[data-collection-row]");
    const empty = section.querySelector("[data-collections-empty]");
    const search = section.querySelector("[data-collections-search]");

    const stripDiacritics = (s) =>
      String(s ?? "").toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");

    let currentQuery = "";

    const apply = () => {
      let visible = 0;
      rows.forEach((row) => {
        const text = row.getAttribute("data-search-text") || "";
        const show = !currentQuery || text.includes(currentQuery);
        row.classList.toggle("hidden", !show);
        if (show) visible++;
      });
      if (empty) {
        empty.classList.toggle("hidden", visible > 0);
        empty.textContent = "No hay colecciones que coincidan con tu búsqueda.";
      }
    };

    if (search) {
      search.addEventListener("input", () => {
        currentQuery = stripDiacritics(search.value.trim());
        apply();
      });
    }

    // -- Carruseles de portadas -----------------------------------
    section.querySelectorAll("[data-coll-carousel]").forEach((car) => {
      const track = car.querySelector("[data-coll-track]");
      const prev = car.querySelector("[data-coll-prev]");
      const next = car.querySelector("[data-coll-next]");
      if (!track) return;

      const scrollOne = (dir) => {
        const slide = track.querySelector(".cas-coll-slide");
        const step = slide ? slide.getBoundingClientRect().width + 20 : track.clientWidth * 0.6;
        track.scrollBy({ left: dir * step, behavior: "smooth" });
      };

      prev?.addEventListener("click", () => scrollOne(-1));
      next?.addEventListener("click", () => scrollOne(1));
    });
  })();
</script>
