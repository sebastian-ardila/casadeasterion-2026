---
import Layout from "~/layouts/Layout.astro";
import EmptyState from "~/components/EmptyState.astro";
import { supabase } from "~/lib/supabase";

// "Traductores" — vista filtrada de `authors` donde role_tags
// incluye 'translator'. Datos buildeados en SSG. Si no hay nadie
// con ese rol todavía, mostramos EmptyState con "Pronto…".
const { data: translators } = await supabase
  .from("authors")
  .select("id, slug, name, photo_url, bio_md")
  .contains("role_tags", ["translator"])
  .order("name", { ascending: true });

const stripDiacritics = (s: string) =>
  s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
---

<Layout
  title="Traductores"
  description="Quienes han traducido obras publicadas con Casa de Asterión Ediciones."
  keywords={[
    "traductores Casa de Asterión",
    "traductores filosofía",
    "traductores poesía",
    "traducción literaria",
    "traductores Colombia",
  ]}
>
  <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pt-12 sm:pt-16 md:pt-20 pb-6 sm:pb-8">
    <h1 class="font-serif text-3xl sm:text-4xl md:text-6xl mb-3 sm:mb-4">Traductores</h1>
    <p class="text-[color:var(--fg-muted)] max-w-prose">
      Personas que han traducido libros o publicaciones de Casa de Asterión Ediciones — el puente entre las lenguas que abren los libros que editamos.
    </p>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pb-16 sm:pb-20 md:pb-24" data-people-section>
    {translators && translators.length > 0 ? (
      <>
        <div class="mb-8 sm:mb-10">
          <label for="traductores-search" class="sr-only">Buscar traductor por nombre</label>
          <div class="relative">
            <svg
              class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400"
              width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <input
              id="traductores-search"
              type="search"
              data-people-search
              placeholder="Buscar traductor por nombre…"
              autocomplete="off"
              spellcheck="false"
              aria-label="Buscar traductor por nombre"
              class="w-full pl-10 pr-3 py-3 border border-[color:var(--border)] bg-[color:var(--bg)] text-sm focus:outline-none focus:border-stone-900 transition-colors"
            />
          </div>
        </div>

        <div class="grid gap-8 sm:gap-10 md:gap-12 grid-cols-2 md:grid-cols-3 lg:grid-cols-4" data-people-grid>
          {translators.map((t) => (
            <a
              href={`/traductores/${t.slug}`}
              class="group"
              data-people-card
              data-search-text={stripDiacritics(t.name ?? "")}
            >
              {t.photo_url ? (
                <img
                  src={t.photo_url}
                  alt={t.name}
                  class="w-full aspect-square object-cover bg-[color:var(--bg-alt)] grayscale group-hover:grayscale-0 transition"
                />
              ) : (
                <div class="aspect-square bg-[color:var(--bg-alt)]"></div>
              )}
              <h3 class="font-serif text-lg mt-4">{t.name}</h3>
            </a>
          ))}
        </div>

        <p class="text-[color:var(--fg-muted)] mt-12 hidden" data-people-empty>
          No encontramos traductores con ese nombre.
        </p>
      </>
    ) : (
      <EmptyState
        icon="lucide:languages"
        title="Pronto, información sobre nuestros traductores"
        description="Estamos preparando las fichas de quienes han traducido obras de la editorial."
        ctaLabel="Volver al inicio"
      />
    )}
  </section>
</Layout>

<script is:inline>
  (() => {
    const section = document.querySelector("[data-people-section]");
    if (!section) return;
    const input = section.querySelector("[data-people-search]");
    const grid = section.querySelector("[data-people-grid]");
    const empty = section.querySelector("[data-people-empty]");
    if (!input || !grid) return;

    const normalize = (s) =>
      String(s ?? "").toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");

    const cards = Array.from(grid.querySelectorAll("[data-people-card]"));

    const apply = () => {
      const q = normalize(input.value.trim());
      let visible = 0;
      cards.forEach((c) => {
        const text = c.dataset.searchText || "";
        const match = !q || text.includes(q);
        c.classList.toggle("hidden", !match);
        if (match) visible++;
      });
      grid.classList.toggle("hidden", visible === 0);
      if (empty) empty.classList.toggle("hidden", visible !== 0);
    };

    input.addEventListener("input", apply);
  })();
</script>
