---
import Layout from "~/layouts/Layout.astro";
import PersonSections from "~/components/PersonSections.astro";
import { supabase } from "~/lib/supabase";
import { loadSiteConfig } from "~/lib/site-config";
import { renderMarkdown, mdToPlainText, clampText } from "~/lib/markdown";
import { loadPersonSections } from "~/lib/person-sections";

// Ficha pública de un traductor. Lee de `authors` (filtrada por
// role_tag 'translator') y junta libros y publicaciones de los 4 roles
// con el orden primario "translator" — traducciones aparecen primero.

export async function getStaticPaths() {
  const { data } = await supabase
    .from("authors")
    .select("slug")
    .contains("role_tags", ["translator"]);
  return (data ?? []).map((t: { slug: string }) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const config = await loadSiteConfig();

const { data: translator } = await supabase
  .from("authors")
  .select("*")
  .eq("slug", slug!)
  .contains("role_tags", ["translator"])
  .maybeSingle();

if (!translator) {
  return Astro.redirect("/traductores");
}

const { sections, categoryMap } = await loadPersonSections(
  supabase as any,
  translator.id,
  "translator",
);

const bio = renderMarkdown(translator.bio_md);
const links = (translator.links as Record<string, string> | null) ?? {};
const sameAs = [links.web, links.twitter, links.instagram].filter(Boolean) as string[];
const bioPlain = clampText(mdToPlainText(translator.bio_md), 160);
const metaDescription =
  bioPlain ||
  `${translator.name} — traductor de Casa de Asterión Ediciones.`;
---

<Layout
  title={translator.name}
  description={metaDescription}
  breadcrumbLabel={translator.name}
  seoType="person"
  image={translator.photo_url}
  imageAlt={`Foto de ${translator.name}`}
  keywords={translator.keywords}
  sameAs={sameAs}
  breadcrumbItems={[
    { name: "Inicio", url: new URL("/", Astro.site).href },
    { name: "Traductores", url: new URL("/traductores", Astro.site).href },
    { name: translator.name, url: Astro.url.href },
  ]}
>
  <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pt-12 sm:pt-16 md:pt-20 pb-10 sm:pb-12 grid grid-cols-1 md:grid-cols-[220px_1fr] lg:grid-cols-[260px_1fr] gap-6 md:gap-10 lg:gap-12 items-start">
    <div class="max-w-[220px] sm:max-w-[280px] mx-auto md:mx-0 w-full">
      {translator.photo_url ? (
        <img
          src={translator.photo_url}
          alt={translator.name}
          class="w-full aspect-square object-cover grayscale"
        />
      ) : (
        <div class="w-full aspect-square bg-[color:var(--bg-alt)]"></div>
      )}
    </div>
    <div>
      <p class="uppercase text-[11px] sm:text-xs tracking-[0.2em] text-[color:var(--fg-muted)] mb-3 sm:mb-4">
        Traductor
      </p>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl mb-5 sm:mb-6">{translator.name}</h1>
      <div class="cas-md cas-md--book font-serif max-w-none" set:html={bio}></div>
    </div>
  </section>

  <PersonSections
    sections={sections}
    categoryMap={categoryMap}
    person={translator}
    config={config}
  />
</Layout>
