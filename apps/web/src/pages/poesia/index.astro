---
// Legacy URL — el contenido de poesía ahora vive como filtro de
// /articulos. SSG-friendly meta-refresh + JS redirect para preservar
// bookmarks y links externos.
export const prerender = true;
const target = "/articulos?categoria=poesia";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Poesía · Casa de Asterión Ediciones</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>Si no eres redirigido, <a href={target}>haz clic aquí</a>.</p>
  </body>
</html>
