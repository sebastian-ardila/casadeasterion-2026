---
import Layout from "~/layouts/Layout.astro";
import PostCard from "~/components/PostCard.astro";
import { supabase } from "~/lib/supabase";

const { data: cat } = await supabase
  .from("categories")
  .select("*")
  .eq("slug", "poesia")
  .maybeSingle();

const [{ data: posts }, { data: authors }] = await Promise.all([
  cat
    ? supabase
        .from("posts")
        .select("*")
        .eq("status", "published")
        .eq("category_id", cat.id)
        .order("published_at", { ascending: false })
    : { data: [] },
  supabase.from("authors").select("*"),
]);

const authorMap = new Map((authors ?? []).map((a) => [a.id, a]));
---

<Layout title="Poesía" description="Poemas, antologías y crítica poética.">
  <section class="mx-auto max-w-[1400px] px-6 lg:px-12 pt-20 pb-12">
    <h1 class="font-serif text-4xl md:text-6xl mb-4">Poesía</h1>
    <p class="text-[color:var(--fg-muted)] max-w-prose">
      {cat?.description ?? "Poemas, antologías y crítica poética."}
    </p>
  </section>

  <section class="mx-auto max-w-[900px] px-6 lg:px-12 pb-24">
    {posts && posts.length > 0 ? (
      <div class="space-y-12">
        {posts.map((post) => (
          <PostCard post={post} author={authorMap.get(post.author_id ?? "")} category={cat} />
        ))}
      </div>
    ) : (
      <p class="text-[color:var(--fg-muted)]">Aún no hay poemas publicados.</p>
    )}
  </section>
</Layout>
