---
import Layout from "~/layouts/Layout.astro";
import { loadSiteConfig, buildWhatsappUrl } from "~/lib/site-config";

const config = await loadSiteConfig();
const whatsappLink = buildWhatsappUrl(
  config.whatsapp_phone,
  "Hola, me gustaría contactar con Casa de Asterión.",
  {},
);
---

<Layout title="Contacto">
  <section class="mx-auto max-w-[760px] px-5 sm:px-6 lg:px-12 py-16 sm:py-20 md:py-24">
    <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl mb-5 sm:mb-6">Contacto</h1>
    <p class="text-[color:var(--fg-muted)] leading-relaxed mb-10 sm:mb-12 max-w-prose">
      Para envíos editoriales, manuscritos, derechos, prensa o consultas generales, escríbenos.
    </p>

    <div class="space-y-6">
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="block border border-[color:var(--border)] p-6 sm:p-8 hover:border-[color:var(--fg)] transition"
      >
        <p class="uppercase text-[11px] sm:text-xs tracking-[0.18em] text-[color:var(--fg-muted)] mb-2">WhatsApp</p>
        <p class="font-serif text-xl sm:text-2xl break-all">{config.whatsapp_phone}</p>
      </a>
    </div>
  </section>
</Layout>
