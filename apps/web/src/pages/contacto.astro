---
// Legacy URL: the contact info is now an anchor section on the home,
// so /contacto redirects to /#contacto for any bookmark or external
// link still pointing here. SSG-friendly meta-refresh + a JS hop for
// the cases where the meta is suppressed.
export const prerender = true;
const target = "/#contacto";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Contacto · Casa de Asterión Ediciones</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>Si no eres redirigido, <a href={target}>haz clic aquí</a>.</p>
  </body>
</html>
