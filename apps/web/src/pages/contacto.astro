---
import Layout from "~/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import {
  loadSiteConfig,
  buildWhatsappUrl,
  type ContactEmail,
  type ContactPhone,
  type ContactAddress,
  type SocialAccount,
} from "~/lib/site-config";

const config = await loadSiteConfig();

// --- Build the data we'll render --------------------------------------------
const primaryEmail = (config.contact_email ?? "").trim();
const emails: ContactEmail[] = [
  ...(primaryEmail ? [{ email: primaryEmail, label: "" }] : []),
  ...((config.contact_emails_extra ?? []).filter((e) => (e?.email ?? "").trim())),
];

const primaryAddress = (config.contact_address ?? "").trim();
const addresses: ContactAddress[] = [
  ...(primaryAddress ? [{ address: primaryAddress, label: "" }] : []),
  ...((config.contact_addresses_extra ?? []).filter((a) => (a?.address ?? "").trim())),
];

const phones: ContactPhone[] = (config.contact_phones ?? []).filter(
  (p) => (p?.phone ?? "").trim(),
);

const hours = (config.contact_hours ?? "").trim();

const commerceWhatsapp = (config.whatsapp_phone ?? "").trim();
const commerceWhatsappLink = commerceWhatsapp
  ? buildWhatsappUrl(
      commerceWhatsapp,
      "Hola, me gustaría contactar con Casa de Asterión.",
      {},
    )
  : "";

const legacySocial = config.social_links ?? { facebook: "", instagram: "", twitter: "" };
const legacyAsArray: SocialAccount[] = [
  { platform: "instagram", url: legacySocial.instagram ?? "" },
  { platform: "facebook",  url: legacySocial.facebook ?? "" },
  { platform: "twitter",   url: legacySocial.twitter ?? "" },
].filter((s) => s.url.trim());
const socials: SocialAccount[] = [
  ...legacyAsArray,
  ...((config.social_accounts ?? []).filter((s) => (s?.url ?? "").trim())),
];

const SOCIAL_ICONS: Record<string, string> = {
  instagram: "lucide:instagram",
  facebook: "lucide:facebook",
  twitter: "lucide:twitter",
  youtube: "lucide:youtube",
  linkedin: "lucide:linkedin",
  tiktok: "lucide:music",
  website: "lucide:globe",
  threads: "lucide:at-sign",
  bluesky: "lucide:cloud",
  other: "lucide:link",
};
const SOCIAL_LABELS: Record<string, string> = {
  instagram: "Instagram",
  facebook: "Facebook",
  twitter: "Twitter / X",
  youtube: "YouTube",
  linkedin: "LinkedIn",
  tiktok: "TikTok",
  website: "Sitio web",
  threads: "Threads",
  bluesky: "Bluesky",
  other: "Enlace",
};

const buildPhoneLink = (p: ContactPhone) =>
  p.whatsapp
    ? buildWhatsappUrl(p.phone, "Hola, me gustaría contactar con Casa de Asterión.", {})
    : `tel:${p.phone.replace(/[^\d+]/g, "")}`;

// Did we end up with anything to show?
const hasEmails = emails.length > 0;
const hasPhones = commerceWhatsapp || phones.length > 0;
const hasPlace = addresses.length > 0 || hours;
const hasAny = hasEmails || hasPhones || hasPlace || socials.length > 0;
---

<Layout title="Contacto">
  <section class="contacto-page">
    <div class="contacto-grid">
      <aside class="contacto-intro">
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl leading-[1.05] mb-6 sm:mb-8">Contacto</h1>
        <p class="text-[color:var(--fg-muted)] leading-relaxed text-base sm:text-lg max-w-prose">
          Para envíos editoriales, manuscritos, derechos, prensa o
          consultas generales, escríbenos por el medio que prefieras.
        </p>
      </aside>

      <div class="contacto-methods">
        {hasEmails && (
          <section class="contacto-group">
            <h2 class="contacto-eyebrow">{emails.length === 1 ? "Email" : "Emails"}</h2>
            <ul class="contacto-list">
              {emails.map((e) => (
                <li>
                  <a href={`mailto:${e.email}`} class="contacto-item">
                    <span class="contacto-item-main">
                      <span class="contacto-item-value">{e.email}</span>
                      {e.label && <span class="contacto-item-sub">{e.label}</span>}
                    </span>
                    <span class="contacto-item-cta">Escribir<span class="contacto-arrow" aria-hidden="true"> →</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {hasPhones && (
          <section class="contacto-group">
            <h2 class="contacto-eyebrow">Teléfonos</h2>
            <ul class="contacto-list">
              {commerceWhatsapp && (
                <li>
                  <a href={commerceWhatsappLink} target="_blank" rel="noopener noreferrer" class="contacto-item">
                    <span class="contacto-item-main">
                      <span class="contacto-item-value contacto-item-value-num">{commerceWhatsapp}</span>
                      <span class="contacto-item-sub"><Icon name="lucide:message-circle" class="w-3 h-3 inline-block -mt-0.5 mr-1" aria-hidden="true" />WhatsApp · ventas</span>
                    </span>
                    <span class="contacto-item-cta">Abrir chat<span class="contacto-arrow" aria-hidden="true"> →</span></span>
                  </a>
                </li>
              )}
              {phones.map((p) => (
                <li>
                  <a
                    href={buildPhoneLink(p)}
                    target={p.whatsapp ? "_blank" : undefined}
                    rel={p.whatsapp ? "noopener noreferrer" : undefined}
                    class="contacto-item"
                  >
                    <span class="contacto-item-main">
                      <span class="contacto-item-value contacto-item-value-num">{p.phone}</span>
                      <span class="contacto-item-sub">
                        {p.whatsapp ? (
                          <Icon name="lucide:message-circle" class="w-3 h-3 inline-block -mt-0.5 mr-1" aria-hidden="true" />
                        ) : (
                          <Icon name="lucide:phone" class="w-3 h-3 inline-block -mt-0.5 mr-1" aria-hidden="true" />
                        )}
                        {p.label || (p.whatsapp ? "WhatsApp" : "Teléfono")}
                      </span>
                    </span>
                    <span class="contacto-item-cta">{p.whatsapp ? "Abrir chat" : "Llamar"}<span class="contacto-arrow" aria-hidden="true"> →</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {hasPlace && (
          <section class="contacto-group">
            <h2 class="contacto-eyebrow">{addresses.length > 1 ? "Direcciones" : "Dirección"}{hours ? " y horario" : ""}</h2>
            <ul class="contacto-list">
              {addresses.map((a) => (
                <li>
                  <div class="contacto-item contacto-item-static">
                    <span class="contacto-item-main">
                      <span class="contacto-item-value contacto-item-value-multi">{a.address}</span>
                      {a.label && <span class="contacto-item-sub">{a.label}</span>}
                    </span>
                  </div>
                </li>
              ))}
              {hours && (
                <li>
                  <div class="contacto-item contacto-item-static">
                    <span class="contacto-item-main">
                      <span class="contacto-item-value contacto-item-value-multi">{hours}</span>
                      <span class="contacto-item-sub">Horario</span>
                    </span>
                  </div>
                </li>
              )}
            </ul>
          </section>
        )}

        {socials.length > 0 && (
          <section class="contacto-group contacto-group-social">
            <h2 class="contacto-eyebrow">También en</h2>
            <ul class="contacto-social-rail">
              {socials.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer" class="contacto-social-link">
                    <Icon name={SOCIAL_ICONS[s.platform] ?? "lucide:link"} class="w-4 h-4" aria-hidden="true" />
                    <span>{s.label || SOCIAL_LABELS[s.platform] || s.platform}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {!hasAny && (
          <p class="text-[color:var(--fg-muted)] italic">Aún no hay datos de contacto configurados.</p>
        )}
      </div>
    </div>
  </section>
</Layout>

<style>
  /*
   * Contact page — editorial colophon layout.
   *
   * Two-column grid on md+: title + intro on the left, a vertical
   * stack of method groups on the right. Each group is its own
   * sub-section with a small uppercase eyebrow and one or more
   * rows. No boxed cards: rows are typographic with hairline
   * separators between groups, and the value carries the visual
   * weight (the way it would in a printed colophon page).
   *
   * The value font is the body sans because emails and phone
   * numbers look wrong in a serif and break ugly on long strings.
   * overflow-wrap: anywhere lets a long email wrap only as a last
   * resort, never mid-word when a clean break is available.
   */
  .contacto-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 4rem 1.25rem 6rem;
  }
  @media (min-width: 640px) { .contacto-page { padding: 5rem 1.5rem 7rem; } }
  @media (min-width: 1024px) { .contacto-page { padding: 6rem 3rem 8rem; } }

  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .contacto-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3.5rem;
    }
  }
  @media (min-width: 1024px) {
    .contacto-grid { gap: 5rem; }
  }

  .contacto-intro { min-width: 0; }
  @media (min-width: 768px) {
    /* Sticky-ish intro so the title hangs in place while the right
       column scrolls past it on a tall page. */
    .contacto-intro {
      position: sticky;
      top: 6rem;
      align-self: start;
    }
  }

  .contacto-methods {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }
  .contacto-group {
    padding: 1.75rem 0 2rem;
    border-bottom: 1px solid var(--border);
  }
  .contacto-group:first-child { padding-top: 0; }
  .contacto-group:last-child { border-bottom: 0; }
  @media (min-width: 768px) {
    .contacto-group { padding: 2rem 0 2.25rem; }
  }

  .contacto-eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--fg-muted);
    margin: 0 0 1rem;
    font-weight: 500;
  }

  .contacto-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .contacto-list > li + li { padding-top: 1.25rem; border-top: 1px dashed var(--border); }

  .contacto-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s;
  }
  .contacto-item-static { cursor: default; }

  .contacto-item-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .contacto-item-value {
    font-size: 1.125rem;
    line-height: 1.4;
    font-weight: 500;
    overflow-wrap: anywhere;
    word-break: normal;
    color: var(--fg);
  }
  @media (min-width: 768px) {
    .contacto-item-value { font-size: 1.25rem; }
  }
  .contacto-item-value-num {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  .contacto-item-value-multi { white-space: pre-line; line-height: 1.5; }

  .contacto-item-sub {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--fg-muted);
  }

  .contacto-item-cta {
    align-self: center;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--fg-muted);
    white-space: nowrap;
    transition: color 0.18s;
  }
  .contacto-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
    margin-left: 0.125rem;
  }
  a.contacto-item:hover .contacto-item-value {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--fg);
  }
  a.contacto-item:hover .contacto-item-cta { color: var(--fg); }
  a.contacto-item:hover .contacto-arrow { transform: translateX(3px); }
  a.contacto-item:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 6px;
  }

  /* On narrow phones the CTA stacks below the value so addresses /
     long emails get the full width. */
  @media (max-width: 520px) {
    .contacto-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .contacto-item-cta {
      align-self: flex-start;
      justify-self: flex-start;
    }
  }

  /* --- Social rail --- */
  .contacto-social-rail {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }
  .contacto-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--border);
    color: var(--fg);
    text-decoration: none;
    font-size: 0.875rem;
    transition: border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .contacto-social-link:hover {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }
</style>
