---
import Layout from "~/layouts/Layout.astro";
import BookCard from "~/components/BookCard.astro";
import PostCard from "~/components/PostCard.astro";
import { supabase, type Author, type Category } from "~/lib/supabase";
import { loadSiteConfig } from "~/lib/site-config";
import { renderMarkdown, mdToPlainText, clampText } from "~/lib/markdown";

// Ficha de un colaborador. La tabla subyacente es `authors`
// (filtrada por role_tag 'collaborator' en /colaboradores). Las
// junctions post_collaborators y book_collaborators ahora apuntan a
// authors via author_id.

export async function getStaticPaths() {
  const { data } = await supabase
    .from("authors")
    .select("slug")
    .contains("role_tags", ["collaborator"]);
  return (data ?? []).map((c: { slug: string }) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const config = await loadSiteConfig();

const { data: collaborator } = await supabase
  .from("authors")
  .select("*")
  .eq("slug", slug!)
  .contains("role_tags", ["collaborator"])
  .maybeSingle();

if (!collaborator) {
  return Astro.redirect("/colaboradores");
}

// Posts donde figura como colaborador.
const { data: postRows } = await supabase
  .from("post_collaborators")
  .select("post_id")
  .eq("author_id", collaborator.id);
const linkedPostIds = (postRows ?? []).map((r: { post_id: string }) => r.post_id);
const { data: posts } = linkedPostIds.length > 0
  ? await supabase
      .from("posts")
      .select("*, post_authors(sort_order, author:authors(*))")
      .eq("status", "published")
      .in("id", linkedPostIds)
      .order("published_at", { ascending: false })
  : { data: [] };

// Libros donde figura como colaborador.
const { data: bookRows } = await supabase
  .from("book_collaborators")
  .select("book_id")
  .eq("author_id", collaborator.id);
const linkedBookIds = (bookRows ?? []).map((r: { book_id: string }) => r.book_id);
const { data: books } = linkedBookIds.length > 0
  ? await supabase
      .from("books")
      .select("*, authors!books_author_id_fkey(name, slug)")
      .eq("status", "published")
      .in("id", linkedBookIds)
      .order("publication_date", { ascending: false })
  : { data: [] };

// Categorías para los posts.
const categoryIds = Array.from(
  new Set(((posts ?? []).map((p) => p.category_id).filter(Boolean) as string[])),
);
const { data: categories } = categoryIds.length > 0
  ? await supabase.from("categories").select("*").in("id", categoryIds)
  : { data: [] as Category[] };
const categoryMap = new Map((categories ?? []).map((c) => [c.id, c]));

function firstAuthor(p: any): Author | null {
  const rows = (p.post_authors ?? []) as { sort_order: number; author: Author | null }[];
  const sorted = [...rows].sort((a, b) => a.sort_order - b.sort_order);
  return sorted[0]?.author ?? null;
}

const bio = renderMarkdown(collaborator.bio_md);
const links = (collaborator.links as Record<string, string> | null) ?? {};
const sameAs = [links.web, links.twitter, links.instagram].filter(Boolean) as string[];
const bioPlain = clampText(mdToPlainText(collaborator.bio_md), 160);
const metaDescription =
  bioPlain ||
  `${collaborator.name} — colaborador de Casa de Asterión Ediciones.`;
---

<Layout
  title={collaborator.name}
  description={metaDescription}
  breadcrumbLabel={collaborator.name}
  seoType="person"
  image={collaborator.photo_url}
  imageAlt={`Foto de ${collaborator.name}`}
  keywords={collaborator.keywords}
  sameAs={sameAs}
  breadcrumbItems={[
    { name: "Inicio", url: new URL("/", Astro.site).href },
    { name: "Colaboradores", url: new URL("/colaboradores", Astro.site).href },
    { name: collaborator.name, url: Astro.url.href },
  ]}
>
  <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pt-12 sm:pt-16 md:pt-20 pb-10 sm:pb-12 grid grid-cols-1 md:grid-cols-[220px_1fr] lg:grid-cols-[260px_1fr] gap-6 md:gap-10 lg:gap-12 items-start">
    <div class="max-w-[220px] sm:max-w-[280px] mx-auto md:mx-0 w-full">
      {collaborator.photo_url ? (
        <img
          src={collaborator.photo_url}
          alt={collaborator.name}
          class="w-full aspect-square object-cover grayscale"
        />
      ) : (
        <div class="w-full aspect-square bg-[color:var(--bg-alt)]"></div>
      )}
    </div>
    <div>
      <p class="uppercase text-[11px] sm:text-xs tracking-[0.2em] text-[color:var(--fg-muted)] mb-3 sm:mb-4">
        Colaborador
      </p>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl mb-5 sm:mb-6">{collaborator.name}</h1>
      <div class="cas-md cas-md--book font-serif max-w-none" set:html={bio}></div>
    </div>
  </section>

  {books && books.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pb-12 sm:pb-16 md:pb-20">
      <h2 class="font-serif text-2xl md:text-3xl mb-8 sm:mb-10 border-b border-[color:var(--border)] pb-4">
        Libros donde colabora
      </h2>
      <div class="grid gap-8 sm:gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {books.map((book: any) => (
          <BookCard book={book} author={book.authors ?? null} config={config} />
        ))}
      </div>
    </section>
  )}

  {posts && posts.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pb-16 sm:pb-20 md:pb-24">
      <h2 class="font-serif text-2xl md:text-3xl mb-8 sm:mb-10 border-b border-[color:var(--border)] pb-4">
        Publicaciones en las que ha colaborado
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10 sm:gap-x-8 sm:gap-y-14 md:gap-x-10 md:gap-y-16">
        {posts.map((p) => (
          <PostCard
            post={p}
            author={firstAuthor(p)}
            category={p.category_id ? categoryMap.get(p.category_id) : null}
          />
        ))}
      </div>
    </section>
  )}
</Layout>
