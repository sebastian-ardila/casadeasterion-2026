---
import Layout from "~/layouts/Layout.astro";
import EmptyState from "~/components/EmptyState.astro";
import { supabase } from "~/lib/supabase";

// "Colaboradores" — mismo molde que /autores, pero leído de la tabla
// `collaborators`. Datos buildeados en SSG via Supabase. Cuando la
// tabla esté vacía mostramos un mensaje "Pronto…" con el mismo
// componente EmptyState que usa /autores.
const { data: collaborators } = await supabase
  .from("collaborators")
  .select("id, slug, name, photo_url, bio_md")
  .order("name", { ascending: true });

const stripDiacritics = (s: string) =>
  s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
---

<Layout
  title="Colaboradores"
  description="Quienes han aportado a la editorial sin ser autores de libro: artículos, poemas, traducciones, ilustraciones, prólogos y otras formas de acompañar el oficio editorial."
  keywords={[
    "colaboradores Casa de Asterión",
    "traductores filosofía",
    "ilustradores libros",
    "prologuistas filosofía y poesía",
    "autores invitados",
    "poetas invitados",
  ]}
>
  <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pt-12 sm:pt-16 md:pt-20 pb-6 sm:pb-8">
    <h1 class="font-serif text-3xl sm:text-4xl md:text-6xl mb-3 sm:mb-4">Colaboradores</h1>
    <p class="text-[color:var(--fg-muted)] max-w-prose">
      Quienes han aportado a la editorial sin ser autores de libro — artículos, poemas, traducciones, ilustraciones, prólogos y otras formas de acompañar el oficio editorial.
    </p>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pb-16 sm:pb-20 md:pb-24" data-collaborators-section>
    {collaborators && collaborators.length > 0 ? (
      <>
        {/* Search bar — mismo patrón visual que /autores. */}
        <div class="mb-8 sm:mb-10">
          <label for="colaboradores-search" class="sr-only">Buscar colaborador por nombre</label>
          <div class="relative">
            <svg
              class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400"
              width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <input
              id="colaboradores-search"
              type="search"
              data-collaborators-search
              placeholder="Buscar colaborador por nombre…"
              autocomplete="off"
              spellcheck="false"
              aria-label="Buscar colaborador por nombre"
              class="w-full pl-10 pr-3 py-3 border border-[color:var(--border)] bg-[color:var(--bg)] text-sm focus:outline-none focus:border-stone-900 transition-colors"
            />
          </div>
        </div>

        <div class="grid gap-8 sm:gap-10 md:gap-12 grid-cols-2 md:grid-cols-3 lg:grid-cols-4" data-collaborators-grid>
          {collaborators.map((c) => (
            <a
              href={`/colaboradores/${c.slug}`}
              class="group"
              data-collaborator-card
              data-search-text={stripDiacritics(c.name ?? "")}
            >
              {c.photo_url ? (
                <img
                  src={c.photo_url}
                  alt={c.name}
                  class="w-full aspect-square object-cover bg-[color:var(--bg-alt)] grayscale group-hover:grayscale-0 transition"
                />
              ) : (
                <div class="aspect-square bg-[color:var(--bg-alt)]"></div>
              )}
              <h3 class="font-serif text-lg mt-4">{c.name}</h3>
            </a>
          ))}
        </div>

        <p class="text-[color:var(--fg-muted)] mt-12 hidden" data-collaborators-empty>
          No encontramos colaboradores con ese nombre.
        </p>
      </>
    ) : (
      <EmptyState
        icon="lucide:users"
        title="Pronto, información sobre nuestros colaboradores"
        description="Estamos preparando las fichas de las personas que han participado en nuestras publicaciones."
        ctaLabel="Volver al inicio"
      />
    )}
  </section>
</Layout>

<script is:inline>
  (() => {
    const section = document.querySelector("[data-collaborators-section]");
    if (!section) return;
    const input = section.querySelector("[data-collaborators-search]");
    const grid = section.querySelector("[data-collaborators-grid]");
    const empty = section.querySelector("[data-collaborators-empty]");
    if (!input || !grid) return;

    const normalize = (s) =>
      String(s ?? "").toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");

    const cards = Array.from(grid.querySelectorAll("[data-collaborator-card]"));

    const apply = () => {
      const q = normalize(input.value.trim());
      let visible = 0;
      cards.forEach((c) => {
        const text = c.dataset.searchText || "";
        const match = !q || text.includes(q);
        c.classList.toggle("hidden", !match);
        if (match) visible++;
      });
      grid.classList.toggle("hidden", visible === 0);
      if (empty) empty.classList.toggle("hidden", visible !== 0);
    };

    input.addEventListener("input", apply);
  })();
</script>
