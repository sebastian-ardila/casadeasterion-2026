---
import Layout from "~/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { supabase } from "~/lib/supabase";
import { renderMarkdown, mdToPlainText, clampText } from "~/lib/markdown";

// Ficha individual de un miembro del equipo. Mismo patrón que
// /autores/[slug] — pre-rendered via getStaticPaths a partir del slug
// que cada fila de `staff` ya guarda.

export async function getStaticPaths() {
  const { data } = await supabase.from("staff").select("slug").eq("status", "published");
  return (data ?? []).map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;

const { data: member } = await supabase
  .from("staff")
  .select("*")
  .eq("slug", slug!)
  .eq("status", "published")
  .maybeSingle();

if (!member) {
  return Astro.redirect("/nosotros");
}

const bio = renderMarkdown(member.bio_md);
const links = (member.links as Record<string, string> | null) ?? {};
const sameAs = [links.web, links.linkedin, links.twitter, links.instagram].filter(Boolean) as string[];
const bioPlain = clampText(mdToPlainText(member.bio_md), 160);
const metaDescription =
  bioPlain ||
  `${member.name} — ${member.role} en Casa de Asterión Ediciones.`;

// Catálogo de íconos para los enlaces sociales — Lucide names that
// render the right glyph for each platform.
const linkRows: { href: string; label: string; icon: string }[] = [];
if (member.email) linkRows.push({ href: `mailto:${member.email}`, label: member.email, icon: "lucide:mail" });
if (links.web) linkRows.push({ href: links.web, label: "Sitio web", icon: "lucide:globe" });
if (links.linkedin) linkRows.push({ href: links.linkedin, label: "LinkedIn", icon: "lucide:linkedin" });
if (links.twitter) linkRows.push({ href: links.twitter, label: "Twitter", icon: "lucide:twitter" });
if (links.instagram) linkRows.push({ href: links.instagram, label: "Instagram", icon: "lucide:instagram" });
---

<Layout
  title={member.name}
  description={metaDescription}
  breadcrumbLabel={member.name}
  seoType="person"
  image={member.photo_url}
  imageAlt={`Foto de ${member.name}`}
  sameAs={sameAs}
  breadcrumbItems={[
    { name: "Inicio", url: new URL("/", Astro.site).href },
    { name: "Nosotros", url: new URL("/nosotros", Astro.site).href },
    { name: member.name, url: Astro.url.href },
  ]}
>
  <section class="mx-auto max-w-[1100px] px-5 sm:px-6 lg:px-12 pt-12 sm:pt-16 md:pt-20 pb-10 sm:pb-12 grid grid-cols-1 md:grid-cols-[260px_1fr] lg:grid-cols-[300px_1fr] gap-6 md:gap-10 lg:gap-14 items-start">
    <aside class="max-w-[260px] sm:max-w-[300px] mx-auto md:mx-0 w-full space-y-5 sm:space-y-6">
      {member.photo_url ? (
        <img
          src={member.photo_url}
          alt={member.name}
          class="w-full aspect-[4/5] object-cover bg-[color:var(--bg-alt)]"
        />
      ) : (
        <div class="w-full aspect-[4/5] bg-[color:var(--bg-alt)] flex items-center justify-center font-serif text-5xl text-[color:var(--fg-muted)]">
          {member.name.charAt(0)}
        </div>
      )}

      {linkRows.length > 0 && (
        <ul class="space-y-3 border-t border-[color:var(--border)] pt-5">
          {linkRows.map((row) => (
            <li>
              <a
                href={row.href}
                class="group flex items-center gap-3 text-sm hover:text-[color:var(--fg)] transition-colors text-[color:var(--fg-muted)]"
                {...(row.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <Icon name={row.icon} class="w-4 h-4 shrink-0" aria-hidden="true" />
                <span class="truncate group-hover:underline underline-offset-4 decoration-[color:var(--fg-muted)]">{row.label}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </aside>

    <div class="min-w-0">
      <p class="uppercase text-[11px] sm:text-xs tracking-[0.22em] text-[color:var(--fg-muted)] mb-3">
        {member.role}
      </p>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl mb-6 sm:mb-8 leading-tight">{member.name}</h1>
      {bio ? (
        <div class="cas-md max-w-none" set:html={bio}></div>
      ) : (
        <p class="text-[color:var(--fg-muted)] italic">Pronto añadiremos una biografía.</p>
      )}
    </div>
  </section>
</Layout>
