---
import Layout from "~/layouts/Layout.astro";
import SubscribeForm from "~/components/SubscribeForm.astro";
import PostCard from "~/components/PostCard.astro";
import BookCard from "~/components/BookCard.astro";
import AuthorsCarousel from "~/components/AuthorsCarousel.astro";
import HeroContentV2 from "~/components/HeroContentV2.astro";
import HeroContentV3 from "~/components/HeroContentV3.astro";
import { supabase } from "~/lib/supabase";
import { loadSiteConfig, DEFAULT_HERO_CARD_CONFIG } from "~/lib/site-config";
import { mergeHeroCardConfig, resolveHeroContent, buildHeroCardCss } from "~/lib/hero-card";

// Hero variant switch. "v1" is the CMS-driven card; "v2" and "v3" are
// static editorial layouts (see HeroContentV2 / HeroContentV3). Only the
// right-half image and the section background color still come from the
// CMS in v2 / v3.
const HERO_VARIANT: "v1" | "v2" | "v3" = "v2";

const config = await loadSiteConfig();

const [{ data: featuredPosts }, { data: featuredBooks }, { data: authors }, { data: categories }] =
  await Promise.all([
    supabase
      .from("posts")
      .select("*")
      .eq("status", "published")
      .order("published_at", { ascending: false })
      .limit(3),
    supabase
      .from("books")
      .select("*")
      .eq("status", "published")
      .order("publication_date", { ascending: false })
      .limit(8),
    supabase.from("authors").select("*").order("name"),
    supabase.from("categories").select("*"),
  ]);

const authorMap = new Map((authors ?? []).map((a) => [a.id, a]));
const categoryMap = new Map((categories ?? []).map((c) => [c.id, c]));
const lead = featuredPosts?.[0];
const rest = (featuredPosts ?? []).slice(1);

const HERO_FALLBACK =
  "https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=2400&q=80";
const heroImage = config.hero_image_url?.trim() || HERO_FALLBACK;
const heroImageMobile = config.hero_image_url?.trim()
  ? config.hero_image_url
  : "https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=1600&q=80";

// Hero card: merge persisted config with defaults so partial saves are safe.
const heroCardCfg = mergeHeroCardConfig(config.hero_card_config, DEFAULT_HERO_CARD_CONFIG);
const heroCardContent = resolveHeroContent(heroCardCfg, {
  lead,
  featuredBook: featuredBooks?.[0],
  authorMap,
  categoryMap,
  editorialDescription: config.editorial_description,
});
const heroCardCss = buildHeroCardCss(heroCardCfg);
---

<Layout
  description="Casa de Asterión Ediciones — editorial independiente dedicada a la filosofía y la poesía contemporáneas. Catálogo, autores y publicaciones."
  keywords={["Casa de Asterión Ediciones","Casa de Asterión","editorial filosofía","editorial poesía","filosofía contemporánea","poesía contemporánea","editorial independiente Colombia","libros de filosofía","libros de poesía","filosofía y poesía"]}
>
  {/* Hero — exactly one viewport tall on desktop. The right-half image is
      fixed-positioned so it visually stays in place while the page scrolls
      past it; JS fades it to 0 by ~0.6vh of scroll, after which the (now
      invisible) image doesn't interfere with later sections.
      On mobile the layout is a normal vertical stack (flex-col): card on
      top, photo below. On md+ flex-row + items-center positions the card
      over the fixed right-half image. */}
  <section
    class="hero-section relative overflow-x-clip md:h-screen flex flex-col md:flex-row md:items-center bg-[color:var(--bg-alt)]"
    style={config.hero_bg_color?.trim() ? `background-color: ${config.hero_bg_color}` : undefined}
  >
    {/* Right-half fixed image (desktop only). z-0 so it sits below the
        sticky header (z-30) but above the body bg. */}
    <div
      id="hero-image"
      class="hidden md:block fixed top-0 right-0 h-screen w-1/2 bg-cover bg-center pointer-events-none will-change-[opacity] transition-opacity duration-200 z-0"
      style={`background-image: url('${heroImage}')`}
    >
    </div>

    {/* V1: CMS-driven card (default for HERO_VARIANT === "v1").
        All visual properties (bg, color, radius, size, position) come
        from site_configuration.hero_card_config. CSS emitted below as
        inline <style>. */}
    {HERO_VARIANT === "v1" && (
      <>
        <a
          href={heroCardContent.cta_href}
          class="hero-card-cms group relative z-10 block transition-shadow hover:shadow-2xl flex flex-col justify-between"
        >
          <div>
            {heroCardContent.eyebrow && (
              <p class="hcc-eyebrow uppercase text-[10px] sm:text-xs tracking-[0.2em] opacity-70 mb-3 sm:mb-5">
                {heroCardContent.eyebrow}
              </p>
            )}
            <h1 class="hcc-title text-[1.4rem] sm:text-2xl md:text-5xl leading-[1.1] mb-3 sm:mb-5 line-clamp-3 md:line-clamp-4">
              {heroCardContent.title}
            </h1>
            {heroCardContent.body && (
              <p class="hcc-body text-xs sm:text-sm md:text-base opacity-80 leading-relaxed line-clamp-2 md:line-clamp-3">
                {heroCardContent.body}
              </p>
            )}
          </div>
          <span class="hcc-cta uppercase text-[11px] sm:text-xs tracking-[0.18em] border-b border-current/60 pb-1 group-hover:border-current self-start mt-4">
            {heroCardContent.cta_label}
          </span>
        </a>
        <style is:inline set:html={heroCardCss}></style>
      </>
    )}

    {/* V2: editorial manifesto + 3 pillars (static). */}
    {HERO_VARIANT === "v2" && <HeroContentV2 />}

    {/* V3: numbered manifesto-style hero (static). */}
    {HERO_VARIANT === "v3" && <HeroContentV3 />}

    {/* Mobile photo — stacked below the card. Hidden on md+ where the
        fixed right-half image takes over. */}
    <img
      src={heroImageMobile}
      alt=""
      loading="eager"
      decoding="async"
      class="md:hidden block w-full aspect-[4/3] object-cover mt-6 sm:mt-8"
    />
  </section>

  {/* Quote — even larger, sits above the (faded) hero image */}
  <section class="relative z-20 bg-[color:var(--bg-alt)] border-y border-[color:var(--border)]">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 py-20 sm:py-28 md:py-44 lg:py-56 text-center">
      <div class="quote-mark"></div>
      <p class="font-serif italic text-2xl sm:text-3xl md:text-5xl lg:text-7xl leading-[1.15] text-[color:var(--fg)] mb-8 sm:mb-10 md:mb-12">
        {config.hero_quote}
      </p>
      <p class="uppercase text-xs sm:text-sm tracking-[0.22em] text-[color:var(--fg-muted)]">
        — {config.hero_quote_author}
      </p>
    </div>
  </section>

  {/* Authors carousel — autoplays L→R, pauses on hover */}
  <AuthorsCarousel authors={authors ?? []} />

  <script is:inline>
    (() => {
      const img = document.getElementById("hero-image");
      if (!img) return;
      // Image is position:fixed so it never moves with the scroll. JS just
      // ramps opacity from 1 → 0 between scrollY = 0.2vh and 0.7vh. After
      // that, the image is fully transparent (still in DOM, but invisible).
      const onScroll = () => {
        const y = window.scrollY;
        const vh = window.innerHeight;
        const startFade = vh * 0.2;
        const fadeOver = vh * 0.5;
        const t = Math.max(0, Math.min(1, (y - startFade) / fadeOver));
        img.style.opacity = String(1 - t);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    })();
  </script>

  {/* Posts recientes */}
  {rest.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pt-20 sm:pt-24 md:pt-28 pb-16 sm:pb-20 md:pb-24">
      <div class="flex items-end justify-between gap-4 mb-10 sm:mb-12 md:mb-14 border-b border-[color:var(--border)] pb-7 sm:pb-8 md:pb-10">
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl">Lecturas recientes</h2>
        <a href="/filosofia" class="nav-link shrink-0 pb-1">Ver todo</a>
      </div>
      <div class="grid gap-10 sm:gap-12 md:grid-cols-2">
        {rest.map((post) => (
          <PostCard
            post={post}
            author={authorMap.get(post.author_id ?? "")}
            category={categoryMap.get(post.category_id ?? "")}
          />
        ))}
      </div>
    </section>
  )}

  {/* Catálogo destacado */}
  {featuredBooks && featuredBooks.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pt-16 sm:pt-20 md:pt-24 pb-16 sm:pb-20 md:pb-24">
      <div class="flex items-end justify-between gap-4 mb-10 sm:mb-12 md:mb-14 border-b border-[color:var(--border)] pb-7 sm:pb-8 md:pb-10">
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl">Catálogo</h2>
        <a href="/catalogo" class="nav-link shrink-0 pb-1">Ver todo</a>
      </div>
      <div class="grid gap-x-5 gap-y-10 sm:gap-x-8 sm:gap-y-14 md:gap-x-10 md:gap-y-16 grid-cols-2 lg:grid-cols-4">
        {featuredBooks.map((book) => (
          <BookCard
            book={book}
            author={authorMap.get(book.author_id ?? "")}
            config={config}
          />
        ))}
      </div>
      <div class="mt-12 sm:mt-16 md:mt-20 flex justify-center">
        <a
          href="/catalogo"
          class="group inline-flex items-center gap-3 border border-stone-900 px-7 py-3.5 sm:px-9 sm:py-4 text-xs sm:text-sm uppercase tracking-[0.2em] hover:bg-stone-900 hover:text-white transition-colors"
        >
          Ver todos los libros
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="transition-transform group-hover:translate-x-1">
            <path d="M5 12h14" />
            <path d="m13 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>
  )}

  {config.subscribe_enabled !== false && <SubscribeForm />}
</Layout>
