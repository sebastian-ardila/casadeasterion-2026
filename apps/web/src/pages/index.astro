---
import Layout from "~/layouts/Layout.astro";
import SubscribeForm from "~/components/SubscribeForm.astro";
import PostCard from "~/components/PostCard.astro";
import BookCard from "~/components/BookCard.astro";
import { supabase } from "~/lib/supabase";
import { loadSiteConfig } from "~/lib/site-config";

const config = await loadSiteConfig();

const [{ data: featuredPosts }, { data: featuredBooks }, { data: authors }, { data: categories }] =
  await Promise.all([
    supabase
      .from("posts")
      .select("*")
      .eq("status", "published")
      .order("published_at", { ascending: false })
      .limit(3),
    supabase
      .from("books")
      .select("*")
      .eq("status", "published")
      .order("published_at", { ascending: false })
      .limit(4),
    supabase.from("authors").select("*"),
    supabase.from("categories").select("*"),
  ]);

const authorMap = new Map((authors ?? []).map((a) => [a.id, a]));
const categoryMap = new Map((categories ?? []).map((c) => [c.id, c]));
const lead = featuredPosts?.[0];
const rest = (featuredPosts ?? []).slice(1);
---

<Layout>
  {/* Hero */}
  <section class="relative">
    <div class="grid md:grid-cols-2 min-h-[70vh]">
      <div class="hidden md:block bg-[color:var(--bg-alt)]"></div>
      <div
        class="bg-cover bg-center"
        style="background-image: linear-gradient(rgba(0,0,0,0.15), rgba(0,0,0,0.15)), url('https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=2400&q=80')"
      >
      </div>
    </div>

    {lead && (
      <a
        href={`/posts/${lead.slug}`}
        class="group block absolute left-6 lg:left-12 top-[18%] md:top-[22%] max-w-[640px] bg-[color:var(--card)] text-[color:var(--card-fg)] p-10 md:p-14 transition-shadow hover:shadow-2xl"
      >
        <p class="uppercase text-xs tracking-[0.2em] opacity-70 mb-6">
          {categoryMap.get(lead.category_id ?? "")?.name ?? "Editorial"}
        </p>
        <h1 class="font-serif text-3xl md:text-5xl leading-[1.1] mb-6">
          {lead.title}
        </h1>
        {lead.excerpt && (
          <p class="opacity-80 leading-relaxed max-w-prose mb-8">{lead.excerpt}</p>
        )}
        <span class="uppercase text-xs tracking-[0.18em] border-b border-[color:var(--card-fg)]/60 pb-1 group-hover:border-[color:var(--card-fg)]">
          Leer artículo
        </span>
      </a>
    )}
  </section>

  {/* Quote */}
  <section class="bg-[color:var(--bg-alt)] border-y border-[color:var(--border)]">
    <div class="mx-auto max-w-3xl px-6 py-24 text-center">
      <div class="quote-mark"></div>
      <p class="font-serif italic text-2xl md:text-3xl leading-relaxed text-[color:var(--fg)] mb-6">
        {config.hero_quote}
      </p>
      <p class="uppercase text-xs tracking-[0.2em] text-[color:var(--fg-muted)]">
        — {config.hero_quote_author}
      </p>
    </div>
  </section>

  {/* Posts recientes */}
  {rest.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-6 lg:px-12 py-24">
      <div class="flex items-end justify-between mb-12 border-b border-[color:var(--border)] pb-6">
        <h2 class="font-serif text-3xl md:text-4xl">Lecturas recientes</h2>
        <a href="/filosofia" class="nav-link hidden md:inline">Ver todo</a>
      </div>
      <div class="grid gap-12 md:grid-cols-2">
        {rest.map((post) => (
          <PostCard
            post={post}
            author={authorMap.get(post.author_id ?? "")}
            category={categoryMap.get(post.category_id ?? "")}
          />
        ))}
      </div>
    </section>
  )}

  {/* Catálogo destacado */}
  {featuredBooks && featuredBooks.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-6 lg:px-12 pb-24">
      <div class="flex items-end justify-between mb-12 border-b border-[color:var(--border)] pb-6">
        <h2 class="font-serif text-3xl md:text-4xl">Catálogo</h2>
        <a href="/catalogo" class="nav-link hidden md:inline">Ver todo</a>
      </div>
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {featuredBooks.map((book) => (
          <BookCard
            book={book}
            author={authorMap.get(book.author_id ?? "")}
            config={config}
          />
        ))}
      </div>
    </section>
  )}

  <SubscribeForm />
</Layout>
