---
import Layout from "~/layouts/Layout.astro";
import SubscribeForm from "~/components/SubscribeForm.astro";
import PostCard from "~/components/PostCard.astro";
import BookCard from "~/components/BookCard.astro";
import { supabase } from "~/lib/supabase";
import { loadSiteConfig } from "~/lib/site-config";

const config = await loadSiteConfig();

const [{ data: featuredPosts }, { data: featuredBooks }, { data: authors }, { data: categories }] =
  await Promise.all([
    supabase
      .from("posts")
      .select("*")
      .eq("status", "published")
      .order("published_at", { ascending: false })
      .limit(3),
    supabase
      .from("books")
      .select("*")
      .eq("status", "published")
      .order("published_at", { ascending: false })
      .limit(4),
    supabase.from("authors").select("*"),
    supabase.from("categories").select("*"),
  ]);

const authorMap = new Map((authors ?? []).map((a) => [a.id, a]));
const categoryMap = new Map((categories ?? []).map((c) => [c.id, c]));
const lead = featuredPosts?.[0];
const rest = (featuredPosts ?? []).slice(1);
---

<Layout>
  {/* Hero — sticky right image with fade-on-scroll, fixed-height card crossing the divider */}
  <section class="hero-section relative bg-[color:var(--bg-alt)] overflow-x-clip">
    {/* Right-half sticky image (desktop only) */}
    <div class="hidden md:block absolute inset-y-0 right-0 w-1/2 pointer-events-none">
      <div
        id="hero-image"
        class="sticky top-0 h-screen bg-cover bg-center will-change-[opacity] transition-opacity duration-200"
        style="background-image: linear-gradient(rgba(0,0,0,0.05), rgba(0,0,0,0.18)), url('https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=2400&q=80')"
      >
      </div>
    </div>

    {/* Mobile-only image */}
    <div
      class="md:hidden h-[55vh] bg-cover bg-center"
      style="background-image: linear-gradient(rgba(0,0,0,0.05), rgba(0,0,0,0.18)), url('https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=1600&q=80')"
    >
    </div>

    {/* Card — fixed height, crosses the divider line */}
    {lead && (
      <a
        href={`/posts/${lead.slug}`}
        class="hero-card group relative z-10 block bg-[color:var(--card)] text-[color:var(--card-fg)] p-10 md:p-14 transition-shadow hover:shadow-2xl flex flex-col justify-between mt-[-12vh] md:mt-[14vh] mb-[12vh] md:mb-[20vh] mx-6 md:ml-12 lg:ml-24 md:mr-0 md:w-[min(720px,calc(50vw+220px))] h-[420px] md:h-[500px]"
      >
        <div>
          <p class="uppercase text-xs tracking-[0.2em] opacity-70 mb-6">
            {categoryMap.get(lead.category_id ?? "")?.name ?? "Editorial"}
          </p>
          <h1 class="font-serif text-3xl md:text-5xl leading-[1.05] mb-6 line-clamp-3">
            {lead.title}
          </h1>
          {lead.excerpt && (
            <p class="opacity-80 leading-relaxed line-clamp-3">{lead.excerpt}</p>
          )}
        </div>
        <span class="uppercase text-xs tracking-[0.18em] border-b border-[color:var(--card-fg)]/60 pb-1 group-hover:border-[color:var(--card-fg)] self-start">
          Leer artículo
        </span>
      </a>
    )}
  </section>

  {/* Quote — much larger, sits above the (faded) hero image */}
  <section class="relative z-20 bg-[color:var(--bg-alt)] border-y border-[color:var(--border)]">
    <div class="mx-auto max-w-6xl px-6 py-32 md:py-48 text-center">
      <div class="quote-mark"></div>
      <p class="font-serif italic text-3xl md:text-5xl lg:text-6xl leading-[1.15] text-[color:var(--fg)] mb-10">
        {config.hero_quote}
      </p>
      <p class="uppercase text-sm tracking-[0.22em] text-[color:var(--fg-muted)]">
        — {config.hero_quote_author}
      </p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const img = document.getElementById("hero-image");
      if (!img) return;
      const onScroll = () => {
        const y = window.scrollY;
        const vh = window.innerHeight;
        const startFade = vh * 0.4;
        const fadeOver = vh * 0.6;
        const t = Math.max(0, Math.min(1, (y - startFade) / fadeOver));
        img.style.opacity = String(1 - t);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    })();
  </script>

  {/* Posts recientes */}
  {rest.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-6 lg:px-12 py-24">
      <div class="flex items-end justify-between mb-12 border-b border-[color:var(--border)] pb-6">
        <h2 class="font-serif text-3xl md:text-4xl">Lecturas recientes</h2>
        <a href="/filosofia" class="nav-link hidden md:inline">Ver todo</a>
      </div>
      <div class="grid gap-12 md:grid-cols-2">
        {rest.map((post) => (
          <PostCard
            post={post}
            author={authorMap.get(post.author_id ?? "")}
            category={categoryMap.get(post.category_id ?? "")}
          />
        ))}
      </div>
    </section>
  )}

  {/* Catálogo destacado */}
  {featuredBooks && featuredBooks.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-6 lg:px-12 pb-24">
      <div class="flex items-end justify-between mb-12 border-b border-[color:var(--border)] pb-6">
        <h2 class="font-serif text-3xl md:text-4xl">Catálogo</h2>
        <a href="/catalogo" class="nav-link hidden md:inline">Ver todo</a>
      </div>
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {featuredBooks.map((book) => (
          <BookCard
            book={book}
            author={authorMap.get(book.author_id ?? "")}
            config={config}
          />
        ))}
      </div>
    </section>
  )}

  <SubscribeForm />
</Layout>
