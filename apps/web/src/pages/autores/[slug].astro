---
import Layout from "~/layouts/Layout.astro";
import BookCard from "~/components/BookCard.astro";
import { supabase } from "~/lib/supabase";
import { loadSiteConfig } from "~/lib/site-config";
import { renderMarkdown, mdToPlainText, clampText } from "~/lib/markdown";

export async function getStaticPaths() {
  const { data } = await supabase.from("authors").select("slug");
  return (data ?? []).map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const config = await loadSiteConfig();

const { data: author } = await supabase
  .from("authors")
  .select("*")
  .eq("slug", slug!)
  .maybeSingle();

if (!author) {
  return Astro.redirect("/autores");
}

// Find all books where this author appears in the junction (not only
// where they're the primary). Order by publication_date desc.
const { data: junctionBooks } = await supabase
  .from("book_authors")
  .select("book_id")
  .eq("author_id", author.id);
const linkedBookIds = (junctionBooks ?? []).map((r) => r.book_id);
const { data: books } = linkedBookIds.length > 0
  ? await supabase
      .from("books")
      .select("*")
      .eq("status", "published")
      .in("id", linkedBookIds)
      .order("publication_date", { ascending: false })
  : { data: [] };

// Otros roles que esta misma persona puede cumplir: traducción,
// prólogo, colaboración. Cargamos en paralelo solo si su role_tags
// los incluye; así evitamos roundtrips innecesarios.
const roles = (author.role_tags ?? []) as string[];
const otherFetches: Record<string, Promise<any>> = {};
if (roles.includes("translator")) {
  otherFetches.translatedBooks = supabase.from("book_translators").select("book:books(*)").eq("author_id", author.id);
}
if (roles.includes("prologuist")) {
  otherFetches.prologuedBooks = supabase.from("book_prologuists").select("book:books(*)").eq("author_id", author.id);
}
if (roles.includes("collaborator")) {
  otherFetches.collaboratedBooks = supabase.from("book_collaborators").select("book:books(*)").eq("author_id", author.id);
}
const resolved = await Promise.all(Object.values(otherFetches));
const otherKeys = Object.keys(otherFetches);
type Book = NonNullable<typeof books>[number];
const pickBooks = (idx: number): Book[] =>
  ((resolved[idx]?.data ?? []) as { book: Book | null }[])
    .map((r) => r.book)
    .filter((b): b is Book => !!b && b.status === "published");
const translatedBooks  = otherKeys.indexOf("translatedBooks")  >= 0 ? pickBooks(otherKeys.indexOf("translatedBooks"))  : [];
const prologuedBooks   = otherKeys.indexOf("prologuedBooks")   >= 0 ? pickBooks(otherKeys.indexOf("prologuedBooks"))   : [];
const collaboratedBooks = otherKeys.indexOf("collaboratedBooks") >= 0 ? pickBooks(otherKeys.indexOf("collaboratedBooks")) : [];

const bio = renderMarkdown(author.bio_md);
const links = (author.links as Record<string, string> | null) ?? {};
const sameAs = [links.web, links.twitter, links.instagram].filter(Boolean) as string[];
const bioPlain = clampText(mdToPlainText(author.bio_md), 160);
const metaDescription =
  bioPlain ||
  `${author.name} — autor de Casa de Asterión Ediciones. Filosofía y poesía contemporáneas.`;
---

<Layout
  title={author.name}
  description={metaDescription}
  breadcrumbLabel={author.name}
  seoType="person"
  image={author.photo_url}
  imageAlt={`Foto de ${author.name}`}
  keywords={author.keywords}
  sameAs={sameAs}
  breadcrumbItems={[
    { name: "Inicio", url: new URL("/", Astro.site).href },
    { name: "Autores", url: new URL("/autores", Astro.site).href },
    { name: author.name, url: Astro.url.href },
  ]}
>
  <section class="mx-auto max-w-[1100px] px-5 sm:px-6 lg:px-12 pt-12 sm:pt-16 md:pt-20 pb-10 sm:pb-12 grid grid-cols-1 md:grid-cols-[220px_1fr] lg:grid-cols-[260px_1fr] gap-6 md:gap-10 lg:gap-12 items-start">
    <div class="max-w-[220px] sm:max-w-[280px] mx-auto md:mx-0 w-full">
      {author.photo_url ? (
        <img
          src={author.photo_url}
          alt={author.name}
          class="w-full aspect-square object-cover grayscale"
        />
      ) : (
        <div class="w-full aspect-square bg-[color:var(--bg-alt)]"></div>
      )}
    </div>
    <div>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl mb-5 sm:mb-6">{author.name}</h1>
      <div class="cas-md max-w-none" set:html={bio}></div>
    </div>
  </section>

  {books && books.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pb-12 sm:pb-16 md:pb-20">
      <h2 class="font-serif text-2xl md:text-3xl mb-8 sm:mb-10 border-b border-[color:var(--border)] pb-4">
        Obras
      </h2>
      <div class="grid gap-8 sm:gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {books.map((book) => (
          <BookCard book={book} author={author} config={config} />
        ))}
      </div>
    </section>
  )}

  {translatedBooks.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pb-12 sm:pb-16 md:pb-20">
      <h2 class="font-serif text-2xl md:text-3xl mb-8 sm:mb-10 border-b border-[color:var(--border)] pb-4">
        Libros que ha traducido
      </h2>
      <div class="grid gap-8 sm:gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {translatedBooks.map((book) => (
          <BookCard book={book} author={null} config={config} />
        ))}
      </div>
    </section>
  )}

  {prologuedBooks.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pb-12 sm:pb-16 md:pb-20">
      <h2 class="font-serif text-2xl md:text-3xl mb-8 sm:mb-10 border-b border-[color:var(--border)] pb-4">
        Libros con su prólogo
      </h2>
      <div class="grid gap-8 sm:gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {prologuedBooks.map((book) => (
          <BookCard book={book} author={null} config={config} />
        ))}
      </div>
    </section>
  )}

  {collaboratedBooks.length > 0 && (
    <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pb-16 sm:pb-20 md:pb-24">
      <h2 class="font-serif text-2xl md:text-3xl mb-8 sm:mb-10 border-b border-[color:var(--border)] pb-4">
        Libros donde colabora
      </h2>
      <div class="grid gap-8 sm:gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {collaboratedBooks.map((book) => (
          <BookCard book={book} author={null} config={config} />
        ))}
      </div>
    </section>
  )}
</Layout>
