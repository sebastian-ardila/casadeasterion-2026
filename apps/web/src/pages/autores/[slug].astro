---
import Layout from "~/layouts/Layout.astro";
import PersonSections from "~/components/PersonSections.astro";
import { supabase } from "~/lib/supabase";
import { loadSiteConfig } from "~/lib/site-config";
import { renderMarkdown, mdToPlainText, clampText } from "~/lib/markdown";
import { loadPersonSections } from "~/lib/person-sections";

export async function getStaticPaths() {
  const { data } = await supabase.from("authors").select("slug");
  return (data ?? []).map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const config = await loadSiteConfig();

const { data: author } = await supabase
  .from("authors")
  .select("*")
  .eq("slug", slug!)
  .maybeSingle();

if (!author) {
  return Astro.redirect("/autores");
}

// Secciones ordenadas según el rol primario de esta página (author).
// El helper se encarga de cargar libros/posts en todos los roles y
// filtrar los grupos vacíos.
const { sections, categoryMap } = await loadPersonSections(
  supabase as any,
  author.id,
  "author",
);

const bio = renderMarkdown(author.bio_md);
const links = (author.links as Record<string, string> | null) ?? {};
const sameAs = [links.web, links.twitter, links.instagram].filter(Boolean) as string[];
const bioPlain = clampText(mdToPlainText(author.bio_md), 160);
const metaDescription =
  bioPlain ||
  `${author.name} — autor de Casa de Asterión Ediciones. Filosofía y poesía contemporáneas.`;
---

<Layout
  title={author.name}
  description={metaDescription}
  breadcrumbLabel={author.name}
  seoType="person"
  image={author.photo_url}
  imageAlt={`Foto de ${author.name}`}
  keywords={author.keywords}
  sameAs={sameAs}
  breadcrumbItems={[
    { name: "Inicio", url: new URL("/", Astro.site).href },
    { name: "Autores", url: new URL("/autores", Astro.site).href },
    { name: author.name, url: Astro.url.href },
  ]}
>
  <section class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-12 pt-12 sm:pt-16 md:pt-20 pb-10 sm:pb-12 grid grid-cols-1 md:grid-cols-[220px_1fr] lg:grid-cols-[260px_1fr] gap-6 md:gap-10 lg:gap-12 items-start">
    <div class="max-w-[220px] sm:max-w-[280px] mx-auto md:mx-0 w-full">
      {author.photo_url ? (
        <img
          src={author.photo_url}
          alt={author.name}
          class="w-full aspect-square object-cover grayscale"
        />
      ) : (
        <div class="w-full aspect-square bg-[color:var(--bg-alt)]"></div>
      )}
    </div>
    <div>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl mb-5 sm:mb-6">{author.name}</h1>
      <div class="cas-md cas-md--book font-serif max-w-none" set:html={bio}></div>
    </div>
  </section>

  <PersonSections
    sections={sections}
    categoryMap={categoryMap}
    person={author}
    config={config}
  />
</Layout>
