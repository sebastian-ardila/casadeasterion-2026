---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import { requireAdmin } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq } from "~/lib/forms";

const guard = await requireAdmin(Astro);
if (guard instanceof Response) return guard;

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
let formError: string | null = null;
let saved = false;

if (Astro.request.method === "POST") {
  try {
    const fd = await Astro.request.formData();

    // Single upsert with all keys → one SQL statement → one rebuild.
    const rows = [
      { key: "hero_quote",                value: strReq(fd, "hero_quote") as never },
      { key: "hero_quote_author",         value: strReq(fd, "hero_quote_author") as never },
      { key: "editorial_description",     value: strReq(fd, "editorial_description") as never },
      { key: "footer_legal",              value: strReq(fd, "footer_legal") as never },
      { key: "whatsapp_phone",            value: strReq(fd, "whatsapp_phone") as never },
      { key: "whatsapp_message_template", value: strReq(fd, "whatsapp_message_template") as never },
      {
        key: "social_links",
        value: {
          facebook: str(fd, "social_facebook") ?? "",
          instagram: str(fd, "social_instagram") ?? "",
          twitter: str(fd, "social_twitter") ?? "",
        } as never,
      },
    ];

    const { error } = await supabase
      .from("site_configuration")
      .upsert(rows, { onConflict: "key" });
    if (error) throw error;

    saved = true;
  } catch (err) {
    formError = err instanceof Error ? err.message : "Error.";
  }
}

const { data: config } = await supabase.from("site_configuration").select("key, value");
const cfg = new Map((config ?? []).map((r) => [r.key, r.value]));
const social = (cfg.get("social_links") ?? {}) as Record<string, string>;
---

<AppLayout title="Configuración">
  <h1 class="font-serif text-3xl mb-2">Configuración del sitio</h1>
  <p class="text-stone-500 mb-8">Textos, contacto y redes que aparecen en el frontend público.</p>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}
  {saved && (
    <p class="bg-green-50 border border-green-200 text-green-900 text-sm p-3 mb-6">Guardado.</p>
  )}

  <form method="POST" class="space-y-8 max-w-3xl">
    <section class="space-y-4">
      <h2 class="font-serif text-xl">Cita destacada del homepage</h2>
      <Field label="Cita" name="hero_quote" type="textarea" rows={3} value={String(cfg.get("hero_quote") ?? "")} required />
      <Field label="Autor de la cita" name="hero_quote_author" value={String(cfg.get("hero_quote_author") ?? "")} required />
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-xl">Editorial</h2>
      <Field label="Descripción (para footer y SEO)" name="editorial_description" type="textarea" rows={3} value={String(cfg.get("editorial_description") ?? "")} required />
      <Field label="Línea legal del footer" name="footer_legal" value={String(cfg.get("footer_legal") ?? "")} required />
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-xl">WhatsApp (compras)</h2>
      <div class="grid grid-cols-2 gap-4">
        <Field label="Número (E.164)" name="whatsapp_phone" value={String(cfg.get("whatsapp_phone") ?? "")} required hint="Ej: +573117462759" />
      </div>
      <Field label="Plantilla del mensaje" name="whatsapp_message_template" type="textarea" rows={3} value={String(cfg.get("whatsapp_message_template") ?? "")} required hint="Variables: {{title}}, {{author}}, {{isbn}}, {{slug}}." />
    </section>

    <section class="space-y-4">
      <h2 class="font-serif text-xl">Redes sociales</h2>
      <div class="grid grid-cols-3 gap-4">
        <Field label="Facebook" name="social_facebook" type="url" value={social.facebook ?? ""} />
        <Field label="Instagram" name="social_instagram" type="url" value={social.instagram ?? ""} />
        <Field label="Twitter / X" name="social_twitter" type="url" value={social.twitter ?? ""} />
      </div>
    </section>

    <div class="flex gap-3 pt-4 border-t border-stone-200">
      <button type="submit" class="btn-primary">Guardar configuración</button>
    </div>
  </form>
</AppLayout>
