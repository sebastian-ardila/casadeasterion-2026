---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import { requireAdmin } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { num, str, strReq, slugify } from "~/lib/forms";

const guard = await requireAdmin(Astro);
if (guard instanceof Response) return guard;

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
let formError: string | null = null;
let saved = false;

if (Astro.request.method === "POST") {
  try {
    const fd = await Astro.request.formData();
    const action = str(fd, "_action");

    if (action === "delete") {
      const id = strReq(fd, "id");
      const { error } = await supabase.from("categories").delete().eq("id", id);
      if (error) throw error;
    } else if (action === "update") {
      const id = strReq(fd, "id");
      const { error } = await supabase.from("categories").update({
        slug: strReq(fd, "slug"),
        name: strReq(fd, "name"),
        kind: strReq(fd, "kind"),
        description: str(fd, "description"),
        sort_order: num(fd, "sort_order") ?? 0,
      }).eq("id", id);
      if (error) throw error;
    } else {
      const name = strReq(fd, "name");
      const { error } = await supabase.from("categories").insert({
        slug: str(fd, "slug") ?? slugify(name),
        name,
        kind: strReq(fd, "kind"),
        description: str(fd, "description"),
        sort_order: num(fd, "sort_order") ?? 0,
      });
      if (error) throw error;
    }
    saved = true;
  } catch (err) {
    formError = err instanceof Error ? err.message : "Error.";
  }
}

const { data: categories } = await supabase
  .from("categories")
  .select("*")
  .order("sort_order")
  .order("name");
---

<AppLayout title="Categorías">
  <h1 class="font-serif text-3xl mb-2">Categorías</h1>
  <p class="text-stone-500 mb-8">Alimentan los menús "Filosofía" y "Poesía", y agrupan posts y libros.</p>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}
  {saved && (
    <p class="bg-green-50 border border-green-200 text-green-900 text-sm p-3 mb-6">Guardado.</p>
  )}

  {/* Existing categories */}
  <div class="space-y-4 mb-12">
    {categories?.map((c) => (
      <form method="POST" class="border border-stone-200 bg-white p-5 grid grid-cols-12 gap-3 items-end">
        <input type="hidden" name="_action" value="update" />
        <input type="hidden" name="id" value={c.id} />
        <div class="col-span-3">
          <Field label="Nombre" name="name" value={c.name} required />
        </div>
        <div class="col-span-3">
          <Field label="Slug" name="slug" value={c.slug} required />
        </div>
        <div class="col-span-2">
          <label class="block">
            <span class="label">Tipo</span>
            <select name="kind" class="input">
              {["philosophy","poetry","book","other"].map((k) => (
                <option value={k} selected={c.kind === k}>{k}</option>
              ))}
            </select>
          </label>
        </div>
        <div class="col-span-1">
          <Field label="Orden" name="sort_order" type="number" value={c.sort_order} />
        </div>
        <div class="col-span-3 flex gap-2 justify-end">
          <button type="submit" class="btn">Guardar</button>
          <button
            type="submit"
            formnovalidate
            name="_action"
            value="delete"
            class="btn-danger"
            onclick={`return confirm('¿Borrar la categoría \"${c.name}\"?')`}
          >Borrar</button>
        </div>
        <div class="col-span-12">
          <Field label="Descripción" name="description" type="textarea" rows={2} value={c.description} />
        </div>
      </form>
    ))}
  </div>

  {/* New category */}
  <form method="POST" class="border border-stone-300 border-dashed p-5 grid grid-cols-12 gap-3 items-end">
    <h2 class="col-span-12 font-serif text-xl">Nueva categoría</h2>
    <div class="col-span-3">
      <Field label="Nombre" name="name" required />
    </div>
    <div class="col-span-3">
      <Field label="Slug" name="slug" hint="Auto si vacío" />
    </div>
    <div class="col-span-2">
      <label class="block">
        <span class="label">Tipo</span>
        <select name="kind" class="input" required>
          <option value="philosophy">philosophy</option>
          <option value="poetry">poetry</option>
          <option value="book">book</option>
          <option value="other">other</option>
        </select>
      </label>
    </div>
    <div class="col-span-1">
      <Field label="Orden" name="sort_order" type="number" />
    </div>
    <div class="col-span-3 flex gap-2 justify-end">
      <button type="submit" class="btn-primary">Crear</button>
    </div>
    <div class="col-span-12">
      <Field label="Descripción" name="description" type="textarea" rows={2} />
    </div>
  </form>
</AppLayout>
