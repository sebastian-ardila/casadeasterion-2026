---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import MarkdownEditor from "~/components/MarkdownEditor.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import { requireAdmin } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { num, str, strReq, tags as parseTags } from "~/lib/forms";

const guard = await requireAdmin(Astro);
if (guard instanceof Response) return guard;

const { id } = Astro.params;
if (!id) return Astro.redirect("/posts");
const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);

let formError: string | null = null;
let savedAt: string | null = null;

if (Astro.request.method === "POST") {
  try {
    const fd = await Astro.request.formData();
    const action = str(fd, "_action");
    if (action === "delete") {
      const { error } = await supabase.from("posts").delete().eq("id", id);
      if (error) throw error;
      return Astro.redirect("/posts");
    }

    const newStatus = str(fd, "status") ?? "draft";
    const content_md = strReq(fd, "content_md");
    const update: Record<string, unknown> = {
      title: strReq(fd, "title"),
      slug: strReq(fd, "slug"),
      subtitle: str(fd, "subtitle"),
      excerpt: str(fd, "excerpt"),
      content_md,
      cover_image_url: str(fd, "cover_image_url"),
      category_id: str(fd, "category_id"),
      author_id: str(fd, "author_id"),
      status: newStatus,
      reading_time_minutes:
        num(fd, "reading_time_minutes") ??
        Math.max(1, Math.round(content_md.split(/\s+/).length / 220)),
      meta_description: str(fd, "meta_description"),
      tags: parseTags(fd, "tags"),
    };

    const { data: existing } = await supabase
      .from("posts").select("published_at").eq("id", id).single();
    if (newStatus === "published" && !existing?.published_at) {
      update.published_at = new Date().toISOString();
    }

    const { error } = await supabase.from("posts").update(update).eq("id", id);
    if (error) throw error;
    savedAt = new Date().toISOString();
  } catch (err) {
    formError = err instanceof Error ? err.message : "Error.";
  }
}

const { data: post } = await supabase.from("posts").select("*").eq("id", id).maybeSingle();
if (!post) return Astro.redirect("/posts");

const [{ data: authors }, { data: categories }] = await Promise.all([
  supabase.from("authors").select("id, name").order("name"),
  supabase.from("categories").select("id, name").order("name"),
]);
---

<AppLayout title={post.title}>
  <div class="flex items-center gap-3 mb-8">
    <a href="/posts" class="text-stone-500 hover:text-stone-900 text-sm">← Artículos</a>
  </div>

  <h1 class="font-serif text-3xl mb-2">{post.title}</h1>
  <p class="text-stone-500 text-sm mb-8">/{post.slug} · actualizado {new Date(post.updated_at).toLocaleString("es-CO")}</p>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}
  {savedAt && (
    <p class="bg-green-50 border border-green-200 text-green-900 text-sm p-3 mb-6">Guardado.</p>
  )}

  <form method="POST" class="space-y-6 max-w-5xl">
    <Field label="Título" name="title" value={post.title} required />
    <Field label="Slug" name="slug" value={post.slug} required />
    <Field label="Subtítulo" name="subtitle" value={post.subtitle} />
    <Field label="Resumen" name="excerpt" type="textarea" rows={3} value={post.excerpt} />

    <ImageUpload name="cover_image_url" value={post.cover_image_url} label="Imagen de portada" bucket="covers" />

    <div class="grid grid-cols-2 gap-4">
      <label class="block">
        <span class="label">Autor</span>
        <select name="author_id" class="input">
          <option value="">—</option>
          {authors?.map((a) => (
            <option value={a.id} selected={a.id === post.author_id}>{a.name}</option>
          ))}
        </select>
      </label>
      <label class="block">
        <span class="label">Categoría</span>
        <select name="category_id" class="input">
          <option value="">—</option>
          {categories?.map((c) => (
            <option value={c.id} selected={c.id === post.category_id}>{c.name}</option>
          ))}
        </select>
      </label>
    </div>

    <MarkdownEditor name="content_md" value={post.content_md} label="Contenido" required />

    <div class="grid grid-cols-3 gap-4">
      <Field label="Tiempo (min)" name="reading_time_minutes" type="number" value={post.reading_time_minutes} />
      <Field label="Tags" name="tags" value={post.tags?.join(", ")} hint="Separados por coma" />
      <label class="block">
        <span class="label">Estado</span>
        <select name="status" class="input">
          <option value="draft" selected={post.status === "draft"}>Borrador</option>
          <option value="published" selected={post.status === "published"}>Publicado</option>
        </select>
      </label>
    </div>

    <Field label="Meta description" name="meta_description" type="textarea" rows={2} value={post.meta_description} />

    <div class="flex justify-between pt-4 border-t border-stone-200">
      <button type="submit" class="btn-primary">Guardar</button>
      <a href="/posts" class="btn">Cancelar</a>
    </div>
  </form>

  <form
    method="POST"
    class="mt-12 pt-6 border-t border-red-200"
    onsubmit="return confirm('¿Borrar este artículo? No se puede deshacer.')"
  >
    <input type="hidden" name="_action" value="delete" />
    <p class="text-sm text-stone-600 mb-3">Zona de peligro</p>
    <button type="submit" class="btn-danger">Borrar artículo</button>
  </form>
</AppLayout>
