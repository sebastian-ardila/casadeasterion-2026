---
import AppLayout from "~/layouts/AppLayout.astro";
import { requireAdmin } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";

const guard = await requireAdmin(Astro);
if (guard instanceof Response) return guard;

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
const [{ data: posts }, { data: authors }, { data: categories }] = await Promise.all([
  supabase.from("posts").select("id, slug, title, status, author_id, category_id, published_at").order("updated_at", { ascending: false }),
  supabase.from("authors").select("id, name"),
  supabase.from("categories").select("id, name"),
]);

const authorMap = new Map((authors ?? []).map((a) => [a.id, a.name]));
const categoryMap = new Map((categories ?? []).map((c) => [c.id, c.name]));
---

<AppLayout title="Artículos">
  <div class="flex items-center justify-between mb-8">
    <h1 class="font-serif text-3xl">Artículos</h1>
    <a href="/posts/new" class="btn-primary">+ Nuevo artículo</a>
  </div>

  {posts && posts.length > 0 ? (
    <div class="border border-stone-200 bg-white">
      <table class="w-full text-sm">
        <thead class="bg-stone-50 text-xs uppercase tracking-[0.12em] text-stone-600">
          <tr>
            <th class="text-left px-4 py-3 font-semibold">Título</th>
            <th class="text-left px-4 py-3 font-semibold">Categoría</th>
            <th class="text-left px-4 py-3 font-semibold">Autor</th>
            <th class="text-left px-4 py-3 font-semibold">Estado</th>
          </tr>
        </thead>
        <tbody>
          {posts.map((p) => (
            <tr class="border-t border-stone-100 hover:bg-stone-50">
              <td class="px-4 py-3">
                <a href={`/posts/${p.id}`} class="hover:underline">{p.title}</a>
                <p class="text-xs text-stone-500">/{p.slug}</p>
              </td>
              <td class="px-4 py-3 text-stone-700">{categoryMap.get(p.category_id ?? "") ?? "—"}</td>
              <td class="px-4 py-3 text-stone-700">{authorMap.get(p.author_id ?? "") ?? "—"}</td>
              <td class="px-4 py-3">
                <span class:list={[
                  "text-[11px] uppercase tracking-[0.12em] px-2 py-0.5",
                  p.status === "published" ? "bg-green-100 text-green-900" : "bg-stone-200 text-stone-700",
                ]}>{p.status}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="border border-dashed border-stone-300 p-10 text-center text-stone-500">
      <p>Aún no hay artículos. <a href="/posts/new" class="underline text-stone-900">Crea el primero.</a></p>
    </div>
  )}
</AppLayout>
