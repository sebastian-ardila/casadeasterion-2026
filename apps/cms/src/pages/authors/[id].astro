---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import MarkdownEditor from "~/components/MarkdownEditor.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import { requireAdmin } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq } from "~/lib/forms";

const guard = await requireAdmin(Astro);
if (guard instanceof Response) return guard;

const { id } = Astro.params;
if (!id) return Astro.redirect("/authors");
const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);

let formError: string | null = null;
let savedAt: string | null = null;

if (Astro.request.method === "POST") {
  try {
    const fd = await Astro.request.formData();
    if (str(fd, "_action") === "delete") {
      const { error } = await supabase.from("authors").delete().eq("id", id);
      if (error) throw error;
      return Astro.redirect("/authors");
    }
    const { error } = await supabase
      .from("authors")
      .update({
        name: strReq(fd, "name"),
        slug: strReq(fd, "slug"),
        bio_md: str(fd, "bio_md"),
        photo_url: str(fd, "photo_url"),
        links: {
          twitter: str(fd, "link_twitter") ?? "",
          web: str(fd, "link_web") ?? "",
          instagram: str(fd, "link_instagram") ?? "",
        },
      })
      .eq("id", id);
    if (error) throw error;
    savedAt = new Date().toISOString();
  } catch (err) {
    formError = err instanceof Error ? err.message : "Error.";
  }
}

const { data: author } = await supabase.from("authors").select("*").eq("id", id).maybeSingle();
if (!author) return Astro.redirect("/authors");
const links = (author.links as Record<string, string>) ?? {};
---

<AppLayout title={author.name}>
  <div class="flex items-center gap-3 mb-8">
    <a href="/authors" class="text-stone-500 hover:text-stone-900 text-sm">← Autores</a>
  </div>

  <h1 class="font-serif text-3xl mb-2">{author.name}</h1>
  <p class="text-stone-500 text-sm mb-8">/{author.slug}</p>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}
  {savedAt && (
    <p class="bg-green-50 border border-green-200 text-green-900 text-sm p-3 mb-6">Guardado.</p>
  )}

  <form method="POST" class="space-y-6 max-w-3xl">
    <Field label="Nombre" name="name" value={author.name} required />
    <Field label="Slug" name="slug" value={author.slug} required />

    <ImageUpload name="photo_url" value={author.photo_url} label="Foto" bucket="authors" />

    <MarkdownEditor name="bio_md" value={author.bio_md} label="Biografía" />

    <div class="grid grid-cols-3 gap-4">
      <Field label="Web" name="link_web" type="url" value={links.web} />
      <Field label="Twitter" name="link_twitter" type="url" value={links.twitter} />
      <Field label="Instagram" name="link_instagram" type="url" value={links.instagram} />
    </div>

    <div class="flex justify-between pt-4 border-t border-stone-200">
      <button type="submit" class="btn-primary">Guardar</button>
      <a href="/authors" class="btn">Cancelar</a>
    </div>
  </form>

  <form
    method="POST"
    class="mt-12 pt-6 border-t border-red-200"
    onsubmit="return confirm('¿Borrar este autor? Los libros y artículos quedarán sin autor asignado.')"
  >
    <input type="hidden" name="_action" value="delete" />
    <p class="text-sm text-stone-600 mb-3">Zona de peligro</p>
    <button type="submit" class="btn-danger">Borrar autor</button>
  </form>
</AppLayout>
