---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import MarkdownEditor from "~/components/MarkdownEditor.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import { requireAdmin } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { num, str, strReq, tags as parseTags } from "~/lib/forms";

const guard = await requireAdmin(Astro);
if (guard instanceof Response) return guard;

const { id } = Astro.params;
if (!id) return Astro.redirect("/books");

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
let formError: string | null = null;
let savedAt: string | null = null;

if (Astro.request.method === "POST") {
  try {
    const fd = await Astro.request.formData();
    const action = str(fd, "_action");

    if (action === "delete") {
      const { error } = await supabase.from("books").delete().eq("id", id);
      if (error) throw error;
      return Astro.redirect("/books");
    }

    const newStatus = str(fd, "status") ?? "draft";
    const update: Record<string, unknown> = {
      title: strReq(fd, "title"),
      slug: strReq(fd, "slug"),
      subtitle: str(fd, "subtitle"),
      description_md: str(fd, "description_md"),
      cover_image_url: str(fd, "cover_image_url"),
      author_id: str(fd, "author_id"),
      category_id: str(fd, "category_id"),
      isbn: str(fd, "isbn"),
      pages: num(fd, "pages"),
      format: str(fd, "format"),
      price_amount: num(fd, "price_amount"),
      price_currency: str(fd, "price_currency") ?? "COP",
      whatsapp_message_override: str(fd, "whatsapp_message_override"),
      publication_date: str(fd, "publication_date"),
      status: newStatus,
      tags: parseTags(fd, "tags"),
    };

    // If transitioning to published and no date set, fill it.
    const { data: existing } = await supabase
      .from("books").select("published_at, status").eq("id", id).single();
    if (newStatus === "published" && !existing?.published_at) {
      update.published_at = new Date().toISOString();
    }

    const { error } = await supabase.from("books").update(update).eq("id", id);
    if (error) throw error;
    savedAt = new Date().toISOString();
  } catch (err) {
    formError = err instanceof Error ? err.message : "Error desconocido.";
  }
}

const { data: book } = await supabase.from("books").select("*").eq("id", id).maybeSingle();
if (!book) return Astro.redirect("/books");

const [{ data: authors }, { data: categories }] = await Promise.all([
  supabase.from("authors").select("id, name").order("name"),
  supabase.from("categories").select("id, name, kind").order("name"),
]);
---

<AppLayout title={book.title}>
  <div class="flex items-center gap-3 mb-8">
    <a href="/books" class="text-stone-500 hover:text-stone-900 text-sm">← Libros</a>
  </div>

  <h1 class="font-serif text-3xl mb-2">{book.title}</h1>
  <p class="text-stone-500 text-sm mb-8">/{book.slug} · actualizado {new Date(book.updated_at).toLocaleString("es-CO")}</p>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}
  {savedAt && (
    <p class="bg-green-50 border border-green-200 text-green-900 text-sm p-3 mb-6">Guardado.</p>
  )}

  <form method="POST" class="space-y-6 max-w-3xl">
    <Field label="Título" name="title" value={book.title} required />
    <Field label="Slug" name="slug" value={book.slug} required />
    <Field label="Subtítulo" name="subtitle" value={book.subtitle} />

    <ImageUpload name="cover_image_url" value={book.cover_image_url} label="Portada" bucket="covers" />

    <div class="grid grid-cols-2 gap-4">
      <label class="block">
        <span class="label">Autor</span>
        <select name="author_id" class="input">
          <option value="">—</option>
          {authors?.map((a) => (
            <option value={a.id} selected={a.id === book.author_id}>{a.name}</option>
          ))}
        </select>
      </label>
      <label class="block">
        <span class="label">Categoría</span>
        <select name="category_id" class="input">
          <option value="">—</option>
          {categories?.map((c) => (
            <option value={c.id} selected={c.id === book.category_id}>{c.name} ({c.kind})</option>
          ))}
        </select>
      </label>
    </div>

    <MarkdownEditor name="description_md" value={book.description_md} label="Descripción" />

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <Field label="ISBN" name="isbn" value={book.isbn} />
      <Field label="Páginas" name="pages" type="number" value={book.pages} />
      <label class="block">
        <span class="label">Formato</span>
        <select name="format" class="input">
          <option value="">—</option>
          {["paperback","hardcover","ebook","other"].map((f) => (
            <option value={f} selected={book.format === f}>{f}</option>
          ))}
        </select>
      </label>
      <Field label="Publicado" name="publication_date" type="date" value={book.publication_date} />
    </div>

    <div class="grid grid-cols-3 gap-4">
      <Field label="Precio" name="price_amount" type="number" value={book.price_amount} />
      <label class="block">
        <span class="label">Moneda</span>
        <select name="price_currency" class="input">
          {["COP","USD","EUR"].map((c) => (
            <option value={c} selected={book.price_currency === c}>{c}</option>
          ))}
        </select>
      </label>
      <Field label="Tags" name="tags" value={book.tags?.join(", ")} hint="Separados por coma" />
    </div>

    <Field
      label="Mensaje WhatsApp custom"
      name="whatsapp_message_override"
      type="textarea"
      rows={3}
      value={book.whatsapp_message_override}
      hint="Si vacío, usa la plantilla global. Variables: {{title}}, {{author}}, {{isbn}}, {{slug}}."
    />

    <label class="block">
      <span class="label">Estado</span>
      <select name="status" class="input max-w-xs">
        <option value="draft" selected={book.status === "draft"}>Borrador</option>
        <option value="published" selected={book.status === "published"}>Publicado</option>
      </select>
    </label>

    <div class="flex justify-between pt-4 border-t border-stone-200">
      <button type="submit" class="btn-primary">Guardar cambios</button>
      <a href="/books" class="btn">Cancelar</a>
    </div>
  </form>

  <form
    method="POST"
    class="mt-12 pt-6 border-t border-red-200"
    onsubmit="return confirm('¿Seguro que quieres borrar este libro? Esta acción es permanente.')"
  >
    <input type="hidden" name="_action" value="delete" />
    <p class="text-sm text-stone-600 mb-3">Zona de peligro</p>
    <button type="submit" class="btn-danger">Borrar libro</button>
  </form>
</AppLayout>
